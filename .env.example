# Shopify app credentials (Partner Dashboard -> your app -> Client credentials)
SHOPIFY_API_KEY="your-client-id"
SHOPIFY_API_SECRET="your-client-secret"
SCOPES="read_products,write_products,read_orders"
SHOPIFY_APP_URL="https://your-app-url.com"

# Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/tryfit"

# fal - https://fal.ai/dashboard/keys
FAL_KEY=""

# Try-on model: kolors (default) | fashn | nano-banana | nano-banana-pro
TRYON_MODEL="nano-banana-pro"

# Optional
REPLICATE_API_TOKEN=""
RESEND_API_KEY=""
EMAIL_FROM=""
