{%- comment -%}
  TryFit — "Virtual try-on" badge on product cards (collections, search, home, related products).
  App embed: Theme customizer → App embeds → TryFit card badge.
{%- endcomment -%}
{%- assign vto_cfg = shop.metafields.tryfit.config.value -%}
{%- capture vto_map -%}
{%- assign vto_list = collection.products | default: search.results -%}
{%- for p in vto_list -%}{%- if p.object_type == "product" or p.handle -%}
  {%- assign off = false -%}
  {%- if vto_cfg and vto_cfg.disabledProducts -%}{%- assign pid = p.id | append: "" -%}{%- for d in vto_cfg.disabledProducts -%}{%- assign ds = d | append: "" -%}{%- if ds == pid -%}{%- assign off = true -%}{%- endif -%}{%- endfor -%}{%- endif -%}
{%- assign t = p.title | append: " " | append: p.type | append: " " | append: p.vendor -%}
{%- assign tg = p.tags | join: " " -%}
{%- assign hay = t | append: " " | append: tg | downcase | replace: "-", " " | replace: "_", " " | replace: ",", " " | replace: "/", " " | replace: "|", " " | replace: "(", " " | replace: ")", " " | replace: ".", " " | replace: "&", " " -%}
{%- assign hay = " " | append: hay | append: " " -%}
{%- assign m = "" -%}
{%- comment -%} 1 · Jewelry worn on the neck / face → jewelry try-on {%- endcomment -%}
{%- assign jw = "necklace,neckpiece,neck piece,pendant,choker,mangalsutra,mangal sutra,locket, haar ,rani haar,kanthi,hasli,earring,ear ring, studs ,ear cuff,jhumka,jhumki,chandbali,bali ,tikka,maang tikka,mang tikka,matha patti,nose ring,nosering,nose pin,nosepin, nath ,jewellery set,jewelry set,bridal set,necklace set" | split: "," -%}
{%- for w in jw -%}{%- if hay contains w -%}{%- assign m = "j" -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- comment -%} 1b · Footwear → shoes try-on (unless it is clearly a garment, e.g. "bootcut jeans") {%- endcomment -%}
{%- if m == "" -%}
  {%- assign sw = "shoe,sneaker,trainer,heels, heel ,stiletto,pumps,wedges,sandal,slipper,flip flop,flipflop, slides ,loafer,moccasin, boot , boots ,chelsea,oxford shoe,derby,brogue,mojari,jutti,juttis,kolhapuri,chappal,footwear, flats ,ballerina,mules,espadrille,clogs,crocs" | split: "," -%}
  {%- for w in sw -%}{%- if hay contains w -%}{%- assign m = "s" -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- if m == "s" -%}
    {%- assign gw = "blouse,kurta,kurti,dress,gown,saree,sari,lehenga,top ,shirt,t shirt,tshirt,jacket,coat,blazer,skirt,trouser,pants,jeans,jumpsuit,co ord,anarkali,sharara,palazzo,dupatta,suit " | split: "," -%}
    {%- for w in gw -%}{%- if hay contains w -%}{%- assign m = "" -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- endif -%}
{%- endif -%}
{%- comment -%} 2 · Other jewelry & accessories (rings, bangles, anklets, watches…) → no try-on {%- endcomment -%}
{%- if m == "" -%}
  {%- assign no = " ring , rings ,finger ring,toe ring,bracelet,bangle, kada , kangan,anklet,payal,pajeb,brooch,cufflink,cuff link,hair clip,hairclip,hair pin,waist chain,kamarbandh,armlet,bajuband, watch , watches ,smartwatch" | split: "," -%}
  {%- for w in no -%}{%- if hay contains w -%}{%- assign m = "0" -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- if m == "0" -%}
  {%- assign gw = "blouse,kurta,kurti,dress,gown,saree,sari,lehenga,top ,shirt,t shirt,tshirt,jacket,coat,blazer,skirt,trouser,pants,jeans,jumpsuit,co ord,anarkali,sharara,palazzo,dupatta,suit " | split: "," -%}
  {%- for w in gw -%}{%- if hay contains w -%}{%- assign m = "" -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- comment -%} 3 · Home decor → room placement {%- endcomment -%}
{%- if m == "" -%}
  {%- assign hw = "bedsheet,bed sheet,bedding,comforter,duvet,quilt,dohar,blanket, throw ,pillow,cushion,curtain,drape,rug ,carpet,doormat,table cloth,tablecloth,table runner,wall art,painting,photo frame,poster,tapestry,sofa cover,mattress" | split: "," -%}
  {%- for w in hw -%}{%- if hay contains w -%}{%- assign m = "h" -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- if m == "" -%}{%- assign m = "f" -%}{%- endif -%}
  {%- if off -%}{%- assign m = "0" -%}{%- endif -%}
  {{ p.handle | json }}:"{{ m }}",
{%- endif -%}{%- endfor -%}
{%- endcapture -%}
<script id="tryfit-badge-cfg" type="application/json">{"shop":{{ shop.permanent_domain | json }},"text":{{ block.settings.text | default: "" | json }},"home":{{ block.settings.text_home | default: "" | json }},"jew":{{ block.settings.text_jewelry | default: "" | json }},"shoe":{{ block.settings.text_shoes | default: "" | json }},"pos":{{ block.settings.position | default: "" | json }},"style":{{ block.settings.style | default: "" | json }},"mobileIcon":{% if block.settings.mobile_icon_only %}true{% else %}false{% endif %},"off":{% if vto_cfg.disabledProducts %}{{ vto_cfg.disabledProducts | json }}{% else %}[]{% endif %},"map":{% if vto_map != blank %}{ {{ vto_map | strip | remove_last: "," }} }{% else %}null{% endif %}}</script>
<style>tryfit-badge{all:initial;}</style>
<script>
(function(){
if(window.__tryfitBadge)return;window.__tryfitBadge=1;
if(window.Shopify&&Shopify.designMode&&!document.getElementById('tryfit-badge-cfg'))return;
var C;try{C=JSON.parse(document.getElementById('tryfit-badge-cfg').textContent);}catch(e){return;}
var ICON='<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8.6 3.8 4.3 5.7 2.6 10.2l3.1 1.2v8.8h12.6v-8.8l3.1-1.2-1.7-4.5-4.3-1.9c-.5 1.5-1.9 2.5-3.4 2.5s-2.9-1-3.4-2.5z\"/></svg>';
var GEM_ICON='<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 3.5c.4 5.2 3.3 8.6 7 8.6s6.6-3.4 7-8.6\"/><path d=\"M12 12.1v1.4\"/><path d=\"M12 13.5l2.3 2.9L12 20.5l-2.3-4.1z\"/></svg>';
var SHOE_ICON='<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2.5 16.5V9.3c0-.6.5-1 1.1-.9l2.8.6c.5.1.9.5 1 1l.3 1.2c.2.7.9 1.1 1.6 1l1.8-.3 3.5 2.2c.4.3.9.4 1.4.4h3.3c1 0 1.7.8 1.7 1.7v.3H2.5z\"/><path d=\"M2.5 16.5h19v1a1.5 1.5 0 0 1-1.5 1.5H4a1.5 1.5 0 0 1-1.5-1.5z\"/><path d=\"M9.8 12.4l.9-1.4M12.3 13.7l.9-1.4\"/></svg>';
var HOME_ICON='<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 5.5v14M21 19.5V14a2.5 2.5 0 0 0-2.5-2.5H3\"/><path d=\"M3 16.2h18\"/><rect x=\"5.2\" y=\"8.2\" width=\"5\" height=\"3.3\" rx=\"1.2\"/></svg>';
var SKIP='header,footer,nav,tryfit-badge,cart-drawer,#CartDrawer,#cart-drawer,.cart-drawer,[id*="cart" i],predictive-search,.predictive-search,[role="dialog"],.tfb,#vto,.vto-root';
var handleOf=function(h){var m=(h||'').match(/\/products\/([^/?#]+)/);return m?decodeURIComponent(m[1]):null;};
var mainHandle=handleOf(location.pathname);
var CARD_SEL='li,article,product-card,product-item,.card,.product-card,.product-item,.product-block,.product-grid-item,.grid__item,.grid-item,.grid-product,.productitem,.product-tile,.product,[class*="product-card"],[class*="productCard"],[class*="product-item"],[class*="ProductItem"],[class*="card-product"]';
function areaOf(i){var r=i.getBoundingClientRect();return r.width*r.height;}
function bigImg(root){var best=null,ba=0;if(!root)return null;root.querySelectorAll('img').forEach(function(i){var x=areaOf(i);if(x>ba){ba=x;best=i;}});return best;}
function boxFor(a){
  var img=bigImg(a);
  if(!img){var card=a.closest(CARD_SEL);img=bigImg(card);}
  if(!img)return null;
  var ir=img.getBoundingClientRect();if(ir.width<1||ir.height<1)return null;
  var b=img.parentElement;
  /* climb to the element that actually frames the image (skip picture / inline wrappers) */
  for(var i=0;i<4&&b&&b.parentElement;i++){
    var r=b.getBoundingClientRect();
    if(b.tagName!=='PICTURE'&&getComputedStyle(b).display!=='inline'&&r.height>=ir.height*0.9&&r.width>=ir.width*0.9)break;
    b=b.parentElement;
  }
  if(b)b.__tfImg=img;
  return b;
}
/* Same rules as snippets/tryfit-mode.liquid — used for cards outside the current collection (home page, related products…) */
var JW='necklace,neckpiece,neck piece,pendant,choker,mangalsutra,mangal sutra,locket, haar ,rani haar,kanthi,hasli,earring,ear ring, studs ,ear cuff,jhumka,jhumki,chandbali,bali ,tikka,maang tikka,mang tikka,matha patti,nose ring,nosering,nose pin,nosepin, nath ,jewellery set,jewelry set,bridal set,necklace set'.split(',');
var NO=' ring , rings ,finger ring,toe ring,bracelet,bangle, kada , kangan,anklet,payal,pajeb,brooch,cufflink,cuff link,hair clip,hairclip,hair pin,waist chain,kamarbandh,armlet,bajuband, watch , watches ,smartwatch'.split(',');
var HW='bedsheet,bed sheet,bedding,comforter,duvet,quilt,dohar,blanket, throw ,pillow,cushion,curtain,drape,rug ,carpet,doormat,table cloth,tablecloth,table runner,wall art,painting,photo frame,poster,tapestry,sofa cover,mattress'.split(',');
var GW='blouse,kurta,kurti,dress,gown,saree,sari,lehenga,top ,shirt,t shirt,tshirt,jacket,coat,blazer,skirt,trouser,pants,jeans,jumpsuit,co ord,anarkali,sharara,palazzo,dupatta,suit '.split(',');
var SW='shoe,sneaker,trainer,heels, heel ,stiletto,pumps,wedges,sandal,slipper,flip flop,flipflop, slides ,loafer,moccasin, boot , boots ,chelsea,oxford shoe,derby,brogue,mojari,jutti,juttis,kolhapuri,chappal,footwear, flats ,ballerina,mules,espadrille,clogs,crocs'.split(',');
var OFF=(Array.isArray(C.off)?C.off:[]).map(String);
function modeOf(p){
  if(OFF.indexOf(String(p.id))>-1)return '0';
  var tags=Array.isArray(p.tags)?p.tags.join(' '):(p.tags||'');
  var hay=(' '+[p.title,p.type||p.product_type,p.vendor,tags].join(' ').toLowerCase().replace(/[-_,\/|().&]/g,' ')+' ');
  var has=function(l){return l.some(function(w){return hay.indexOf(w)>-1;});};
  return has(JW)?'j':(has(SW)&&!has(GW))?'s':(has(NO)&&!has(GW))?'0':has(HW)?'h':'f';
}
var MK='tfb_modes',MC={};try{MC=JSON.parse(sessionStorage.getItem(MK)||'{}');}catch(e){}
function resolveMode(h,cb){
  if(C.map&&C.map[h])return cb(C.map[h]);
  if(MC[h])return cb(MC[h]);
  fetch('/products/'+encodeURIComponent(h)+'.js').then(function(r){return r.ok?r.json():null;}).then(function(p){
    var m=p?modeOf(p):'0';MC[h]=m;try{sessionStorage.setItem(MK,JSON.stringify(MC));}catch(e){}cb(m);
  }).catch(function(){});
}
function badge(a){
  if(a.closest(SKIP))return;
  var h=handleOf(a.getAttribute('href'));if(!h)return;
  var b0=boxFor(a);if(!b0||b0.dataset.tfb)return;
  b0.dataset.tfb='p';
  resolveMode(h,function(m){if(m==='0'){b0.dataset.tfb='0';return;}delete b0.dataset.tfb;place(a,h,m);});
}
var PILL_CSS=':host{all:initial}.p{display:inline-flex;align-items:center;gap:5px;height:20px;padding:0 8px 0 6px;border-radius:999px;font:700 8px/1 "Helvetica Neue",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;font-stretch:110%;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;-webkit-backdrop-filter:blur(10px) saturate(1.4);backdrop-filter:blur(10px) saturate(1.4);box-shadow:0 1px 4px rgba(0,0,0,.1);cursor:pointer;opacity:0;transform:translateY(3px);animation:in .45s cubic-bezier(.22,1,.36,1) .08s forwards;transition:transform .25s cubic-bezier(.22,1,.36,1);-webkit-font-smoothing:antialiased;box-sizing:border-box;max-width:100%;overflow:hidden}.p:hover{transform:translateY(-1px)}.d{background:rgba(52,42,36,.62);color:rgba(236,232,227,.9)}.l{background:rgba(255,255,255,.88);color:#1c1b1a}svg{width:11px;height:11px;flex:0 0 11px;opacity:.9;display:block;fill:none;stroke:currentColor}span{overflow:hidden;text-overflow:ellipsis}@keyframes in{to{opacity:1;transform:none}}@media(max-width:749px){.p{height:18px;padding:0 6px 0 5px;font-size:7px;gap:4px}svg{width:10px;height:10px;flex-basis:10px}}.io{width:20px;height:20px;padding:0;justify-content:center}.io span{display:none}@media(prefers-reduced-motion:reduce){.p{animation:none;opacity:1;transform:none}}';
function lock(el,props){for(var k in props)el.style.setProperty(k,props[k],'important');}
function place(a,h,mode){
  var b=boxFor(a);if(!b||b.dataset.tfb)return;
  var br=b.getBoundingClientRect();if(br.width<70||br.height<70)return;var tiny=br.width<150;
  if(mainHandle&&h===mainHandle&&b.closest('main [class*="product__media"],main [class*="product-media"],main [class*="product-gallery"],main [class*="product__gallery"]'))return;
  b.dataset.tfb='1';
  if(getComputedStyle(b).position==='static')b.style.setProperty('position','relative','important');
  var home=mode==='h',label=home?(C.home||'View in your room'):mode==='j'?(C.jew||'See it on you'):mode==='s'?(C.shoe||'Try these on'):(C.text||'Virtual try-on');
  var mob=window.matchMedia&&matchMedia('(max-width:749px)').matches,pos=C.pos||'br';
  var host=document.createElement('tryfit-badge');host.className='tfb';
  var g={'position':'absolute','z-index':'20','display':'block','width':'auto','height':'auto','min-width':'0','min-height':'0','max-width':'calc(100% - 16px)','max-height':'none','margin':'0','padding':'0','border':'0','background':'none','transform':'none','opacity':'1','visibility':'visible','pointer-events':'auto','top':'auto','right':'auto','bottom':'auto','left':'auto','line-height':'0','float':'none','clip-path':'none','filter':'none'};
  lock(host,g);
  var gap=mob?6:8,img=b.__tfImg;
  var fit=function(){try{var R=b.getBoundingClientRect(),I=(img&&img.isConnected?img:b).getBoundingClientRect();
    var v=pos.charAt(0)==='t'?['top',Math.max(0,I.top-R.top)]:['bottom',Math.max(0,R.bottom-I.bottom)];
    var h2=pos.charAt(1)==='l'?['left',Math.max(0,I.left-R.left)]:['right',Math.max(0,R.right-I.right)];
    host.style.setProperty(v[0],(v[1]+gap)+'px','important');host.style.setProperty(h2[0],(h2[1]+gap)+'px','important');}catch(e){}};
  fit();try{new ResizeObserver(fit).observe(b);if(img)new ResizeObserver(fit).observe(img);}catch(e){window.addEventListener('resize',fit);}
  try{host.style.setProperty('--tf-font',getComputedStyle(a).fontFamily);}catch(e){}
  var root=host.attachShadow?host.attachShadow({mode:'open'}):host;
  root.innerHTML='<style>'+PILL_CSS+'</style><div class="p '+(C.style==='light'?'l':'d')+((C.mobileIcon||tiny)?' io':'')+'" role="button" tabindex="0" aria-label="'+label.replace(/"/g,'')+'">'+(home?HOME_ICON:mode==='j'?GEM_ICON:mode==='s'?SHOE_ICON:ICON)+'<span>'+label.replace(/[<>&]/g,'')+'</span></div>';
  var go=function(e){e.preventDefault();e.stopPropagation();if(e.stopImmediatePropagation)e.stopImmediatePropagation();var u=a.href;location.href=u+(u.indexOf('?')>-1?'&':'?')+'tryfit=open';};
  host.addEventListener('click',go,true);
  host.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' ')go(e);});
  b.appendChild(host);
}
var logged=0;var scan=function(){document.querySelectorAll('a[href*="/products/"]').forEach(badge);if(!logged){logged=1;setTimeout(function(){try{console.log('%cWearoom%c card badges: '+document.querySelectorAll('tryfit-badge').length,'background:#111;color:#fff;padding:2px 6px;border-radius:4px','color:#666');}catch(e){}},1500);}};
var q=null,later=function(){if(q)return;q=setTimeout(function(){q=null;scan();},250);};
function start(){
  scan();
  try{new MutationObserver(later).observe(document.body,{childList:true,subtree:true});}catch(e){}
  window.addEventListener('load',later);window.addEventListener('resize',later);
  window.addEventListener('scroll',later,{passive:true});document.addEventListener('load',function(e){if(e.target&&e.target.tagName==='IMG')later();},true);
  var n=0,iv=setInterval(function(){scan();if(++n>12)clearInterval(iv);},1500);
}
/* Respect the monthly limit: no badges when the store is out of try-ons (shared 2-min cache with the PDP button) */
var k='vto_av_'+C.shop,c=null;try{c=JSON.parse(sessionStorage.getItem(k)||'null');}catch(e){}
if(c&&Date.now()-c.t<120000){if(c.a!==false)start();return;}
fetch('https://tryfit-production.up.railway.app/proxy-tryon?shop='+encodeURIComponent(C.shop),{mode:'cors'}).then(function(r){return r.json();}).then(function(d){
  var a=d.available!==false;try{sessionStorage.setItem(k,JSON.stringify({a:a,t:Date.now()}));}catch(e){}if(a)start();
}).catch(start);
})();
</script>

{% schema %}
{
  "name": "TryFit card badge",
  "target": "body",
  "settings": [
    { "type": "paragraph", "content": "Shows a try-on badge on product cards. Tapping it opens the product with try-on ready." },
    { "type": "text", "id": "text", "label": "Badge text (clothing)", "default": "Virtual try-on" },
    { "type": "text", "id": "text_home", "label": "Badge text (home decor)", "default": "View in your room" },
    { "type": "text", "id": "text_jewelry", "label": "Badge text (jewelry)", "default": "See it on you" },
    { "type": "text", "id": "text_shoes", "label": "Badge text (footwear)", "default": "Try these on" },
    { "type": "select", "id": "style", "label": "Style", "default": "dark", "options": [
      { "value": "dark", "label": "Dark glass" },
      { "value": "light", "label": "Light glass" }
    ]},
    { "type": "select", "id": "position", "label": "Position", "default": "br", "options": [
      { "value": "br", "label": "Bottom right" },
      { "value": "bl", "label": "Bottom left" },
      { "value": "tr", "label": "Top right" },
      { "value": "tl", "label": "Top left" }
    ]},
    { "type": "checkbox", "id": "mobile_icon_only", "label": "Icon only on mobile", "default": false }
  ]
}
{% endschema %}
