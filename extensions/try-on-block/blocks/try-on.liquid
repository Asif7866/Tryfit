.vto-rs__fs{position:absolute;top:62px;right:18px;z-index:4;width:44px;height:44px;border:none;border-radius:50%;background:rgba(40,38,36,.62);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);transition:background .2s;}
.vto-rs__fs:hover{background:rgba(40,38,36,.8);}
.vto-rs__bot{position:absolute;left:0;right:0;bottom:0;z-index:4;padding:60px 22px 12px;background:linear-gradient(to top,rgba(0,0,0,.42),rgba(0,0,0,0));}
.vto-rs__row{position:relative;display:flex;align-items:flex-end;justify-content:flex-end;min-height:112px;margin-bottom:12px;}
.vto-rs__row .vto-pchip{position:absolute;left:0;bottom:0;z-index:2;}
.vto-pchip{display:flex;align-items:center;gap:0;padding:4px;border:none;border-radius:16px;background:#fff;color:var(--ink);cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.18);max-width:72%;transition:gap .35s,padding .35s;}
.vto-pchip img{width:78px;height:104px;border-radius:12px;object-fit:cover;display:block;flex-shrink:0;}
.vto-pchip__t{max-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:15px;font-weight:500;transition:max-width .35s cubic-bezier(.16,1,.3,1);text-transform:capitalize;}
.vto-pchip svg{flex-shrink:0;margin:0 6px 0 4px;}
.vto-pchip.is-open{gap:14px;padding-right:10px;}
.vto-pchip.is-open .vto-pchip__t{max-width:140px;}
.vto-fb{display:flex;align-items:center;gap:4px;margin-left:94px;margin-bottom:8px;height:44px;padding:0 8px 0 16px;border-radius:14px;background:rgba(40,38,36,.78);color:#fff;font-size:14px;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);white-space:nowrap;min-width:0;}
.vto-fb span{overflow:hidden;text-overflow:ellipsis;}
.vto-fb i{width:1px;height:24px;background:rgba(255,255,255,.3);margin:0 6px;}
.vto-fb button{width:36px;height:36px;border:none;background:none;color:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .2s,transform .2s;}
.vto-fb button:hover{background:rgba(255,255,255,.14);}
.vto-fb button.is-on{background:#fff;color:var(--ink);transform:scale(1.05);}
.vto-rs__acts{display:flex;gap:8px;}
.vto-atc{flex:1;height:50px;border:none;border-radius:14px;background:rgba(40,38,36,.88);color:#fff;font-size:16px;font-weight:500;cursor:pointer;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:background .2s,transform .2s;}
.vto-atc:hover{background:#1c1b1a;transform:translateY(-1px);}
.vto-ic{width:50px;height:50px;flex-shrink:0;border:none;border-radius:14px;background:rgba(40,38,36,.88);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:background .2s,transform .2s;}
.vto-ic:hover{background:#1c1b1a;transform:translateY(-1px);}
.vto-rs__more{display:flex;justify-content:center;align-items:center;gap:8px;margin-top:10px;color:rgba(255,255,255,.6);font-size:12px;}
.vto-rs__more button{background:none;border:none;padding:2px;color:#fff;font-size:12.5px;font-weight:500;cursor:pointer;opacity:.9;}
.vto-rs__more button:hover{opacity:1;text-decoration:underline;text-underline-offset:3px;}
.vto-powered{text-align:center;padding:8px 0 0;font-size:12px;font-weight:500;color:rgba(255,255,255,.85);}
.vto-powered a{color:#fff;text-decoration:none;font-weight:700;}
.vto-pr .vto-powered,.vto-err .vto-powered{color:#aaa6a3;}
.vto-toast{position:absolute;left:50%;top:76px;z-index:6;transform:translate(-50%,-10px);padding:9px 16px;border-radius:999px;background:#fff;color:var(--ink);font-size:13px;font-weight:500;box-shadow:0 8px 24px rgba(0,0,0,.18);opacity:0;pointer-events:none;transition:all .3s;}
.vto-toast.is-on{opacity:1;transform:translate(-50%,0);}

/* ERROR */
.vto-err{text-align:center;padding:40px 4px 12px;}
.vto-err__icon{font-size:40px;margin:0 0 10px;}
.vto-err h3{font-family:var(--vf);font-size:20px;font-weight:600;color:var(--ink);margin:0 0 8px;}
.vto-err p{font-size:14px;line-height:1.5;color:#7d7a78;margin:0 0 22px;}

/* MINIBAR */
.vto-mini{position:fixed;bottom:16px;right:16px;z-index:2147482999;background:#fff;border-radius:18px;padding:10px 12px;display:flex;align-items:center;gap:12px;box-shadow:0 14px 40px rgba(0,0,0,.16),0 0 0 1px rgba(0,0,0,.04);max-width:360px;font-family:var(--vf);animation:vU .35s ease;}
.vto-mini__thumbs{display:flex;align-items:center;flex-shrink:0;}
.vto-mini__thumbs img{width:38px;height:48px;border-radius:9px;object-fit:cover;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.1);}
.vto-mini__sp{margin:0 -7px;z-index:1;background:#fff;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,.1);}
.vto-mini__body{flex:1;min-width:0;}
.vto-mini__body strong{display:block;font-size:13px;font-weight:600;color:var(--ink);}
.vto-mini__body span{font-size:11px;color:#9a9693;}
.vto-mini__arrow{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:#f4f2f0;border:none;border-radius:50%;font-size:18px;color:#555;cursor:pointer;flex-shrink:0;}

/* ZOOM */
.vto-zoom{position:fixed;inset:0;z-index:2147483600;background:rgba(10,10,10,.72);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:24px;animation:vF .25s;cursor:zoom-out;}
.vto-zoom__in{position:relative;max-height:100%;height:100%;display:flex;align-items:center;}
.vto-zoom__in img{max-width:min(92vw,900px);max-height:calc(100vh - 48px);border-radius:16px;object-fit:contain;display:block;box-shadow:0 30px 80px rgba(0,0,0,.4);animation:vReveal .4s cubic-bezier(.2,.8,.2,1);}
.vto-zoom__x{position:absolute;top:28px;right:28px;width:52px;height:52px;background:#fff;border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.2);}

/* ANIMS */
@keyframes vF{from{opacity:0}to{opacity:1}}
@keyframes vSt{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes vIn{from{opacity:0;transform:translateX(28px) scale(.98)}to{opacity:1;transform:none}}
@keyframes vUp{from{transform:translateY(100%)}to{transform:none}}
@keyframes vU{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
@keyframes vR{to{transform:rotate(360deg)}}
@keyframes vScan{0%{top:-45%}100%{top:100%}}
@keyframes vBreath{0%,100%{transform:scale(1)}50%{transform:scale(1.025)}}
@keyframes vReveal{from{opacity:0;transform:scale(1.04)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){#vto *,.vto-root *{animation-duration:.01ms!important;transition-duration:.01ms!important;}}

/* MOBILE — bottom sheet */
@media(max-width:600px){
  .vto-overlay{padding:0;align-items:flex-end;justify-content:center;}
  .vto-frame{width:100%;max-height:94vh;max-height:94dvh;border-radius:26px 26px 0 0;padding:1.5px 1.5px 0;animation:vUp .45s cubic-bezier(.16,1,.3,1);}
  .vto-card{border-radius:24.5px 24.5px 0 0;}
  .vto-frame.is-tall{height:94vh;height:94dvh;}
  .vto-h{font-size:21px;}
  .vto-pchip img{width:68px;height:90px;}
  .vto-rs__row{min-height:104px;}
  .vto-fb{margin-left:88px;font-size:13px;padding:0 6px 0 12px;}
  .vto-fb i{margin:0 2px;}
  .vto-mini{left:10px;right:10px;bottom:10px;max-width:none;}
  .vto-zoom__x{top:16px;right:16px;}
}
</style>

<script>
(function(){
const $=id=>document.getElementById(id);
const el=$('vto');if(!el)return;
const D=el.dataset;
if(!window.__tryfitBanner){window.__tryfitBanner=1;try{
  console.log(
    '%cTryFit%c AI Virtual Try-On %c\nShoppers see outfits on themselves — or bedsheets, curtains & decor in their own room.\nBuilt by FutureTechiez → https://futuretechiez.in\nGet it for your Shopify store → https://apps.shopify.com/partners/futuretechiez',
    'background:#111;color:#fff;padding:4px 10px;border-radius:6px;font-weight:700;font-size:13px',
    'color:#111;font-weight:600;font-size:13px;padding-left:6px',
    'color:#666;font-size:12px;line-height:1.6'
  );
}catch(e){}}
/* Inherit the theme's typography so the drawer feels native */
try{el.style.setProperty('--vf',getComputedStyle(document.body).fontFamily);}catch(e){}

const API='https://tryfit-production.up.railway.app';
const modal=$('vto-modal'),card=$('vto-card'),mini=$('vto-mini'),zoom=$('vto-zoom');
const fileInput=$('vto-file'),upState=$('vto-s-upload');
const HOME=(D.mode==='home');
let file=null,resultUrl=null,timer=null,sec=0,minimized=false,lastFocus=null,gotResult=false;
const PREV_KEY='vto_prev_'+D.shop;

/* Move overlays to <body> so theme transforms/overflow never clip the fixed drawer */
[modal,mini,zoom].forEach(n=>{try{n.classList.add('vto-root');n.style.setProperty('--vf',el.style.getPropertyValue('--vf')||'inherit');document.body.appendChild(n);}catch(e){}});

const show=s=>{['upload','proc','result','error'].forEach(x=>{const e=$('vto-s-'+x);if(e)e.style.display=x===s?'block':'none';});card.classList.toggle('is-result',s==='result');card.parentElement.classList.toggle('is-tall',s==='result');};
const lockScroll=on=>{document.documentElement.style.overflow=on?'hidden':'';};
const openModal=s=>{lastFocus=document.activeElement;modal.style.display='flex';lockScroll(true);show(s||'upload');if(!s||s==='upload'){upState.classList.remove('is-busy');qr(false);loadPrev();}setTimeout(()=>{try{$('vto-close').focus();}catch(e){}},50);};
const closeAll=()=>{modal.style.display='none';mini.style.display='none';lockScroll(false);stopTimer();minimized=false;try{lastFocus&&lastFocus.focus();}catch(e){}};
const resetUpload=()=>{file=null;if(fileInput)fileInput.value='';upState.classList.remove('is-busy');};
const toast=t=>{const n=$('vto-toast');if(!n)return;n.textContent=t;n.classList.add('is-on');clearTimeout(n._t);n._t=setTimeout(()=>n.classList.remove('is-on'),2200);};
const beacon=ev=>{try{const f=new FormData();f.append('shop',D.shop);f.append('product_id',D.pid);f.append('product_title',D.ptitle);f.append('event',ev);navigator.sendBeacon(API+'/log-tryon',f);}catch(e){}};

/* Timer + staged progress */
const STEPS=[...document.querySelectorAll('#vto-steps li')];
const startTimer=()=>{sec=0;tick();timer=setInterval(()=>{sec++;tick();updateStatus();},1000);};
const stopTimer=()=>{if(timer){clearInterval(timer);timer=null;}};
const tick=()=>{$('vto-timer').textContent=sec+' sec';$('vto-m-time').textContent=sec+' sec · You can keep browsing';};
const setStep=i=>{STEPS.forEach((li,k)=>{li.classList.toggle('is-done',k<i);li.classList.toggle('is-active',k===i);});
  const t=STEPS[i]?.querySelector('span')?.textContent||'';const ms=$('vto-m-status');if(ms)ms.textContent=t;};
const setProgress=p=>{p=Math.max(0,Math.min(100,p));const b=$('vto-prog-bar');if(b)b.style.width=p+'%';const t=$('vto-pct');if(t)t.textContent=Math.round(p)+'%';};
const updateStatus=()=>{let i=0;if(sec>=3)i=1;if(sec>=8)i=2;if(sec>=18)i=3;if(sec>=28)i=4;setStep(i);
  setProgress(sec<30?10+sec*2.7:Math.min(96,91+(sec-30)*0.2));};
const finishSteps=()=>{STEPS.forEach(li=>{li.classList.add('is-done');li.classList.remove('is-active');});setProgress(100);};

const toMini=()=>{minimized=true;modal.style.display='none';lockScroll(false);mini.style.display='flex';};
const toModal=()=>{minimized=false;mini.style.display='none';modal.style.display='flex';lockScroll(true);};

/* Recent looks (this session only) */
const savePrev=url=>{try{let a=JSON.parse(sessionStorage.getItem(PREV_KEY)||'[]');a=[url].concat(a.filter(x=>x!==url)).slice(0,6);sessionStorage.setItem(PREV_KEY,JSON.stringify(a));}catch(e){}};
const loadPrev=()=>{try{const a=JSON.parse(sessionStorage.getItem(PREV_KEY)||'[]'),w=$('vto-prev-wrap'),g=$('vto-prev-grid');
  if(a.length){w.style.display='block';g.innerHTML='';a.forEach(u=>{const i=document.createElement('img');i.src=u;i.alt='Recent look';i.loading='lazy';i.onclick=()=>{resultUrl=u;showResult(u);};g.appendChild(i);});}else w.style.display='none';}catch(e){}};

/* QR → continue on phone (desktop only) */
const qrBtn=$('vto-qr-btn');
const isTouch=window.matchMedia&&matchMedia('(hover:none) and (pointer:coarse)').matches;
if(isTouch&&qrBtn)qrBtn.style.display='none';
const qr=on=>{const q=$('vto-qr'),f=$('vto-fan');if(!q)return;
  if(on){const u=(D.purl||location.origin+location.pathname)+'?tryfit=open';$('vto-qr-img').src='https://api.qrserver.com/v1/create-qr-code/?size=360x360&margin=0&color=1c1b1a&data='+encodeURIComponent(u);}
  q.style.display=on?'flex':'none';f.style.display=on?'none':'block';$('vto-tip').style.display=on?'none':'block';$('vto-qr-lbl').textContent=on?'Back':'Upload from mobile';qrBtn.dataset.on=on?'1':'';};
qrBtn?.addEventListener('click',()=>qr(!qrBtn.dataset.on));

/* Result */
const showResult=url=>{
  const img=$('vto-res-img');img.src=url;$('vto-z-img').src=url;
  const fb=$('vto-fb');fb.querySelectorAll('button').forEach(b=>b.classList.remove('is-on'));$('vto-fb-t').textContent='Does this look right?';
  $('vto-pchip').classList.remove('is-open');
  show('result');setTimeout(()=>$('vto-pchip').classList.add('is-open'),700);
};

/* PDP button + availability (hidden when the store is out of try-ons) */
$('vto-btn').addEventListener('click',()=>openModal('upload'));
const hideVto=()=>{try{el.style.display='none';}catch(e){}};
const autoOpen=()=>{if(!/[?&]tryfit=open\b/.test(location.search))return;
  try{const u=new URL(location.href);u.searchParams.delete('tryfit');history.replaceState(history.state,'',u.toString());}catch(e){}
  setTimeout(()=>{if(el.style.display!=='none')openModal('upload');},350);};
(function(){if(window.Shopify&&Shopify.designMode)return;var k='vto_av_'+D.shop,c=null;
  try{c=JSON.parse(sessionStorage.getItem(k)||'null');}catch(e){}
  if(c&&Date.now()-c.t<120000){if(c.a===false)hideVto();else autoOpen();return;}
  fetch(API+'/proxy-tryon?shop='+encodeURIComponent(D.shop),{mode:'cors'}).then(r=>r.json()).then(d=>{
    var a=d.available!==false;try{sessionStorage.setItem(k,JSON.stringify({a:a,t:Date.now()}));}catch(e){}
    if(!a)hideVto();else autoOpen();}).catch(()=>autoOpen());})();

const closeOrMini=()=>{if($('vto-s-proc').style.display!=='none')toMini();else{closeAll();resetUpload();}};
$('vto-close').addEventListener('click',closeOrMini);
modal.addEventListener('click',e=>{if(e.target===modal)closeOrMini();});
document.addEventListener('keydown',e=>{if(e.key!=='Escape')return;
  if(zoom.style.display!=='none')zoom.style.display='none';
  else if(modal.style.display!=='none')closeOrMini();});
$('vto-m-expand').addEventListener('click',toModal);
mini.addEventListener('click',e=>{if(e.target.closest('#vto-m-expand'))return;toModal();});
$('vto-to-mini')?.addEventListener('click',toMini);

/* File → "Uploading…" blur → step 2 */
const startWith=f=>{
  if(!f||!f.type.startsWith('image/'))return;
  if(f.size>10*1024*1024){alert('Please choose a photo under 10 MB');return;}
  file=f;gotResult=false;qr(false);upState.classList.add('is-busy');
  const t0=Date.now(),r=new FileReader();
  r.onload=ev=>{$('vto-proc-u').src=ev.target.result;$('vto-m-u').src=ev.target.result;
    setTimeout(()=>{upState.classList.remove('is-busy');if(gotResult)return;show('proc');setProgress(0);setStep(0);startTimer();},Math.max(0,900-(Date.now()-t0)));
    runAI();};
  r.readAsDataURL(f);
};
fileInput?.addEventListener('change',e=>startWith(e.target.files[0]));
const dz=$('vto-dropzone');
if(dz){['dragover','dragenter'].forEach(t=>dz.addEventListener(t,e=>{e.preventDefault();dz.style.background='#faf8f6';}));
  dz.addEventListener('dragleave',()=>{dz.style.background='';});
  dz.addEventListener('drop',e=>{e.preventDefault();dz.style.background='';startWith(e.dataTransfer.files[0]);});}

async function runAI(){
  try{
    const fd=new FormData();
    fd.append('shop',D.shop);fd.append('product_id',D.pid);fd.append('product_title',D.ptitle);
    fd.append('product_image_url',D.pimg);fd.append('user_photo',file);fd.append('category',D.category||'dresses');fd.append('mode',D.mode||'fashion');
    const res=await fetch(API+'/proxy-tryon',{method:'POST',body:fd,mode:'cors'});
    const data=await res.json();
    stopTimer();
    if(res.ok&&data.success&&data.result_url){
      gotResult=true;resultUrl=data.result_url;savePrev(resultUrl);finishSteps();
      const pre=new Image();pre.onload=pre.onerror=()=>setTimeout(()=>{toModal();showResult(resultUrl);},350);pre.src=resultUrl;
      return;
    }
    if(res.status===429){
      $('vto-err-icon').textContent='✨';
      $('vto-err-title').textContent="You've loved this feature!";
      $('vto-err-msg').innerHTML='This store has used all its virtual try-ons for this month.<br>Please check back soon.';
      $('vto-err-retry').textContent='Got it';
      try{sessionStorage.setItem('vto_av_'+D.shop,JSON.stringify({a:false,t:Date.now()}));}catch(e){}
      $('vto-err-retry').addEventListener('click',()=>{closeAll();hideVto();},{once:true});
      gotResult=true;toModal();show('error');mini.style.display='none';return;
    }
    throw new Error(data.error||'We couldn’t create your preview.');
  }catch(err){
    gotResult=true;stopTimer();upState.classList.remove('is-busy');
    $('vto-err-icon').textContent='😔';
    $('vto-err-title').textContent='Something went wrong';
    $('vto-err-msg').textContent=(err&&err.message)||'Please try again in a moment.';
    $('vto-err-retry').textContent='Try again';
    toModal();show('error');mini.style.display='none';
  }
}

/* Result actions */
const backToUpload=()=>{resetUpload();show('upload');qr(false);loadPrev();};
$('vto-regen')?.addEventListener('click',backToUpload);
$('vto-err-retry')?.addEventListener('click',()=>{if($('vto-err-retry').textContent!=='Got it')backToUpload();});
$('vto-pchip')?.addEventListener('click',()=>{const c=$('vto-pchip');if(!c.classList.contains('is-open')){c.classList.add('is-open');return;}closeAll();try{window.scrollTo({top:0,behavior:'smooth'});}catch(e){}});
$('vto-fb')?.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{
  $('vto-fb').querySelectorAll('button').forEach(x=>x.classList.toggle('is-on',x===b));
  $('vto-fb-t').textContent=b.dataset.v==='up'?'Thanks! Glad you like it':'Thanks for the feedback';
  beacon(b.dataset.v==='up'?'feedback_up':'feedback_down');}));
/* Add to cart → theme's cart drawer if it has one, otherwise the cart page */
const DRAWER_SEL='cart-drawer,#CartDrawer,#cart-drawer,#Cart-Drawer,#sidebar-cart,#mini-cart,cart-notification,drawer-cart,[data-cart-drawer],.cart-drawer,.drawer--cart,#CartDrawer-Overlay';
const CART_LINK_SEL='header a[href$="/cart"],#cart-icon-bubble,[data-cart-toggle],[data-drawer-toggle="cart"],[aria-controls*="cart" i],.js-drawer-open-cart,.site-header__cart,a.header__icon--cart';
const fireCartEvents=(item)=>{const ev=['cart:refresh','cart:build','cart:updated','cart-drawer:refresh','theme:cart:change','ajaxProduct:added','product:added'];
  ev.forEach(n=>{try{const c=new CustomEvent(n,{bubbles:true,detail:{item,variant:item,quantity:1,cart:null}});document.dispatchEvent(c);document.documentElement.dispatchEvent(new CustomEvent(n,{bubbles:true,detail:{item,variant:item,quantity:1}}));}catch(e){}});};
async function addToCartAndOpen(vid){
  const dawn=document.querySelector('cart-drawer');
  const hasDrawer=D.cartType!=='page'&&!!document.querySelector(DRAWER_SEL);
  /* Dawn family (Dawn, Sense, Craft, Refresh, Studio…): render the drawer sections in the same request */
  if(hasDrawer&&dawn&&typeof dawn.renderContents==='function'&&typeof dawn.getSectionsToRender==='function'){
    const r=await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},
      body:JSON.stringify({id:vid,quantity:1,sections:dawn.getSectionsToRender().map(s=>s.id),sections_url:location.pathname})});
    const j=await r.json();if(!r.ok)throw new Error(j.description||j.message||'Could not add to cart');
    closeAll();dawn.classList.remove('is-empty');dawn.renderContents(j);return;
  }
  const r=await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({id:vid,quantity:1})});
  const j=await r.json();if(!r.ok)throw new Error(j.description||j.message||'Could not add to cart');
  if(!hasDrawer){window.location.href='/cart';return;}
  closeAll();fireCartEvents(j);
  /* Other themes: their own cart icon opens (and refreshes) the drawer; if nothing opens, go to /cart */
  const link=[...document.querySelectorAll(CART_LINK_SEL)].find(a=>a.offsetParent!==null);
  if(link){setTimeout(()=>link.click(),120);}else window.location.href='/cart';
}
$('vto-buy')?.addEventListener('click',async()=>{
  beacon('atc');const btn=$('vto-buy'),txt=btn.textContent;btn.textContent='Adding…';btn.disabled=true;
  const vid=document.querySelector('form[action*="/cart/add"] [name="id"]')?.value||D.vid;
  try{await addToCartAndOpen(vid);btn.textContent='Added ✓';setTimeout(()=>{btn.textContent=txt;btn.disabled=false;},1500);}
  catch(e){btn.textContent=txt;btn.disabled=false;toast((e&&e.message)||'Could not add to cart');}
});
const shareText=()=>(HOME?'See how ':'Look how ')+D.ptitle+(HOME?' looks in my space ✨':' looks on me ✨');
$('vto-wa')?.addEventListener('click',()=>{beacon('share');window.open('https://wa.me/?text='+encodeURIComponent(shareText()+'\n'+(resultUrl||'')+'\n\nShop it: '+(D.purl||location.href)),'_blank','noopener');});
$('vto-share')?.addEventListener('click',async()=>{
  beacon('share');const url=D.purl||location.href;
  try{
    if(navigator.canShare&&resultUrl){const b=await (await fetch(resultUrl)).blob();const f=new File([b],'my-look.jpg',{type:b.type||'image/jpeg'});
      if(navigator.canShare({files:[f]})){await navigator.share({files:[f],title:D.ptitle,text:shareText()+' '+url});return;}}
    if(navigator.share){await navigator.share({title:D.ptitle,text:shareText(),url});return;}
  }catch(e){if(e&&e.name==='AbortError')return;}
  try{await navigator.clipboard.writeText(resultUrl||url);toast('Link copied');}catch(e){toast('Couldn’t share');}
});
$('vto-dl')?.addEventListener('click',async()=>{
  if(!resultUrl)return;
  try{const b=await (await fetch(resultUrl)).blob();const u=URL.createObjectURL(b);const a=document.createElement('a');a.href=u;a.download='my-look.jpg';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),2000);}
  catch(e){window.open(resultUrl,'_blank','noopener');}
});

/* Full-screen view */
const openZoom=()=>{if(resultUrl)zoom.style.display='flex';};
$('vto-fs')?.addEventListener('click',openZoom);
$('vto-res-wrap')?.addEventListener('click',openZoom);
$('vto-z-close')?.addEventListener('click',e=>{e.stopPropagation();zoom.style.display='none';});
zoom?.addEventListener('click',e=>{if(e.target.id!=='vto-z-img')zoom.style.display='none';});
})();
</script>
{% endif %}

{% schema %}
{
  "name": "TryFit – Virtual Try-On",
  "target": "section",
  "templates": ["product"],
  "settings": [
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_text", "label": "Button Text (fashion)", "default": "TRY ON" },
    { "type": "text", "id": "button_text_home", "label": "Button Text (home decor)", "default": "SEE IN MY ROOM" },
    { "type": "color", "id": "button_color", "label": "Button Color", "default": "#111111" },
    { "type": "color", "id": "button_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "range", "id": "button_radius", "label": "Corner Radius", "min": 0, "max": 30, "step": 2, "default": 12, "unit": "px" },
    { "type": "header", "content": "AI Settings" },
    { "type": "select", "id": "tryon_mode", "label": "Experience", "default": "auto", "info": "Auto detects home-decor products (bedsheets, curtains, rugs, cushions, wall art) from title/type/tags and switches to room placement.", "options": [
      { "value": "auto", "label": "Auto (recommended)" },
      { "value": "fashion", "label": "Fashion — wear it on a photo" },
      { "value": "home", "label": "Home decor — place it in a room photo" }
    ]},
    { "type": "select", "id": "garment_category", "label": "Garment Type", "default": "dresses", "info": "Upper body = tops/shirts. Lower body = pants/skirts. Full body = kurta sets, dresses, jumpsuits.", "options": [
      { "value": "upper_body", "label": "Upper Body (tops, shirts, jackets)" },
      { "value": "lower_body", "label": "Lower Body (pants, skirts)" },
      { "value": "dresses", "label": "Full Body (sets, dresses, jumpsuits)" }
    ]}
  ]
}
{% endschema %}
