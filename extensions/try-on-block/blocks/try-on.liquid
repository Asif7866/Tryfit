.vto-priv{display:flex;align-items:center;justify-content:center;gap:6px;margin:10px 0 0;font-size:11.5px;color:#aaa6a3;}
.vto-prev{width:100%;margin-top:14px;text-align:left;}
.vto-prev__label{font-size:12px;font-weight:600;color:#7d7a78;margin:0 0 8px;letter-spacing:.02em;}
.vto-prev__grid{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;}
