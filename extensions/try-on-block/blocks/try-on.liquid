{%- assign vto_cfg = shop.metafields.tryfit.config.value -%}
{%- assign vto_disabled = false -%}
{%- if vto_cfg and vto_cfg.disabledProducts -%}
  {%- assign vto_pid_str = product.id | append: "" -%}
  {%- for d in vto_cfg.disabledProducts -%}
    {%- assign d_str = d | append: "" -%}
    {%- if d_str == vto_pid_str -%}{%- assign vto_disabled = true -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign vto_btn_text = block.settings.button_text -%}
{%- assign vto_btn_color = block.settings.button_color -%}
{%- assign vto_btn_text_color = block.settings.button_text_color -%}
{%- assign vto_btn_radius = block.settings.button_radius -%}
{%- if vto_cfg -%}
  {%- if vto_cfg.buttonText != blank -%}{%- assign vto_btn_text = vto_cfg.buttonText -%}{%- endif -%}
  {%- if vto_cfg.buttonColor != blank -%}{%- assign vto_btn_color = vto_cfg.buttonColor -%}{%- endif -%}
  {%- if vto_cfg.buttonTextColor != blank -%}{%- assign vto_btn_text_color = vto_cfg.buttonTextColor -%}{%- endif -%}
  {%- if vto_cfg.buttonRadius != blank -%}{%- assign vto_btn_radius = vto_cfg.buttonRadius -%}{%- endif -%}
{%- endif -%}
{%- assign vto_mode = block.settings.tryon_mode | default: "auto" -%}
{%- if vto_mode == "auto" -%}
  {%- assign vto_hay = product.title | append: " " | append: product.type | append: " " | append: product.tags | join: " " | downcase -%}
  {%- assign vto_home_words = "bedsheet,bed sheet,bedding,comforter,duvet,quilt,dohar,blanket,throw,pillow,cushion,curtain,drape,rug,carpet,mat,table cloth,tablecloth,runner,wall art,painting,frame,poster,tapestry,sofa cover,mattress" | split: "," -%}
  {%- assign vto_mode = "fashion" -%}
  {%- for w in vto_home_words -%}
    {%- if vto_hay contains w -%}{%- assign vto_mode = "home" -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{% if product and vto_disabled == false %}
<!--
  ┌──────────────────────────────────────────────────────────────┐
  │  TryFit — AI Virtual Try-On for Shopify                      │
  │  Shoppers see outfits on themselves, or decor in their room. │
  │  Built by FutureTechiez · https://futuretechiez.in           │
  │  Get it for your store → https://apps.shopify.com/partners/futuretechiez │
  └──────────────────────────────────────────────────────────────┘
-->
{%- assign vto_btn_label = vto_btn_text -%}
{%- if vto_mode == "home" -%}{%- assign vto_btn_label = block.settings.button_text_home | default: "SEE IN MY ROOM" -%}{%- endif -%}
<div
  id="vto"
  data-app="TryFit by FutureTechiez"
  data-app-url="https://futuretechiez.in"
  data-pid="{{ product.id }}"
  data-ptitle="{{ product.title | escape }}"
  data-pimg="{{ product.featured_image | image_url: width: 1024 }}"
  data-purl="{{ shop.url }}{{ product.url }}"
  data-shop="{{ shop.permanent_domain }}"
  data-category="{{ block.settings.garment_category }}"
  data-mode="{{ vto_mode }}"
  data-vid="{{ product.selected_or_first_available_variant.id }}"
  data-cart-type="{{ settings.cart_type | default: '' }}"
>
  <button id="vto-btn" class="vto-btn" type="button">
    {%- if vto_mode == "home" -%}
    <svg class="vto-btn__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 4l9 6.5"/><path d="M5 9.5V20h14V9.5"/><path d="M8 20v-4.5a1.5 1.5 0 0 1 1.5-1.5h5a1.5 1.5 0 0 1 1.5 1.5V20"/><path d="M18.5 2.5l.5 1.3 1.3.5-1.3.5-.5 1.3-.5-1.3-1.3-.5 1.3-.5z" fill="currentColor" stroke="none"/></svg>
    {%- else -%}
    <svg class="vto-btn__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="11" cy="11.5" rx="6" ry="8.5"/><path d="M11 20v2.5M8 22.5h6"/><path d="M8.6 8.2a3.6 3.6 0 0 1 2.4-1.7"/><path d="M19.5 2.5l.6 1.5 1.5.6-1.5.6-.6 1.5-.6-1.5-1.5-.6 1.5-.6z" fill="currentColor" stroke="none"/></svg>
    {%- endif -%}
    <span>{{ vto_btn_label }}</span>
  </button>

  <!-- ═══ DRAWER ═══ -->
  <div id="vto-modal" class="vto-overlay" style="display:none;" role="dialog" aria-modal="true" aria-label="{% if vto_mode == 'home' %}See it in your room{% else %}Virtual try-on{% endif %}">
    <div class="vto-frame">
    <div class="vto-card" id="vto-card">
      <div class="vto-head">
        <span class="vto-head__t">{% if vto_mode == "home" %}SEE IT IN YOUR ROOM{% else %}VIRTUAL TRY-ON{% endif %}</span>
        <button id="vto-close" class="vto-x" type="button" aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
      </div>

      <!-- STEP 1 · UPLOAD -->
      <div id="vto-s-upload" class="vto-s vto-up">
        <div class="vto-up__in" id="vto-dropzone">
          <span class="vto-chip">STEP 1</span>
          <h2 class="vto-h" id="vto-subtitle">{% if vto_mode == "home" %}Ready to see it in your space?{% else %}Ready to try this on?{% endif %}</h2>

          <div class="vto-fan" id="vto-fan">
            {%- if vto_mode == "home" -%}
            <figure class="vto-fan__c vto-fan__c--l"><span class="vto-mk vto-mk--x"></span>
              <img src="https://tryfit-production.up.railway.app/guide/closeup" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" /></figure>
            <figure class="vto-fan__c vto-fan__c--c"><span class="vto-mk vto-mk--ok"></span>
              <img src="https://tryfit-production.up.railway.app/guide/room" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" />
              <span class="vto-fan__tag">WHOLE SPACE</span></figure>
            <figure class="vto-fan__c vto-fan__c--r"><span class="vto-mk vto-mk--x"></span>
              <img src="https://tryfit-production.up.railway.app/guide/dark" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" /></figure>
            {%- else -%}
            <figure class="vto-fan__c vto-fan__c--l"><span class="vto-mk vto-mk--x"></span>
              <img src="https://tryfit-production.up.railway.app/guide/group" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" /></figure>
            <figure class="vto-fan__c vto-fan__c--c"><span class="vto-mk vto-mk--ok"></span>
              <img src="https://tryfit-production.up.railway.app/guide/full" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" />
              <span class="vto-fan__tag">FULL BODY</span></figure>
            <figure class="vto-fan__c vto-fan__c--r"><span class="vto-mk vto-mk--x"></span>
              <img src="https://tryfit-production.up.railway.app/guide/selfie" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" /></figure>
            {%- endif -%}
          </div>

          <div id="vto-qr" class="vto-qr" style="display:none;">
            <div class="vto-qr__box"><img id="vto-qr-img" alt="QR code" width="180" height="180" /></div>
            <p class="vto-qr__t">Scan with your phone camera</p>
            <p class="vto-tip">Take or pick a photo on your phone — your result appears there.</p>
          </div>

          <p class="vto-tip" id="vto-tip">{% if vto_mode == "home" %}A wide photo of the bed, window or wall gives the most realistic result.<br><span>No close-ups or dark photos.</span>{% else %}A full-length photo gives the most accurate fit.<br><span>No group photos or selfies.</span>{% endif %}</p>

          <label class="vto-cta" for="vto-file">
            <input type="file" id="vto-file" accept="image/jpeg,image/png,image/webp" />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9.4 4h5.2l1.5 2H19a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h2.9zM12 17.2a4.2 4.2 0 1 0 0-8.4 4.2 4.2 0 0 0 0 8.4zm0-1.9a2.3 2.3 0 1 1 0-4.6 2.3 2.3 0 0 1 0 4.6z"/></svg>
            <span>{% if vto_mode == "home" %}Choose a room photo{% else %}Choose a photo{% endif %}</span>
          </label>
          <button id="vto-qr-btn" class="vto-ghost" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v.01M14 20h.01M17 20h4v-3"/></svg>
            <span id="vto-qr-lbl">Upload from mobile</span>
          </button>

          <div id="vto-prev-wrap" class="vto-prev" style="display:none;">
            <p class="vto-prev__label">Your recent looks</p>
            <div id="vto-prev-grid" class="vto-prev__grid"></div>
          </div>
          <p class="vto-priv"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg> Private · your photo is deleted after the preview</p>
        </div>
        <div class="vto-uploading" id="vto-uploading"><span class="vto-spin"></span><strong>Uploading your image…</strong></div>
      </div>

      <!-- STEP 2 · PROCESSING -->
      <div id="vto-s-proc" class="vto-s vto-pr" style="display:none;">
        <span class="vto-chip">STEP 2</span>
        <h2 class="vto-h">{% if vto_mode == "home" %}Styling your space…{% else %}Preparing your look…{% endif %}</h2>
        <div class="vto-pair">
          <div class="vto-pair__i"><img id="vto-proc-p" src="{{ product.featured_image | image_url: width: 600 }}" alt="" /></div>
          <span class="vto-pair__sw"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 0 0-14.3-4.9L4 8"/><path d="M4 3v5h5"/><path d="M4 13a8 8 0 0 0 14.3 4.9L20 16"/><path d="M20 21v-5h-5"/></svg></span>
          <div class="vto-pair__i vto-pair__i--u"><img id="vto-proc-u" alt="" /><div class="vto-scan"></div></div>
        </div>
        <div class="vto-prog"><div id="vto-prog-bar" class="vto-prog__bar"></div></div>
        <p class="vto-pct" id="vto-pct">0%</p>
        <ul class="vto-steps" id="vto-steps">
          {%- if vto_mode == "home" -%}
          <li><i></i><span>Reading your room photo</span></li>
          <li><i></i><span>Studying the product</span></li>
          <li><i></i><span>Placing it in your room</span></li>
          <li><i></i><span>Matching light &amp; perspective</span></li>
          <li><i></i><span>Final touches</span></li>
          {%- else -%}
          <li><i></i><span>Reading your photo</span></li>
          <li><i></i><span>Analysing the garment</span></li>
          <li><i></i><span>Fitting it on you</span></li>
          <li><i></i><span>Matching light &amp; shadows</span></li>
          <li><i></i><span>Final touches</span></li>
          {%- endif -%}
        </ul>
        <p class="vto-note">Colors and fit shown in AI-generated previews may vary slightly from the final product.</p>
        <p class="vto-time"><span id="vto-timer">0 sec</span> · usually 15–30 sec</p>
        <button id="vto-to-mini" class="vto-link" type="button">Keep browsing — we'll bring it back ›</button>
      </div>

      <!-- RESULT -->
      <div id="vto-s-result" class="vto-s vto-rs" style="display:none;">
        <div class="vto-rs__pic" id="vto-res-wrap"><img id="vto-res-img" alt="Your try-on result" /></div>
        <button id="vto-fs" class="vto-rs__fs" type="button" aria-label="View full screen"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></button>
        <div class="vto-rs__bot">
          <div class="vto-rs__row">
            <button id="vto-pchip" class="vto-pchip" type="button" aria-label="{{ product.title | escape }}">
              <img src="{{ product.featured_image | image_url: width: 160 }}" alt="" />
              <span class="vto-pchip__t">{{ product.title }}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
            </button>
            <div class="vto-fb" id="vto-fb">
              <span id="vto-fb-t">Does this look right?</span><i></i>
              <button type="button" data-v="up" aria-label="Looks right"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M7 10v11H3V10zM7 10l4-7c1.7 0 2.7 1.3 2.3 3L12.6 9H19a2 2 0 0 1 2 2.3l-1.2 7.4A2.6 2.6 0 0 1 17.2 21H7"/></svg></button>
              <button type="button" data-v="down" aria-label="Doesn't look right"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" style="transform:rotate(180deg)"><path d="M7 10v11H3V10zM7 10l4-7c1.7 0 2.7 1.3 2.3 3L12.6 9H19a2 2 0 0 1 2 2.3l-1.2 7.4A2.6 2.6 0 0 1 17.2 21H7"/></svg></button>
            </div>
          </div>
          <div class="vto-rs__acts">
            <button id="vto-buy" class="vto-atc" type="button">Add to Cart</button>
            <button id="vto-wa" class="vto-ic" type="button" aria-label="Share on WhatsApp"><svg width="22" height="22" viewBox="0 0 24 24"><path fill="#25D366" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/><path fill="#fff" d="M17.3 14.6c-.3-.1-1.7-.8-1.9-.9-.3-.1-.5-.1-.7.1l-.9 1.1c-.2.2-.3.2-.6.1-1.6-.8-2.7-1.5-3.8-3.3-.3-.5.3-.4.8-1.4.1-.2 0-.3 0-.5l-.9-2.1c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 1.8.8 2.6.8 3.5.7.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"/></svg></button>
            <button id="vto-share" class="vto-ic" type="button" aria-label="Share"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="M8.3 10.8l7.4-4.4M8.3 13.2l7.4 4.4"/></svg></button>
          </div>
          <div class="vto-rs__more"><button id="vto-regen" type="button">Try another photo</button><span>·</span><button id="vto-dl" type="button">Download</button></div>
          <div class="vto-powered">Powered by <a href="https://futuretechiez.in" target="_blank" rel="noopener">TryFit</a></div>
        </div>
        <div class="vto-toast" id="vto-toast"></div>
      </div>

      <!-- ERROR -->
      <div id="vto-s-error" class="vto-s" style="display:none;">
        <div class="vto-err">
          <p class="vto-err__icon" id="vto-err-icon">😔</p>
          <h3 id="vto-err-title">Something went wrong</h3>
          <p id="vto-err-msg"></p>
          <button id="vto-err-retry" class="vto-cta vto-cta--btn" type="button">Try Again</button>
        </div>
      </div>
    </div>
    </div>
  </div>

  <!-- ═══ MINIBAR ═══ -->
  <div id="vto-mini" class="vto-mini" style="display:none;">
    <div class="vto-mini__thumbs">
      <img id="vto-m-p" src="{{ product.featured_image | image_url: width: 120 }}" alt="" />
      <div class="vto-mini__sp"><span class="vto-spin vto-spin--s"></span></div>
      <img id="vto-m-u" alt="" />
    </div>
    <div class="vto-mini__body">
      <strong id="vto-m-status">Starting your try-on</strong>
      <span id="vto-m-time">0 sec · You can keep browsing</span>
    </div>
    <button id="vto-m-expand" class="vto-mini__arrow" type="button" aria-label="Expand">›</button>
  </div>

  <!-- ═══ ZOOM ═══ -->
  <div id="vto-zoom" class="vto-zoom" style="display:none;">
    <div class="vto-zoom__in">
      <img id="vto-z-img" alt="Your try-on result, full size" />
      <button id="vto-z-close" class="vto-zoom__x" type="button" aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    </div>
  </div>
</div>

<style>
#vto,.vto-root{--vf:inherit;--vr:{{ vto_btn_radius }}px;--vc:{{ vto_btn_color }};--vt:{{ vto_btn_text_color }};--ink:#1c1b1a;--soft:#3b3735;}
#vto,#vto *,.vto-root,.vto-root *{box-sizing:border-box;}
#vto button,.vto-root button,.vto-root input,.vto-root label{font-family:var(--vf);}

/* PDP BUTTON */
.vto-btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:52px;padding:14px 24px;margin-top:10px;background:var(--vc);color:var(--vt);border:none;border-radius:var(--vr);font-family:var(--vf);font-size:16px;font-weight:500;letter-spacing:.2px;line-height:1;cursor:pointer;box-shadow:0 1px 2px rgba(0,0,0,.08);transition:transform .2s,box-shadow .2s,opacity .2s;}
.vto-btn:hover{transform:translateY(-1px);box-shadow:0 8px 22px rgba(0,0,0,.14);}
.vto-btn:active{transform:none;}
.vto-btn__icon{flex-shrink:0;}

/* DRAWER */
.vto-overlay{position:fixed;inset:0;z-index:2147483000;background:rgba(15,14,13,.16);display:flex;align-items:center;justify-content:flex-end;padding:24px;animation:vF .25s ease;}
.vto-frame{width:380px;max-width:100%;max-height:calc(100vh - 48px);max-height:calc(100dvh - 48px);display:flex;transition:height .45s cubic-bezier(.16,1,.3,1);padding:1.5px;border-radius:30px;background:linear-gradient(150deg,#f2c9a0 0%,#ebb6d3 34%,#c4c4f3 66%,#b6e5da 100%);box-shadow:0 30px 80px rgba(20,16,12,.22),0 6px 18px rgba(20,16,12,.08);animation:vIn .45s cubic-bezier(.16,1,.3,1);}
.vto-card{position:relative;width:100%;max-height:inherit;border-radius:28.5px;background:#fff;overflow:hidden;display:flex;flex-direction:column;font-family:var(--vf);color:var(--ink);}
.vto-frame.is-tall{height:min(700px,calc(100vh - 48px));height:min(700px,calc(100dvh - 48px));}
.vto-frame.is-tall .vto-card{height:100%;}
.vto-head{position:relative;z-index:5;flex-shrink:0;display:flex;align-items:center;justify-content:center;height:54px;padding:0 56px;}
.vto-head__t{font-size:12px;font-weight:600;letter-spacing:.28em;color:var(--ink);}
.vto-x{position:absolute;right:16px;top:50%;transform:translateY(-50%);width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;border-radius:50%;color:var(--ink);cursor:pointer;transition:background .2s;}
.vto-x:hover{background:rgba(0,0,0,.05);}
.vto-root button:focus:not(:focus-visible){outline:none;}
.vto-s{flex:1 1 auto;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;padding:2px 22px 18px;animation:vSt .45s cubic-bezier(.16,1,.3,1);}
.vto-s::-webkit-scrollbar{width:0;}

/* STEP 1 */
.vto-up{position:relative;padding:0;}
.vto-up__in{min-height:100%;display:flex;flex-direction:column;align-items:center;text-align:center;padding:2px 22px 16px;transition:filter .35s,opacity .35s;}
.vto-chip{display:inline-block;padding:4px 10px;border-radius:999px;background:#8b8785;color:#fff;font-size:9.5px;font-weight:700;letter-spacing:.14em;}
.vto-h{margin:10px 0 0;font-family:var(--vf);font-size:22px;font-weight:500;line-height:1.2;letter-spacing:-.01em;color:var(--ink);}
.vto-fan{position:relative;width:100%;height:186px;margin:18px 0 14px;}
.vto-fan__c{position:absolute;top:50%;left:50%;margin:0;width:100px;height:134px;border-radius:12px;overflow:hidden;background:linear-gradient(135deg,#efebe6,#e2ddd6);box-shadow:0 12px 28px rgba(0,0,0,.12),0 2px 6px rgba(0,0,0,.06);transition:transform .5s cubic-bezier(.16,1,.3,1);}
.vto-fan__c img{width:100%;height:100%;object-fit:cover;display:block;opacity:0;transform:scale(1.04);transition:opacity .6s ease,transform .8s cubic-bezier(.16,1,.3,1);}
.vto-fan__c img.is-in{opacity:1;transform:none;}
.vto-fan__c--l{transform:translate(-118%,-46%) rotate(-8deg) scale(.9);filter:saturate(.85);}
.vto-fan__c--r{transform:translate(18%,-46%) rotate(8deg) scale(.9);filter:saturate(.85);}
.vto-fan__c--c{z-index:2;width:118px;height:160px;transform:translate(-50%,-50%);box-shadow:0 18px 40px rgba(0,0,0,.18),0 2px 8px rgba(0,0,0,.08);}
.vto-fan:hover .vto-fan__c--l{transform:translate(-128%,-46%) rotate(-11deg) scale(.9);}
