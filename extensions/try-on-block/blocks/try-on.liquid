{% if product %}
<div
  id="vto"
  data-pid="{{ product.id }}"
  data-ptitle="{{ product.title | escape }}"
  data-pimg="{{ product.featured_image | image_url: width: 1024 }}"
  data-shop="{{ shop.permanent_domain }}"
  data-category="{{ block.settings.garment_category }}"
>
  <button id="vto-btn" class="vto-btn" type="button">
    <span class="vto-btn__shimmer"></span>
    <span class="vto-btn__label">{{ block.settings.button_text }}</span>
    <span class="vto-btn__tag">AI</span>
  </button>

  <div id="vto-popup" class="vto-popup" style="display:none;">
    <div class="vto-popup__inner">
      <img src="{{ product.featured_image | image_url: width: 80 }}" class="vto-popup__thumb" width="44" height="44" alt="" />
      <div class="vto-popup__text">
        <strong>See it on you ✨</strong>
        <span>{{ block.settings.popup_subtitle }}</span>
      </div>
      <button id="vto-popup-cta" class="vto-popup__cta" type="button">Try</button>
      <button id="vto-popup-close" class="vto-popup__x" type="button" aria-label="Close">✕</button>
    </div>
  </div>

  <div id="vto-overlay" class="vto-overlay" style="display:none;">
    <div class="vto-modal" role="dialog" aria-modal="true">
      <button id="vto-modal-close" class="vto-close" type="button" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <div id="vto-s-upload" class="vto-state">
        <div class="vto-modal__top">
          <div class="vto-badge">✨ Virtual Try-On</div>
          <h2 class="vto-title">{{ block.settings.modal_title }}</h2>
          <p class="vto-sub">{{ block.settings.modal_subtitle }}</p>
        </div>

        <div class="vto-product-card">
          <img src="{{ product.featured_image | image_url: width: 120 }}" class="vto-product-card__img" width="56" height="56" alt="{{ product.title | escape }}" />
          <div class="vto-product-card__info">
            <span class="vto-product-card__name">{{ product.title }}</span>
            <span class="vto-product-card__price">{{ product.price | money }}</span>
          </div>
        </div>

        <div id="vto-dropzone" class="vto-drop">
          <input type="file" id="vto-file" accept="image/jpeg,image/png,image/webp" />
          <div id="vto-dz-empty" class="vto-drop__empty">
            <div class="vto-drop__circle">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
            </div>
            <p class="vto-drop__label">Tap to upload your photo</p>
            <p class="vto-drop__hint">JPG, PNG or WebP · Max 10 MB</p>
          </div>
          <div id="vto-dz-preview" class="vto-drop__preview" style="display:none;">
            <img id="vto-preview-img" width="200" height="200" alt="Your photo" />
            <button id="vto-change-photo" class="vto-drop__change" type="button">Change photo</button>
          </div>
        </div>

        <button id="vto-submit" class="vto-main-cta" type="button" disabled>
          <span id="vto-submit-text">Upload photo to try on</span>
        </button>
        <p class="vto-privacy">🔒 Your photo is never stored</p>
      </div>

      <div id="vto-s-loading" class="vto-state" style="display:none;">
        <div class="vto-loading-wrap">
          <div class="vto-loader-bg"></div>
          <div class="vto-loader-visual">
            <div class="vto-loader-glow"></div>
            <div class="vto-loader-ring">
              <div class="vto-loader-ring__inner"></div>
            </div>
            <div class="vto-loader-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="url(#vto-grad)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <defs><linearGradient id="vto-grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#7c3aed"/><stop offset="100%" stop-color="#ec4899"/></linearGradient></defs>
                <path d="M20.38 3.46L16 2 12 5.5 8 2 3.62 3.46a2 2 0 01-.62 3.88v8a2 2 0 002 2h14a2 2 0 002-2v-8a2 2 0 01-.62-3.88z"/>
                <path d="M12 5.5v14.5"/>
                <path d="M3 7h18"/>
              </svg>
            </div>
            <div class="vto-loader-particles">
              <span style="--i:0"></span><span style="--i:1"></span><span style="--i:2"></span>
              <span style="--i:3"></span><span style="--i:4"></span><span style="--i:5"></span>
            </div>
          </div>
          <h3 class="vto-loading__title" id="vto-loading-title">Analyzing your photo...</h3>
          <p class="vto-loading__sub" id="vto-loading-sub">Detecting body shape & pose</p>
          <div class="vto-progress">
            <div class="vto-progress__bar"></div>
            <div class="vto-progress__shimmer"></div>
          </div>
          <div class="vto-loading-steps">
            <div class="vto-lstep active" id="vto-ls1"><span class="vto-lstep__icon">⏳</span> Detecting body pose</div>
            <div class="vto-lstep" id="vto-ls2"><span class="vto-lstep__icon">👗</span> Mapping garment fit</div>
            <div class="vto-lstep" id="vto-ls3"><span class="vto-lstep__icon">✨</span> Rendering final look</div>
          </div>
          <p class="vto-loading__time">⚡ Usually takes 15–30 seconds</p>
        </div>
      </div>

      <div id="vto-s-result" class="vto-state" style="display:none;">
        <div class="vto-result-wrap">
          <div class="vto-badge">🎉 Your Look</div>
          <div class="vto-result__img-wrap">
            <img id="vto-result-img" width="400" height="400" alt="Try-on result" />
          </div>
          <div class="vto-result__btns">
            <button id="vto-retry" class="vto-btn-ghost" type="button">↻ Try Another</button>
            <button id="vto-addtocart" class="vto-main-cta vto-main-cta--sm" type="button">Add to Cart 🛒</button>
          </div>
          <p class="vto-disclaimer">Colors and fit shown in AI-generated previews may vary slightly from the actual product.</p>
          <div class="vto-powered">Powered by <a href="https://futuretechiez.in" target="_blank" rel="noopener noreferrer">Futuretechiez.in</a></div>
        </div>
      </div>

      <div id="vto-s-error" class="vto-state" style="display:none;">
        <div class="vto-error-wrap">
          <div class="vto-error__emoji">😔</div>
          <h3 class="vto-error__title">Oops, something broke</h3>
          <p id="vto-error-msg" class="vto-error__msg"></p>
          <button id="vto-error-retry" class="vto-main-cta" type="button">Try Again</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
:root {
  --vto-primary: {{ block.settings.button_color }};
  --vto-primary-text: {{ block.settings.button_text_color }};
  --vto-r: {{ block.settings.button_radius }}px;
  --vto-ff: 'Inter', system-ui, -apple-system, sans-serif;
}
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

/* ── BUTTON ── */
.vto-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 16px 24px;
  margin-top: 12px;
  background: linear-gradient(135deg, #111 0%, #333 100%);
  color: #fff;
  border: none;
  border-radius: var(--vto-r);
  font: 700 15px/1 var(--vto-ff);
  cursor: pointer;
  overflow: hidden;
  transition: transform .15s, box-shadow .2s;
  letter-spacing: 0.5px;
}
.vto-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0,0,0,.2);
}
.vto-btn:active { transform: translateY(0); }
.vto-btn__shimmer {
  position: absolute;
  top: 0; left: -100%;
  width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.15), transparent);
  animation: vto-shimmer 2.5s infinite;
}
.vto-btn__tag {
  padding: 3px 10px;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 6px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  color: #fff;
}

/* ── POPUP ── */
.vto-popup {
  margin-top: 10px;
  animation: vto-slideUp .4s ease;
}
.vto-popup__inner {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  background: #111;
  border-radius: 14px;
  position: relative;
}
.vto-popup__thumb {
  width: 44px; height: 44px;
  border-radius: 10px;
  object-fit: cover;
}
.vto-popup__text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1px;
}
.vto-popup__text strong { color: #fff; font: 600 13px/1.3 var(--vto-ff); }
.vto-popup__text span { color: #888; font: 400 11px/1.3 var(--vto-ff); }
.vto-popup__cta {
  padding: 7px 16px;
  background: #fff;
  color: #111;
  border: none;
  border-radius: 8px;
  font: 700 12px/1 var(--vto-ff);
  cursor: pointer;
}
.vto-popup__x {
  position: absolute;
  top: -6px; right: -4px;
  background: #333;
  border: none;
  border-radius: 50%;
  width: 20px; height: 20px;
  color: #aaa;
  font-size: 10px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── OVERLAY ── */
.vto-overlay {
  position: fixed;
  inset: 0;
  z-index: 999999;
  background: rgba(0,0,0,.6);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  animation: vto-fadeIn .25s;
}

/* ── MODAL ── */
.vto-modal {
  background: #fff;
  border-radius: 28px;
  max-width: 440px;
  width: 100%;
  max-height: 92vh;
  overflow-y: auto;
  padding: 32px 28px;
  position: relative;
  box-shadow: 0 32px 80px rgba(0,0,0,.25), 0 0 0 1px rgba(0,0,0,.04);
  animation: vto-scaleIn .3s cubic-bezier(.16,1,.3,1);
}
.vto-close {
  position: absolute;
  top: 16px; right: 16px;
  width: 34px; height: 34px;
  background: #f5f5f5;
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #555;
  z-index: 2;
  transition: background .15s;
}
.vto-close:hover { background: #eee; }

/* ── BADGE ── */
.vto-badge {
  display: inline-block;
  padding: 6px 16px;
  background: linear-gradient(135deg, #f5f3ff, #fdf2f8);
  border: 1px solid rgba(139,92,246,.08);
  border-radius: 24px;
  font: 600 11px/1 var(--vto-ff);
  color: #7c3aed;
  margin-bottom: 14px;
  letter-spacing: 0.3px;
}

.vto-modal__top { text-align: center; margin-bottom: 22px; }
.vto-title { margin: 0; font: 800 26px/1.15 var(--vto-ff); color: #111; letter-spacing: -0.8px; }
.vto-sub { margin: 8px 0 0; font: 400 14px/1.5 var(--vto-ff); color: #999; }

/* ── PRODUCT CARD ── */
.vto-product-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 16px;
  background: #fafafa;
  border: 1px solid #f0f0f0;
  border-radius: 16px;
  margin-bottom: 18px;
  transition: box-shadow .2s;
}
.vto-product-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,.04); }
.vto-product-card__img {
  width: 56px; height: 56px;
  border-radius: 14px;
  object-fit: cover;
  box-shadow: 0 2px 8px rgba(0,0,0,.06);
}
.vto-product-card__info { display: flex; flex-direction: column; gap: 3px; }
.vto-product-card__name { font: 600 14px/1.3 var(--vto-ff); color: #111; }
.vto-product-card__price { font: 600 13px/1 var(--vto-ff); color: #888; }

/* ── DROPZONE ── */
.vto-drop {
  position: relative;
  border: 2px dashed #e0e0e0;
  border-radius: 20px;
  padding: 32px 16px;
  text-align: center;
  cursor: pointer;
  transition: all .25s ease;
  margin-bottom: 16px;
  background: #fcfcfc;
}
.vto-drop:hover, .vto-drop.dragover {
  border-color: #7c3aed;
  background: #faf8ff;
  transform: scale(1.01);
}
.vto-drop input[type="file"] {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}
.vto-drop__circle {
  width: 60px; height: 60px;
  margin: 0 auto 14px;
  background: linear-gradient(135deg, #f5f3ff, #fdf2f8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7c3aed;
  box-shadow: 0 4px 16px rgba(124,58,237,.08);
}
.vto-drop__label { margin: 0; font: 600 15px/1 var(--vto-ff); color: #222; }
.vto-drop__hint { margin: 6px 0 0; font: 400 12px/1 var(--vto-ff); color: #bbb; }
.vto-drop__preview img {
  max-height: 220px;
  border-radius: 12px;
  object-fit: contain;
}
.vto-drop__change {
  margin-top: 8px;
  background: none;
  border: none;
  color: var(--vto-primary);
  font: 500 13px/1 var(--vto-ff);
  cursor: pointer;
  text-decoration: underline;
}

/* ── CTA ── */
.vto-main-cta {
  width: 100%;
  padding: 16px;
  background: var(--vto-primary);
  color: var(--vto-primary-text);
  border: none;
  border-radius: var(--vto-r);
  font: 700 15px/1 var(--vto-ff);
  cursor: pointer;
  transition: all .2s cubic-bezier(.16,1,.3,1);
  position: relative;
  overflow: hidden;
  letter-spacing: 0.2px;
}
.vto-main-cta:disabled { opacity: .3; cursor: default; }
.vto-main-cta:not(:disabled):hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.15); }
.vto-main-cta:not(:disabled):active { transform: translateY(0); }
.vto-main-cta--sm { flex: 1.4; }
.vto-btn-ghost {
  flex: 1;
  padding: 14px;
  background: #f5f5f5;
  color: #333;
  border: none;
  border-radius: var(--vto-r);
  font: 600 14px/1 var(--vto-ff);
  cursor: pointer;
  transition: background .15s;
}
.vto-btn-ghost:hover { background: #eee; }
.vto-powered { text-align: center; padding: 12px 0 4px; font: 400 11px/1 var(--vto-ff); color: #bbb; letter-spacing: 0.3px; }
.vto-powered a { color: #888; text-decoration: none; font-weight: 600; }
.vto-powered a:hover { color: #555; }
.vto-privacy { text-align: center; margin: 10px 0 0; font: 400 11px/1.4 var(--vto-ff); color: #ccc; }

/* ── LOADING ── */
.vto-loading-wrap { text-align: center; padding: 36px 0 24px; position: relative; overflow: hidden; }
.vto-loader-bg {
  position: absolute; inset: -40px; z-index: 0;
  background: radial-gradient(circle at 30% 20%, rgba(124,58,237,.04) 0%, transparent 50%),
              radial-gradient(circle at 70% 80%, rgba(236,72,153,.04) 0%, transparent 50%);
  animation: vto-bgShift 4s ease infinite alternate;
}
@keyframes vto-bgShift { 0%{opacity:.5;transform:scale(1)} 100%{opacity:1;transform:scale(1.1)} }

.vto-loader-visual { position: relative; width: 100px; height: 100px; margin: 0 auto 24px; z-index: 1; }
.vto-loader-glow {
  position: absolute; inset: -10px;
  background: radial-gradient(circle, rgba(124,58,237,.15) 0%, transparent 70%);
  border-radius: 50%;
  animation: vto-glowPulse 2s ease infinite;
}
@keyframes vto-glowPulse { 0%,100%{transform:scale(.9);opacity:.4} 50%{transform:scale(1.2);opacity:.8} }

.vto-loader-ring { width: 100px; height: 100px; position: relative; }
.vto-loader-ring__inner {
  width: 100%; height: 100%;
  border: 3px solid rgba(124,58,237,.1);
  border-radius: 50%;
  border-top-color: #7c3aed;
  border-right-color: #a78bfa;
  border-bottom-color: #ec4899;
  animation: vto-spin .9s linear infinite;
  filter: drop-shadow(0 0 6px rgba(124,58,237,.3));
}
.vto-loader-icon {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  animation: vto-iconFloat 2s ease infinite;
}
@keyframes vto-iconFloat { 0%,100%{transform:translate(-50%,-50%) scale(1)} 50%{transform:translate(-50%,-55%) scale(1.08)} }

.vto-loader-particles { position: absolute; inset: 0; }
.vto-loader-particles span {
  position: absolute;
  width: 4px; height: 4px;
  background: #7c3aed;
  border-radius: 50%;
  top: 50%; left: 50%;
  animation: vto-particle 3s ease-in-out infinite;
  animation-delay: calc(var(--i) * 0.5s);
  opacity: 0;
}
@keyframes vto-particle {
  0% { transform: translate(0,0) scale(0); opacity: 0; }
  20% { opacity: .8; }
  100% { transform: translate(calc(cos(calc(var(--i)*60deg))*50px), calc(sin(calc(var(--i)*60deg))*50px)) scale(0); opacity: 0; }
}
.vto-loader-particles span:nth-child(2n) { background: #ec4899; width: 3px; height: 3px; }
.vto-loader-particles span:nth-child(3n) { background: #a78bfa; width: 5px; height: 5px; }

.vto-loading__title {
  margin: 0; position: relative; z-index: 1;
  font: 800 24px/1.2 var(--vto-ff); letter-spacing: -0.5px;
  background: linear-gradient(135deg, #7c3aed, #ec4899);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.vto-loading__sub { margin: 8px 0 0; font: 400 13px/1.4 var(--vto-ff); color: #aaa; position: relative; z-index: 1; }

.vto-progress { width: 65%; margin: 22px auto 0; height: 6px; background: rgba(124,58,237,.08); border-radius: 6px; overflow: hidden; position: relative; z-index: 1; }
.vto-progress__bar {
  width: 0%; height: 100%;
  background: linear-gradient(90deg, #7c3aed, #a78bfa, #ec4899);
  border-radius: 6px;
  animation: vto-load 30s ease-out forwards;
  position: relative;
}
.vto-progress__shimmer {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.4), transparent);
  animation: vto-shimmerBar 1.5s ease infinite;
}
@keyframes vto-shimmerBar { 0%{transform:translateX(-100%)} 100%{transform:translateX(100%)} }

.vto-loading-steps {
  display: flex; flex-direction: column; align-items: flex-start;
  gap: 12px; margin: 24px auto 0; width: fit-content;
  position: relative; z-index: 1;
}
.vto-lstep {
  display: flex; align-items: center; gap: 10px;
  font: 500 13px/1 var(--vto-ff); color: #d0d0d0;
  transition: all .5s cubic-bezier(.16,1,.3,1);
  transform: translateX(0);
}
.vto-lstep.active { color: #7c3aed; transform: translateX(4px); font-weight: 600; }
.vto-lstep.done { color: #10b981; }
.vto-lstep__icon { font-size: 15px; filter: grayscale(1) opacity(.3); transition: filter .5s; }
.vto-lstep.active .vto-lstep__icon { filter: none; animation: vto-iconBounce .6s ease; }
.vto-lstep.done .vto-lstep__icon { filter: none; }
@keyframes vto-iconBounce { 0%{transform:scale(0.5)} 50%{transform:scale(1.3)} 100%{transform:scale(1)} }

.vto-loading__time {
  margin: 20px 0 0; font: 400 11px/1 var(--vto-ff); color: #ccc;
  position: relative; z-index: 1; letter-spacing: 0.2px;
}

@keyframes vto-pulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:.6; transform:scale(1.15); } }

/* ── RESULT ── */
.vto-result-wrap { text-align: center; }
.vto-result__img-wrap {
  margin: 12px 0 20px;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 12px 40px rgba(0,0,0,.12);
  line-height: 0;
  position: relative;
}
.vto-result__img-wrap img { width: 100%; display: block; }
.vto-result__btns { display: flex; gap: 10px; }
.vto-disclaimer {
  text-align: center;
  margin: 14px 0 2px;
  font: 400 10.5px/1.5 var(--vto-ff);
  color: #bbb;
  padding: 0 8px;
}

/* ── ERROR ── */
.vto-error-wrap { text-align: center; padding: 40px 0; }
.vto-error__emoji { font-size: 48px; margin-bottom: 16px; }
.vto-error__title { margin: 0; font: 700 20px/1 var(--vto-ff); color: #111; }
.vto-error__msg { margin: 8px 0 24px; font: 400 14px/1.4 var(--vto-ff); color: #999; }

/* ── ANIMATIONS ── */
@keyframes vto-spin { to { transform: rotate(360deg); } }
@keyframes vto-fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes vto-scaleIn { from { opacity: 0; transform: scale(.88) translateY(16px); } to { opacity: 1; transform: scale(1) translateY(0); } }
@keyframes vto-slideUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes vto-shimmer { 0% { left: -100%; } 100% { left: 200%; } }
@keyframes vto-load { 0% { width: 0%; } 20% { width: 30%; } 50% { width: 55%; } 80% { width: 80%; } 100% { width: 96%; } }

@media (max-width: 480px) {
  .vto-modal { padding: 24px 20px; border-radius: 24px; }
  .vto-title { font-size: 22px; }
  .vto-result__btns { flex-direction: column; }
}
</style>

<script>
(function(){
  const w=document.getElementById('vto');
  if(!w)return;
  const D=w.dataset,$=id=>document.getElementById(id);
  const btn=$('vto-btn'),popup=$('vto-popup'),overlay=$('vto-overlay'),
    dropzone=$('vto-dropzone')||$('vto-file')?.parentElement,
    fileInput=$('vto-file'),submitBtn=$('vto-submit'),submitTxt=$('vto-submit-text'),
    prevImg=$('vto-preview-img'),dzEmpty=$('vto-dz-empty'),dzPreview=$('vto-dz-preview'),
    resultImg=$('vto-result-img'),errorMsg=$('vto-error-msg');
  const states={upload:$('vto-s-upload'),loading:$('vto-s-loading'),result:$('vto-s-result'),error:$('vto-s-error')};
  let file=null;
  const show=k=>Object.entries(states).forEach(([n,el])=>el.style.display=n===k?'block':'none');
  function openModal(){overlay.style.display='flex';document.body.style.overflow='hidden';show('upload');}
  function closeModal(){overlay.style.display='none';document.body.style.overflow='';reset();}
  function reset(){file=null;if(fileInput)fileInput.value='';if(dzEmpty)dzEmpty.style.display='block';if(dzPreview)dzPreview.style.display='none';if(submitBtn){submitBtn.disabled=true;submitTxt.textContent='Upload photo to try on';}}
  function handleFile(f){
    if(!f)return;
    if(f.size>10*1024*1024){alert('Photo must be under 10 MB');return;}
    if(!['image/jpeg','image/png','image/webp'].includes(f.type)){alert('Upload JPG, PNG or WebP');return;}
    file=f;
    const r=new FileReader();
    r.onload=e=>{prevImg.src=e.target.result;dzEmpty.style.display='none';dzPreview.style.display='block';submitBtn.disabled=false;submitTxt.textContent='Try it on →';};
    r.readAsDataURL(f);
  }
  btn.addEventListener('click',openModal);
  $('vto-popup-cta')?.addEventListener('click',openModal);
  $('vto-modal-close').addEventListener('click',closeModal);
  overlay.addEventListener('click',e=>{if(e.target===overlay)closeModal();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&overlay.style.display!=='none')closeModal();});
  $('vto-popup-close')?.addEventListener('click',e=>{e.stopPropagation();popup.style.display='none';sessionStorage.setItem('vto_dismissed','1');});
  if(!sessionStorage.getItem('vto_dismissed')){setTimeout(()=>{if(!overlay.style.display||overlay.style.display==='none')popup.style.display='block';},{{ block.settings.popup_delay }}000);}
  fileInput?.addEventListener('change',e=>handleFile(e.target.files[0]));
  $('vto-change-photo')?.addEventListener('click',e=>{e.stopPropagation();fileInput.click();});
  const dz=fileInput?.parentElement;
  if(dz){
    dz.addEventListener('dragover',e=>{e.preventDefault();dz.classList.add('dragover');});
    dz.addEventListener('dragleave',()=>dz.classList.remove('dragover'));
    dz.addEventListener('drop',e=>{e.preventDefault();dz.classList.remove('dragover');handleFile(e.dataTransfer.files[0]);});
  }
  submitBtn?.addEventListener('click',async()=>{
    if(!file)return;show('loading');startLoadingAnim();
    try{
      // Try AI server first
      const fd=new FormData();
      fd.append('shop',D.shop);fd.append('product_id',D.pid);fd.append('product_title',D.ptitle);fd.append('product_image_url',D.pimg);fd.append('user_photo',file);fd.append('category',D.category||'dresses');
      const res=await fetch('/apps/tryon',{method:'POST',body:fd});
      const data=await res.json();
      if(res.ok&&data.success&&data.result_url){
        resultImg.src=data.result_url;show('result');return;
      }
      throw new Error(data.error||'AI unavailable');
    }catch(err){
      // Fallback: client-side canvas compositing
      try{
        const userUrl=URL.createObjectURL(file);
        const canvas=document.createElement('canvas');
        canvas.width=600;canvas.height=800;
        const ctx=canvas.getContext('2d');
        const userImage=new Image();
        userImage.onload=()=>{
          ctx.drawImage(userImage,0,0,600,800);
          const prodImage=new Image();prodImage.crossOrigin='anonymous';
          prodImage.onload=()=>{
            const tmp=document.createElement('canvas');
            const tw=prodImage.naturalWidth,th=prodImage.naturalHeight;
            tmp.width=tw;tmp.height=th;const tc=tmp.getContext('2d');
            tc.drawImage(prodImage,0,0);
            const imgData=tc.getImageData(0,0,tw,th);const dd=imgData.data;
            for(let i=0;i<dd.length;i+=4){const br=(dd[i]+dd[i+1]+dd[i+2])/3;if(br>220&&Math.abs(dd[i]-dd[i+1])<25&&Math.abs(dd[i+1]-dd[i+2])<25)dd[i+3]=0;else if(br>200)dd[i+3]=Math.max(0,(255-br)*4);}
            tc.putImageData(imgData,0,0);
            const ratio=tw/th;let pw,ph,px,py;
            if(ratio>1.5){pw=300;ph=pw/ratio;px=(600-pw)/2;py=480;}
            else if(ratio>0.7){pw=240;ph=pw/ratio;px=(600-pw)/2;py=190;}
            else{pw=340;ph=pw/ratio;px=(600-pw)/2;py=200;}
            ctx.drawImage(tmp,px,py,pw,ph);
            ctx.fillStyle='rgba(16,185,129,0.9)';ctx.beginPath();ctx.roundRect(170,740,260,40,14);ctx.fill();
            ctx.fillStyle='#fff';ctx.font='600 14px Jost,sans-serif';ctx.textAlign='center';
            ctx.fillText('✨ Virtual Try-On by TryFit',300,766);
            resultImg.src=canvas.toDataURL('image/jpeg',0.92);show('result');
          };
          prodImage.onerror=()=>{errorMsg.textContent='Could not load product image';show('error');};
          prodImage.src=D.pimg;
        };
        userImage.src=userUrl;
      }catch(e2){errorMsg.textContent=e2.message||'Please try again.';show('error');}
    }
  });
  $('vto-retry')?.addEventListener('click',()=>{reset();show('upload');});
  $('vto-error-retry')?.addEventListener('click',()=>{reset();show('upload');});
  $('vto-addtocart')?.addEventListener('click',async()=>{
    const vid=document.querySelector('[name="id"]')?.value;
    try{if(vid){await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:vid,quantity:1})});}closeModal();window.location.href='/cart';}catch(e){window.location.href='/cart';}
  });

  let loadTimer=null;
  function startLoadingAnim(){
    const title=$('vto-loading-title'),sub=$('vto-loading-sub');
    const ls1=$('vto-ls1'),ls2=$('vto-ls2'),ls3=$('vto-ls3');
    const msgs=[
      {t:'Analyzing your photo...',s:'Detecting body shape & pose',step:1,ms:0},
      {t:'Understanding your body...',s:'Mapping proportions for perfect fit',step:1,ms:3000},
      {t:'Fitting the garment...',s:'Adjusting fabric drape & texture',step:2,ms:7000},
      {t:'Perfecting the details...',s:'Fine-tuning colors & shadows',step:2,ms:12000},
      {t:'Almost there...',s:'Adding final touches to your look',step:3,ms:18000},
      {t:'Putting it all together...',s:'Your personalized look is nearly ready',step:3,ms:24000},
    ];
    if(ls1){ls1.className='vto-lstep active';ls2.className='vto-lstep';ls3.className='vto-lstep';}
    const timers=[];
    msgs.forEach(m=>{
      timers.push(setTimeout(()=>{
        if(title)title.textContent=m.t;
        if(sub)sub.textContent=m.s;
        if(m.step>=2&&ls1){ls1.className='vto-lstep done';ls2.className='vto-lstep active';}
        if(m.step>=3&&ls2){ls2.className='vto-lstep done';ls3.className='vto-lstep active';}
      },m.ms));
    });
    loadTimer=timers;
  }
})();
</script>
{% endif %}

{% schema %}
{
  "name": "TryFit – Virtual Try-On",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Try On"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Corner Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Popup"
    },
    {
      "type": "text",
      "id": "popup_subtitle",
      "label": "Popup Subtitle",
      "default": "Upload a photo and try it instantly"
    },
    {
      "type": "range",
      "id": "popup_delay",
      "label": "Popup Delay",
      "min": 2,
      "max": 15,
      "step": 1,
      "default": 4,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Modal"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Modal Title",
      "default": "Try it before you buy"
    },
    {
      "type": "text",
      "id": "modal_subtitle",
      "label": "Modal Subtitle",
      "default": "Upload your photo and see this on you in seconds"
    },
    {
      "type": "header",
      "content": "AI Settings"
    },
    {
      "type": "select",
      "id": "garment_category",
      "label": "Garment Type",
      "default": "dresses",
      "info": "Upper body = tops/shirts. Lower body = pants/skirts. Full body = kurta sets, dresses, jumpsuits.",
      "options": [
        { "value": "upper_body", "label": "Upper Body (tops, shirts, jackets)" },
        { "value": "lower_body", "label": "Lower Body (pants, skirts)" },
        { "value": "dresses", "label": "Full Body (sets, dresses, jumpsuits)" }
      ]
    }
  ]
}
{% endschema %}
