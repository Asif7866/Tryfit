.vto-spin{width:44px;height:44px;border-radius:50%;background:conic-gradient(from 0deg,rgba(28,27,26,0) 0deg,var(--ink) 330deg);-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 4px),#000 calc(100% - 3px));mask:radial-gradient(farthest-side,transparent calc(100% - 4px),#000 calc(100% - 3px));animation:vR .9s linear infinite;}
.vto-spin--s{width:14px;height:14px;-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 2.5px),#000 calc(100% - 2px));mask:radial-gradient(farthest-side,transparent calc(100% - 2.5px),#000 calc(100% - 2px));}

/* STEP 2 */
.vto-pr{text-align:center;}
