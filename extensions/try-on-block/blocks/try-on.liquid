{%- assign vto_cfg = shop.metafields.tryfit.config.value -%}
{%- assign vto_disabled = false -%}
{%- if vto_cfg and vto_cfg.disabledProducts -%}
  {%- assign vto_pid_str = product.id | append: "" -%}
  {%- for d in vto_cfg.disabledProducts -%}
    {%- assign d_str = d | append: "" -%}
    {%- if d_str == vto_pid_str -%}{%- assign vto_disabled = true -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign vto_btn_text = block.settings.button_text -%}
{%- assign vto_btn_color = block.settings.button_color -%}
{%- assign vto_btn_text_color = block.settings.button_text_color -%}
{%- assign vto_btn_radius = block.settings.button_radius -%}
{%- if vto_cfg -%}
  {%- if vto_cfg.buttonText != blank -%}{%- assign vto_btn_text = vto_cfg.buttonText -%}{%- endif -%}
  {%- if vto_cfg.buttonColor != blank -%}{%- assign vto_btn_color = vto_cfg.buttonColor -%}{%- endif -%}
  {%- if vto_cfg.buttonTextColor != blank -%}{%- assign vto_btn_text_color = vto_cfg.buttonTextColor -%}{%- endif -%}
  {%- if vto_cfg.buttonRadius != blank -%}{%- assign vto_btn_radius = vto_cfg.buttonRadius -%}{%- endif -%}
{%- endif -%}
{%- assign vto_mode = block.settings.tryon_mode | default: "auto" -%}
{%- if product and vto_mode == "auto" or product and vto_mode == "fashion" -%}
  {%- assign p = product -%}
{%- assign t = p.title | append: " " | append: p.type | append: " " | append: p.vendor -%}
{%- assign tg = p.tags | join: " " -%}
{%- assign hay = t | append: " " | append: tg | downcase | replace: "-", " " | replace: "_", " " | replace: ",", " " | replace: "/", " " | replace: "|", " " | replace: "(", " " | replace: ")", " " | replace: ".", " " | replace: "&", " " -%}
{%- assign hay = " " | append: hay | append: " " -%}
{%- assign m = "" -%}
{%- comment -%} 1 · Jewelry worn on the neck / face → jewelry try-on {%- endcomment -%}
{%- assign jw = "necklace,neckpiece,neck piece,pendant,choker,mangalsutra,mangal sutra,locket, haar ,rani haar,kanthi,hasli,earring,ear ring, studs ,ear cuff,jhumka,jhumki,chandbali,bali ,tikka,maang tikka,mang tikka,matha patti,nose ring,nosering,nose pin,nosepin, nath ,jewellery set,jewelry set,bridal set,necklace set" | split: "," -%}
{%- for w in jw -%}{%- if hay contains w -%}{%- assign m = "j" -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- comment -%} 1b · Footwear → shoes try-on (unless it is clearly a garment, e.g. "bootcut jeans") {%- endcomment -%}
{%- if m == "" -%}
  {%- assign sw = "shoe,sneaker,trainer,heels, heel ,stiletto,pumps,wedges,sandal,slipper,flip flop,flipflop, slides ,loafer,moccasin, boot , boots ,chelsea,oxford shoe,derby,brogue,mojari,jutti,juttis,kolhapuri,chappal,footwear, flats ,ballerina,mules,espadrille,clogs,crocs" | split: "," -%}
  {%- for w in sw -%}{%- if hay contains w -%}{%- assign m = "s" -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- if m == "s" -%}
    {%- assign gw = "blouse,kurta,kurti,dress,gown,saree,sari,lehenga,top ,shirt,t shirt,tshirt,jacket,coat,blazer,skirt,trouser,pants,jeans,jumpsuit,co ord,anarkali,sharara,palazzo,dupatta,suit " | split: "," -%}
    {%- for w in gw -%}{%- if hay contains w -%}{%- assign m = "" -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- endif -%}
{%- endif -%}
{%- comment -%} 2 · Other jewelry & accessories (rings, bangles, anklets, watches…) → no try-on {%- endcomment -%}
{%- if m == "" -%}
  {%- assign no = " ring , rings ,finger ring,toe ring,bracelet,bangle, kada , kangan,anklet,payal,pajeb,brooch,cufflink,cuff link,hair clip,hairclip,hair pin,waist chain,kamarbandh,armlet,bajuband, watch , watches ,smartwatch" | split: "," -%}
  {%- for w in no -%}{%- if hay contains w -%}{%- assign m = "0" -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- if m == "0" -%}
  {%- assign gw = "blouse,kurta,kurti,dress,gown,saree,sari,lehenga,top ,shirt,t shirt,tshirt,jacket,coat,blazer,skirt,trouser,pants,jeans,jumpsuit,co ord,anarkali,sharara,palazzo,dupatta,suit " | split: "," -%}
  {%- for w in gw -%}{%- if hay contains w -%}{%- assign m = "" -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- comment -%} 3 · Home decor → room placement {%- endcomment -%}
{%- if m == "" -%}
  {%- assign hw = "bedsheet,bed sheet,bedding,comforter,duvet,quilt,dohar,blanket, throw ,pillow,cushion,curtain,drape,rug ,carpet,doormat,table cloth,tablecloth,table runner,wall art,painting,photo frame,poster,tapestry,sofa cover,mattress" | split: "," -%}
  {%- for w in hw -%}{%- if hay contains w -%}{%- assign m = "h" -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- if m == "" -%}{%- assign m = "f" -%}{%- endif -%}
  {%- assign vto_m = m -%}
  {%- case vto_m -%}
    {%- when "j" -%}{%- assign vto_mode = "jewelry" -%}
    {%- when "h" -%}{%- assign vto_mode = "home" -%}
    {%- when "s" -%}{%- assign vto_mode = "shoes" -%}
    {%- when "0" -%}{%- assign vto_mode = "fashion" -%}{%- assign vto_disabled = true -%}
    {%- else -%}{%- assign vto_mode = "fashion" -%}
  {%- endcase -%}
{%- endif -%}
{% if product and vto_disabled == false %}
<!--
  ┌──────────────────────────────────────────────────────────────┐
  │  TryFit — AI Virtual Try-On for Shopify                      │
  │  Shoppers see outfits on themselves, or decor in their room. │
  │  Built by FutureTechiez · https://futuretechiez.in           │
  │  Get it for your store → https://apps.shopify.com/partners/futuretechiez │
  └──────────────────────────────────────────────────────────────┘
-->
{%- assign vto_btn_label = vto_btn_text -%}
{%- case vto_mode -%}
  {%- when "home" -%}{%- assign vto_btn_label = block.settings.button_text_home | default: "SEE IN MY ROOM" -%}
  {%- when "jewelry" -%}{%- assign vto_btn_label = block.settings.button_text_jewelry | default: "SEE IT ON YOU" -%}
  {%- when "shoes" -%}{%- assign vto_btn_label = block.settings.button_text_shoes | default: "TRY THESE ON" -%}
{%- endcase -%}
<div
  id="vto"
  data-app="TryFit by FutureTechiez"
  data-app-url="https://futuretechiez.in"
  data-pid="{{ product.id }}"
  data-ptitle="{{ product.title | escape }}"
  data-pimg="{{ product.featured_image | image_url: width: 1024 }}"
  data-purl="{{ shop.url }}{{ product.url }}"
  data-shop="{{ shop.permanent_domain }}"
  data-category="{{ block.settings.garment_category }}"
  data-mode="{{ vto_mode }}"
  data-mode-src="{{ block.settings.tryon_mode | default: 'auto' }}:{{ vto_m }}"
  data-vid="{{ product.selected_or_first_available_variant.id }}"
  data-cart-type="{{ settings.cart_type | default: '' }}"
>
  <button id="vto-btn" class="vto-btn" type="button">
    {%- case vto_mode -%}
    {%- when "home" -%}<svg class="vto-btn__icon" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5.5v14M21 19.5V14a2.5 2.5 0 0 0-2.5-2.5H3"/><path d="M3 16.2h18"/><rect x="5.2" y="8.2" width="5" height="3.3" rx="1.2"/></svg>
    {%- when "jewelry" -%}<svg class="vto-btn__icon" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3.5c.4 5.2 3.3 8.6 7 8.6s6.6-3.4 7-8.6"/><path d="M12 12.1v1.4"/><path d="M12 13.5l2.3 2.9L12 20.5l-2.3-4.1z"/></svg>
    {%- when "shoes" -%}<svg class="vto-btn__icon" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 16.5V9.3c0-.6.5-1 1.1-.9l2.8.6c.5.1.9.5 1 1l.3 1.2c.2.7.9 1.1 1.6 1l1.8-.3 3.5 2.2c.4.3.9.4 1.4.4h3.3c1 0 1.7.8 1.7 1.7v.3H2.5z"/><path d="M2.5 16.5h19v1a1.5 1.5 0 0 1-1.5 1.5H4a1.5 1.5 0 0 1-1.5-1.5z"/><path d="M9.8 12.4l.9-1.4M12.3 13.7l.9-1.4"/></svg>
    {%- else -%}<svg class="vto-btn__icon" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8.6 3.8 4.3 5.7 2.6 10.2l3.1 1.2v8.8h12.6v-8.8l3.1-1.2-1.7-4.5-4.3-1.9c-.5 1.5-1.9 2.5-3.4 2.5s-2.9-1-3.4-2.5z"/></svg>
    {%- endcase -%}
    <span>{{ vto_btn_label }}</span>
  </button>

  <script>window.vtoImgErr=window.vtoImgErr||function(i){var k=+(i.dataset.r||0);if(k>4)return;i.dataset.r=k+1;var fb=i.dataset.fb;if(k===0&&fb){i.src=fb;return;}setTimeout(function(){i.src=(fb||i.src).split('?')[0]+'?r='+k;},5000*k);};</script>
  <!-- ═══ DRAWER ═══ -->
  <div id="vto-modal" class="vto-overlay" style="display:none;" role="dialog" aria-modal="true" aria-label="{% if vto_mode == 'home' %}See it in your room{% else %}Virtual try-on{% endif %}">
    <div class="vto-frame">
    <div class="vto-card" id="vto-card">
      <div class="vto-head">
        <span class="vto-head__t"><svg class="vto-head__i" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9z"/><path d="M19 15l.8 2.2 2.2.8-2.2.8L19 21l-.8-2.2-2.2-.8 2.2-.8z"/></svg><span>{% if vto_mode == "home" %}See it in your room{% else %}Virtual Try-On{% endif %}</span></span>
        <button id="vto-close" class="vto-x" type="button" aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
      </div>

      <!-- STEP 1 · UPLOAD -->
      <div id="vto-s-upload" class="vto-s vto-up">
        <div class="vto-up__in" id="vto-dropzone">
          <span class="vto-chip"><i class="on"></i><i></i>Step 1 of 2</span>
          <h2 class="vto-h" id="vto-subtitle">{% if vto_mode == "home" %}Let's style your space{% elsif vto_mode == "shoes" %}Let's see them on you{% else %}Let's see it on you{% endif %}</h2>

          <div class="vto-fan" id="vto-fan">
            {%- if vto_mode == "home" -%}
            <figure class="vto-fan__c vto-fan__c--l"><span class="vto-mk vto-mk--x"></span>
              <img src="{{ 'tf-guide-closeup.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/closeup" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" /></figure>
            <figure class="vto-fan__c vto-fan__c--c"><span class="vto-mk vto-mk--ok"></span>
              <img src="{{ 'tf-guide-room.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/room" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" />
              <span class="vto-fan__tag">WIDE SHOT</span></figure>
            <figure class="vto-fan__c vto-fan__c--r"><span class="vto-mk vto-mk--x"></span>
              <img src="{{ 'tf-guide-dark.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/dark" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" /></figure>
            {%- elsif vto_mode == "jewelry" -%}
            <figure class="vto-fan__c vto-fan__c--l"><span class="vto-mk vto-mk--x"></span>
              <img src="{{ 'tf-guide-jfar.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/jfar" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" /></figure>
            <figure class="vto-fan__c vto-fan__c--c"><span class="vto-mk vto-mk--ok"></span>
              <img src="{{ 'tf-guide-jportrait.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/jportrait" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" />
              <span class="vto-fan__tag">SHOULDERS UP</span></figure>
            <figure class="vto-fan__c vto-fan__c--r"><span class="vto-mk vto-mk--x"></span>
              <img src="{{ 'tf-guide-jcovered.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/jcovered" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" /></figure>
            {%- elsif vto_mode == "shoes" -%}
            <figure class="vto-fan__c vto-fan__c--l"><span class="vto-mk vto-mk--x"></span>
              <img src="{{ 'tf-guide-selfie.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/selfie" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" /></figure>
            <figure class="vto-fan__c vto-fan__c--c"><span class="vto-mk vto-mk--ok"></span>
              <img src="{{ 'tf-guide-sfull.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/sfull" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" />
              <span class="vto-fan__tag">BOTH FEET</span></figure>
            <figure class="vto-fan__c vto-fan__c--r"><span class="vto-mk vto-mk--x"></span>
              <img src="{{ 'tf-guide-scrop.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/scrop" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" /></figure>
            {%- else -%}
            <figure class="vto-fan__c vto-fan__c--l"><span class="vto-mk vto-mk--x"></span>
              <img src="{{ 'tf-guide-group.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/group" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" /></figure>
            <figure class="vto-fan__c vto-fan__c--c"><span class="vto-mk vto-mk--ok"></span>
              <img src="{{ 'tf-guide-full.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/full" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" />
              <span class="vto-fan__tag">HEAD TO TOE</span></figure>
            <figure class="vto-fan__c vto-fan__c--r"><span class="vto-mk vto-mk--x"></span>
              <img src="{{ 'tf-guide-selfie.jpg' | asset_url }}" data-fb="https://tryfit-production.up.railway.app/guide/selfie" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-in')" onerror="vtoImgErr(this)" /></figure>
            {%- endif -%}
          </div>

          <div id="vto-qr" class="vto-qr" style="display:none;">
            <div class="vto-qr__box"><img id="vto-qr-img" alt="QR code" width="180" height="180" /></div>
            <p class="vto-qr__t">Point your phone camera here</p>
            <p class="vto-qr__st" id="vto-qr-st"><i></i><span>Take a photo on your phone — your look appears right here</span></p>
          </div>

          <p class="vto-tip" id="vto-tip">{% if vto_mode == "home" %}Step back and capture the whole bed or wall.<br><span>Good daylight, no close-ups.</span>{% elsif vto_mode == "shoes" %}Stand on a plain floor, both feet in frame.<br><span>Keep them sharp — don't crop at the ankles.</span>{% elsif vto_mode == "jewelry" %}Face the camera, shoulders up.<br><span>Hair back so your neck and ears show.</span>{% else %}Stand tall, head to toe in frame.<br><span>Just you, facing the camera.</span>{% endif %}</p>

          <label class="vto-cta" for="vto-file">
            <input type="file" id="vto-file" accept="image/jpeg,image/png,image/webp" title="" aria-label="Upload your photo" />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.5V18a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h6.5"/><path d="m3.5 17 4.6-4.6a1.8 1.8 0 0 1 2.5 0L16 17.8"/><path d="m14 15.5 1.6-1.6a1.8 1.8 0 0 1 2.5 0L21 16.8"/><path d="M18.5 2.5v6M15.5 5.5h6"/></svg>
            <span>{% if vto_mode == "home" %}Upload a room photo{% else %}Upload your photo{% endif %}</span>
          </label>
          <button id="vto-qr-btn" class="vto-ghost" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="3"/><path d="M10.5 18.5h3"/></svg>
            <span id="vto-qr-lbl">Use my phone instead</span>
          </button>

          <div id="vto-prev-wrap" class="vto-prev" style="display:none;">
            <p class="vto-prev__label">Your recent looks</p>
            <div id="vto-prev-grid" class="vto-prev__grid"></div>
          </div>
          <p class="vto-priv"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg> Private · your photo is deleted after the preview</p>
        </div>
        <div class="vto-uploading" id="vto-uploading"><strong>Getting your photo ready…</strong><span class="vto-shim"><i></i></span></div>
      </div>

      <!-- STEP 2 · PROCESSING -->
      <div id="vto-s-proc" class="vto-s vto-pr" style="display:none;">
        <span class="vto-chip"><i class="on"></i><i class="on"></i>Step 2 of 2</span>
        <h2 class="vto-h">{% if vto_mode == "home" %}Dressing up your room…{% elsif vto_mode == "jewelry" %}Adorning your look…{% elsif vto_mode == "shoes" %}Fitting your pair…{% else %}Styling your look…{% endif %}</h2>
        <div class="vto-stage">
          <div class="vto-stage__u"><img id="vto-proc-u" alt="" /><div class="vto-scan"></div><div class="vto-stage__glow"></div></div>
          <div class="vto-stage__p"><img id="vto-proc-p" src="{{ product.featured_image | image_url: width: 300 }}" alt="" /></div>
        </div>
        <div class="vto-prog"><div id="vto-prog-bar" class="vto-prog__bar"></div></div>
        <p class="vto-pct"><b id="vto-pct">0%</b><span class="vto-pct__dot">·</span><span id="vto-stat">Reading your photo</span></p>
        <ul class="vto-steps" id="vto-steps">
          {%- if vto_mode == "home" -%}
          <li><i></i><span>Reading your room photo</span></li>
          <li><i></i><span>Studying the product</span></li>
          <li><i></i><span>Placing it in your room</span></li>
          <li><i></i><span>Matching light &amp; perspective</span></li>
          <li><i></i><span>Final touches</span></li>
          {%- elsif vto_mode == "jewelry" -%}
          <li><i></i><span>Reading your photo</span></li>
          <li><i></i><span>Studying the design &amp; stones</span></li>
          <li><i></i><span>Placing it on you</span></li>
          <li><i></i><span>Matching shine &amp; shadows</span></li>
          <li><i></i><span>Final touches</span></li>
          {%- else -%}
          <li><i></i><span>Reading your photo</span></li>
          <li><i></i><span>Analysing the garment</span></li>
          <li><i></i><span>Fitting it on you</span></li>
          <li><i></i><span>Matching light &amp; shadows</span></li>
          <li><i></i><span>Final touches</span></li>
          {%- endif -%}
        </ul>
        <p class="vto-note">This is an AI preview — real colour and drape can differ a little.</p>
        <p class="vto-time"><span id="vto-timer">0 sec</span> · usually 15–30 sec</p>
        <button id="vto-to-mini" class="vto-link" type="button">Keep browsing — we'll bring it back ›</button>
      </div>

      <!-- RESULT -->
      <div id="vto-s-result" class="vto-s vto-rs" style="display:none;">
        <div class="vto-rs__pic" id="vto-res-wrap"><img id="vto-res-img" alt="Your try-on result" /></div>
        <button id="vto-fs" class="vto-rs__fs" type="button" aria-label="View full screen"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></button>
        <div class="vto-rs__bot">
          <div class="vto-rs__row">
            <button id="vto-pchip" class="vto-pchip" type="button" aria-label="{{ product.title | escape }}">
              <img src="{{ product.featured_image | image_url: width: 160 }}" alt="" />
              <span class="vto-pchip__t">{{ product.title }}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
            </button>
            <div class="vto-fb" id="vto-fb">
              <span id="vto-fb-t">Happy with it?</span><i></i>
              <button type="button" data-v="up" aria-label="Looks right"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M7 10v11H3V10zM7 10l4-7c1.7 0 2.7 1.3 2.3 3L12.6 9H19a2 2 0 0 1 2 2.3l-1.2 7.4A2.6 2.6 0 0 1 17.2 21H7"/></svg></button>
              <button type="button" data-v="down" aria-label="Doesn't look right"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" style="transform:rotate(180deg)"><path d="M7 10v11H3V10zM7 10l4-7c1.7 0 2.7 1.3 2.3 3L12.6 9H19a2 2 0 0 1 2 2.3l-1.2 7.4A2.6 2.6 0 0 1 17.2 21H7"/></svg></button>
            </div>
          </div>
          <div class="vto-rs__acts">
            <button id="vto-buy" class="vto-atc" type="button">Add to Cart</button>
            <button id="vto-wa" class="vto-ic" type="button" aria-label="Share on WhatsApp"><svg width="22" height="22" viewBox="0 0 24 24"><path fill="#25D366" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/><path fill="#fff" d="M17.3 14.6c-.3-.1-1.7-.8-1.9-.9-.3-.1-.5-.1-.7.1l-.9 1.1c-.2.2-.3.2-.6.1-1.6-.8-2.7-1.5-3.8-3.3-.3-.5.3-.4.8-1.4.1-.2 0-.3 0-.5l-.9-2.1c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 1.8.8 2.6.8 3.5.7.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"/></svg></button>
            <button id="vto-share" class="vto-ic" type="button" aria-label="Share"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="M8.3 10.8l7.4-4.4M8.3 13.2l7.4 4.4"/></svg></button>
          </div>
          <div class="vto-rs__more"><button id="vto-regen" type="button">Try another photo</button><span>·</span><button id="vto-dl" type="button">Download</button></div>
        </div>
        <div class="vto-toast" id="vto-toast"></div>
      </div>

      <!-- ERROR -->
      <div id="vto-s-error" class="vto-s" style="display:none;">
        <div class="vto-err">
          <p class="vto-err__icon" id="vto-err-icon">😔</p>
          <h3 id="vto-err-title">Something went wrong</h3>
          <p id="vto-err-msg"></p>
          <button id="vto-err-retry" class="vto-cta vto-cta--btn" type="button">Try Again</button>
        </div>
      </div>
    </div>
    </div>
  </div>

  <!-- ═══ MINIBAR ═══ -->
  <div id="vto-mini" class="vto-mini" style="display:none;">
    <div class="vto-mini__thumbs">
      <img id="vto-m-p" src="{{ product.featured_image | image_url: width: 120 }}" alt="" />
      <div class="vto-mini__sp"><span class="vto-spin vto-spin--s"></span></div>
      <img id="vto-m-u" alt="" />
    </div>
    <div class="vto-mini__body">
      <strong id="vto-m-status">Starting your try-on</strong>
      <span id="vto-m-time">0 sec · You can keep browsing</span>
    </div>
    <button id="vto-m-expand" class="vto-mini__arrow" type="button" aria-label="Expand">›</button>
  </div>

  <!-- ═══ ZOOM ═══ -->
  <div id="vto-zoom" class="vto-zoom" style="display:none;">
    <div class="vto-zoom__in">
      <img id="vto-z-img" alt="Your try-on result, full size" />
      <button id="vto-z-close" class="vto-zoom__x" type="button" aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    </div>
  </div>
</div>

<style>
#vto,.vto-root{--vf:"Urbanist",-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;--vr:{{ vto_btn_radius }}px;--vc:{{ vto_btn_color }};--vt:{{ vto_btn_text_color }};--ink:#1e1c2e;--ink2:#2f2b52;--mute:#8b89a0;--line:#ecebea;--ease:cubic-bezier(.22,1,.36,1);--spring:cubic-bezier(.34,1.3,.5,1);}
#vto,#vto *,.vto-root,.vto-root *{box-sizing:border-box;}
.vto-root,.vto-root button,.vto-root input,.vto-root label,.vto-root h2,.vto-root h3,.vto-root p,.vto-root span,.vto-root strong,.vto-root a{font-family:var(--vf);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-transform:none;letter-spacing:normal;}
.vto-root button{-webkit-tap-highlight-color:transparent;}
.vto-root button:focus:not(:focus-visible){outline:none;}
.vto-root :focus-visible{outline:2px solid var(--ink);outline-offset:2px;}

/* ── PDP button (keeps the theme's own font) ── */
.vto-btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:52px;padding:14px 24px;margin-top:10px;background:var(--vc);color:var(--vt);border:none;border-radius:var(--vr);font-family:inherit;font-size:inherit;font-weight:500;letter-spacing:inherit;line-height:1;cursor:pointer;transition:transform .35s var(--ease),box-shadow .35s var(--ease),filter .35s;}
.vto-btn:hover{filter:brightness(1.06);}
.vto-btn:active{transform:scale(.99);}
.vto-btn__icon{flex-shrink:0;width:21px;height:21px;}

/* ── Drawer shell ── */
.vto-overlay{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:flex-end;padding:20px 28px;background:rgba(250,249,248,.0);transition:background .5s var(--ease);}
.vto-overlay.is-in{background:rgba(250,249,248,.28);}
.vto-frame{position:relative;width:368px;max-width:100%;max-height:calc(100vh - 40px);max-height:calc(100dvh - 40px);display:flex;padding:1.5px;border-radius:32px;
  background:linear-gradient(205deg,#e4e2f5 0%,#c9c5ec 48%,#aaa4dc 100%);
  box-shadow:0 24px 60px -28px rgba(40,30,20,.22);
  opacity:0;transform:translateX(36px) scale(.97);transition:opacity .45s var(--ease),transform .6s var(--spring),height .5s var(--ease);}
.vto-overlay.is-in .vto-frame{opacity:1;transform:none;}
.vto-overlay.is-out .vto-frame{opacity:0;transform:translateX(28px) scale(.98);transition:opacity .25s ease,transform .3s var(--ease);}
.vto-overlay.is-out{background:rgba(250,249,248,0);}
.vto-frame.is-tall{height:min(640px,calc(100vh - 40px));height:min(640px,calc(100dvh - 40px));}
.vto-card{position:relative;width:100%;max-height:inherit;border-radius:30.5px;background:#fff;overflow:hidden;display:flex;flex-direction:column;color:var(--ink);}
.vto-frame.is-tall .vto-card{height:100%;}
.vto-head{position:relative;z-index:5;flex-shrink:0;display:flex;align-items:center;justify-content:center;height:52px;padding:0 60px;transition:color .4s;}
.vto-head__t{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:600;letter-spacing:.01em!important;color:var(--ink);text-transform:none!important;}
.vto-head__i{flex-shrink:0;color:#6d5efc;}
.vto-card.is-result .vto-head__i{color:#fff;}
.vto-x{position:absolute;right:18px;top:50%;width:36px;height:36px;margin-top:-18px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;border-radius:50%;color:var(--ink);cursor:pointer;transition:background .25s,transform .35s var(--ease),color .4s;}
.vto-x:hover{background:rgba(0,0,0,.05);transform:rotate(90deg);}
.vto-s{flex:1 1 auto;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;scrollbar-width:none;padding:0 24px 16px;}
.vto-s::-webkit-scrollbar{display:none;}
.vto-chip{display:inline-flex;align-items:center;gap:4px;padding:5px 11px 5px 9px;border-radius:999px;background:#f3f2fa;color:#5b5880;font-size:11px;font-weight:600;letter-spacing:.02em!important;line-height:1;text-transform:none!important;}
.vto-chip i{width:14px;height:4px;border-radius:2px;background:#d9d6ec;}
.vto-chip i.on{background:#6d5efc;}
.vto-chip i:nth-of-type(2){margin-right:4px;}
.vto-h{margin:10px 0 0;font-size:24px;font-weight:400;line-height:1.18;letter-spacing:-.015em!important;color:var(--ink);}

/* ── Step 1 ── */
.vto-up{position:relative;padding:0;}
.vto-up__in{display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 24px 14px;transition:filter .5s var(--ease),opacity .5s var(--ease),transform .5s var(--ease);}
.vto-fan{position:relative;width:100%;height:178px;margin:16px 0 12px;}
.vto-fan__c{position:absolute;top:50%;left:50%;margin:0;width:92px;height:124px;border-radius:12px;overflow:hidden;background:linear-gradient(140deg,#f1eee9,#e4dfd8);box-shadow:0 6px 16px -10px rgba(30,20,10,.22);}
.vto-fan__c img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;opacity:0;transform:scale(1.03);transition:opacity .3s ease,transform .6s var(--ease);}
.vto-fan__c img.is-in{opacity:1;transform:none;}
.vto-fan__c--l{transform:translate(-108%,-45%) rotate(-5deg);}
.vto-fan__c--r{transform:translate(8%,-45%) rotate(5deg);}
.vto-fan__c--c{z-index:2;width:116px;height:160px;border-radius:14px;transform:translate(-50%,-50%);box-shadow:0 10px 24px -14px rgba(30,20,10,.3);}
.vto-mk{position:absolute;top:7px;left:7px;z-index:2;width:19px;height:19px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid #fff;}
.vto-fan__c--r .vto-mk{left:auto;right:7px;}
.vto-mk--ok{background:#4caf72;}
.vto-mk--ok::after{content:"";width:5px;height:9px;border:solid #fff;border-width:0 2px 2px 0;transform:translateY(-1px) rotate(45deg);}
.vto-mk--x{background:#e2574f;}
.vto-mk--x::before,.vto-mk--x::after{content:"";position:absolute;width:9px;height:2px;background:#fff;border-radius:2px;transform:rotate(45deg);}
.vto-mk--x::after{transform:rotate(-45deg);}
.vto-fan__tag{position:absolute;left:7px;bottom:7px;max-width:calc(100% - 14px);overflow:hidden;text-overflow:ellipsis;padding:4px 8px;border-radius:999px;background:rgba(36,33,62,.82);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);color:#fff;font-size:7.5px;white-space:nowrap;font-weight:700;letter-spacing:.08em!important;text-transform:uppercase!important;}
.vto-tip{margin:0 0 14px;font-size:13.5px;line-height:1.45;color:var(--mute);max-width:300px;}
.vto-tip span{color:#adabc0;}
.vto-cta{position:relative;display:flex;align-items:center;justify-content:center;gap:11px;width:100%;height:48px;border-radius:13px;background:var(--ink2);color:#fff;font-size:16px;font-weight:500;cursor:pointer;border:none;overflow:hidden;transition:transform .35s var(--ease),background .3s,box-shadow .35s var(--ease);}
.vto-cta:hover{background:#3a3566;}
.vto-cta:active{transform:scale(.985);}
.vto-cta input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;font-size:0;}
.vto-cta svg{width:19px;height:19px;}
.vto-ghost{display:flex;align-items:center;justify-content:center;gap:11px;width:100%;height:40px;margin-top:4px;border:none;background:transparent;color:var(--ink);font-size:15px;font-weight:500;cursor:pointer;border-radius:14px;transition:background .3s;}
.vto-ghost:hover{background:#f4f3f9;}
.vto-ghost svg{width:18px;height:18px;}
.vto-qr{display:flex;flex-direction:column;align-items:center;margin:16px 0 4px;}
.vto-qr__box{padding:14px;border-radius:20px;background:#fff;box-shadow:0 0 0 1px var(--line);}
.vto-qr__box{padding:12px!important;}
.vto-qr__box img{display:block;width:150px;height:150px;}
.vto-qr__t{margin:14px 0 6px;font-size:16px;font-weight:600;color:var(--ink);}
.vto-qr__st{display:flex;align-items:center;justify-content:center;gap:8px;margin:0 0 14px;font-size:13px;line-height:1.4;color:var(--mute);max-width:280px;}
.vto-qr__st i{width:7px;height:7px;border-radius:50%;background:#c9c5c2;flex-shrink:0;}
.vto-qr__st.is-live{color:var(--ink);}
.vto-qr__st.is-live i{background:#4caf72;box-shadow:0 0 0 0 rgba(76,175,114,.5);animation:vPing 1.4s ease-out infinite;}
@keyframes vPing{to{box-shadow:0 0 0 8px rgba(76,175,114,0)}}
.vto-priv{display:flex;align-items:center;justify-content:center;gap:5px;margin:8px 0 0;font-size:11px;color:#adabbf;}
.vto-prev{width:100%;margin-top:14px;text-align:left;}
.vto-prev__label{font-size:12px;font-weight:600;color:var(--mute);margin:0 0 8px;}
.vto-prev__grid{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none;}
.vto-prev__grid img{width:54px;height:72px;border-radius:10px;object-fit:cover;cursor:pointer;border:2px solid transparent;transition:border-color .25s,transform .35s var(--ease);}
.vto-prev__grid img:hover{border-color:var(--ink);transform:translateY(-2px);}
.vto-uploading{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;z-index:3;opacity:0;pointer-events:none;transition:opacity .4s var(--ease);}
.vto-uploading strong{font-size:17px;font-weight:600;color:var(--ink);}
.vto-shim{display:block;width:150px;height:4px;border-radius:9px;background:#e6e4f1;overflow:hidden;}
.vto-shim i{display:block;width:40%;height:100%;border-radius:9px;background:var(--ink);animation:vShim 1.1s ease-in-out infinite;}
@keyframes vShim{0%{transform:translateX(-110%)}100%{transform:translateX(260%)}}
.vto-up.is-busy .vto-up__in{filter:blur(2px) grayscale(.3);opacity:.22;transform:scale(.99);pointer-events:none;}
.vto-up.is-busy .vto-uploading{opacity:1;}
.vto-spin{position:relative;width:46px;height:46px;}
.vto-spin::before{content:"";position:absolute;inset:0;background:repeating-conic-gradient(from 0deg,var(--ink) 0 6deg,transparent 6deg 30deg);-webkit-mask:radial-gradient(circle,transparent 52%,#000 53%,#000 100%);mask:radial-gradient(circle,transparent 52%,#000 53%,#000 100%);border-radius:50%;animation:vTick 1s steps(12) infinite;}
.vto-spin--s{width:14px;height:14px;}
.vto-spin--s::before{background:conic-gradient(from 0deg,transparent,var(--ink));-webkit-mask:radial-gradient(circle,transparent 55%,#000 56%);mask:radial-gradient(circle,transparent 55%,#000 56%);animation:vR .9s linear infinite;}

/* ── Step 2 ── */
.vto-pr{text-align:center;}
.vto-stage{position:relative;width:168px;margin:16px auto 22px;}
.vto-stage__u{position:relative;width:168px;aspect-ratio:3/4;border-radius:18px;overflow:hidden;background:#f1f0f7;box-shadow:0 10px 26px -16px rgba(30,20,10,.35);}
.vto-stage__u img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;filter:saturate(.85);animation:vBreath 3.4s ease-in-out infinite;}
.vto-stage__glow{position:absolute;inset:0;border-radius:18px;box-shadow:inset 0 0 0 2px rgba(255,255,255,.55);pointer-events:none;}
.vto-stage__p{position:absolute;right:-22px;bottom:-14px;width:62px;aspect-ratio:3/4;border-radius:12px;overflow:hidden;border:3px solid #fff;box-shadow:0 8px 18px -10px rgba(0,0,0,.4);transform:rotate(6deg);animation:vSt .6s var(--ease) .3s both;}
.vto-stage__p img{width:100%;height:100%;object-fit:cover;display:block;}
.vto-scan{position:absolute;left:0;right:0;top:-40%;height:40%;pointer-events:none;background:linear-gradient(to bottom,rgba(255,255,255,0),rgba(255,255,255,.55) 55%,rgba(255,255,255,0));animation:vScan 2.6s cubic-bezier(.45,0,.55,1) infinite;}
.vto-prog{position:relative;height:7px;border-radius:999px;background:#dcdaeb;overflow:hidden;margin:0 auto;max-width:300px;}
.vto-prog__bar{height:100%;width:0;border-radius:999px;background:var(--ink);transition:width .9s var(--ease);}
.vto-prog__bar::after{content:"";display:block;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.28),transparent);animation:vShine 1.8s ease-in-out infinite;}
.vto-pct{display:flex;align-items:center;justify-content:center;gap:6px;margin:10px 0 14px;font-size:13.5px;color:var(--mute);}
.vto-pct b{font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums;min-width:30px;text-align:right;}
.vto-pct__dot{opacity:.5}
#vto-stat{transition:opacity .3s}
.vto-note{margin:0 auto 4px;max-width:280px;font-size:13.5px;line-height:1.45;color:var(--ink);}
.vto-steps,.vto-time,.vto-pr .vto-link{display:none!important;}
.vto-pr .vto-wm{margin-top:14px;}

/* ── Result ── */
.vto-card.is-result .vto-head{position:absolute;top:0;left:0;right:0;height:70px;background:linear-gradient(to bottom,rgba(0,0,0,.32),rgba(0,0,0,0));}
.vto-card.is-result .vto-head__t,.vto-card.is-result .vto-x{color:#fff;}
.vto-card.is-result .vto-x:hover{background:rgba(255,255,255,.14);}
.vto-rs{position:absolute;inset:0;padding:0;overflow:hidden;}
.vto-rs__pic{position:absolute;inset:0;cursor:zoom-in;background:#e9e4dd;}
.vto-rs__pic img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;animation:vReveal 1.1s var(--ease) both;}
.vto-rs__fs{position:absolute;top:70px;right:20px;z-index:4;width:46px;height:46px;border:none;border-radius:50%;background:rgba(36,33,62,.6);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);transition:background .25s,transform .35s var(--ease);animation:vSt .6s var(--ease) .35s both;}
.vto-rs__fs:hover{background:rgba(36,33,62,.8);transform:scale(1.05);}
.vto-rs__bot{position:absolute;left:0;right:0;bottom:0;z-index:4;padding:80px 20px 12px;background:linear-gradient(to top,rgba(0,0,0,.45),rgba(0,0,0,.18) 60%,rgba(0,0,0,0));}
.vto-rs__bot>*{animation:vSt .65s var(--ease) both;}
.vto-rs__bot>*:nth-child(1){animation-delay:.3s}.vto-rs__bot>*:nth-child(2){animation-delay:.4s}.vto-rs__bot>*:nth-child(n+3){animation-delay:.5s}
.vto-rs__row{position:relative;display:flex;align-items:flex-end;justify-content:flex-end;min-height:64px;margin-bottom:12px;}
.vto-pchip{position:absolute;left:0;bottom:0;z-index:2;display:flex;align-items:center;gap:0;padding:3px;border:none;border-radius:12px;background:#fff;color:var(--ink);cursor:pointer;box-shadow:0 6px 18px -10px rgba(0,0,0,.35);max-width:72%;transition:gap .5s var(--ease),padding .5s var(--ease);}
.vto-pchip img{width:44px;height:58px;border-radius:9px;object-fit:cover;display:block;flex-shrink:0;}
.vto-pchip__t{max-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:14px;font-weight:500;text-transform:capitalize!important;transition:max-width .6s var(--ease);}
.vto-pchip svg{flex-shrink:0;margin:0 6px 0 4px;}
.vto-pchip.is-open{gap:10px;padding-right:6px;}
.vto-pchip.is-open .vto-pchip__t{max-width:130px;}
.vto-pchip.is-open+.vto-fb #vto-fb-t,.vto-pchip.is-open+.vto-fb i{display:none;}
.vto-pchip.is-open+.vto-fb{padding-left:4px;}
.vto-fb{display:flex;align-items:center;gap:2px;margin-left:62px;margin-bottom:8px;height:42px;padding:0 4px 0 14px;border-radius:13px;background:rgba(36,33,62,.82);color:#fff;font-size:13.5px;-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);white-space:nowrap;min-width:0;}
.vto-fb span{overflow:hidden;text-overflow:ellipsis;}
.vto-fb i{width:1px;height:24px;background:rgba(255,255,255,.28);margin:0 8px;flex-shrink:0;}
.vto-fb button{width:34px;height:34px;flex-shrink:0;border:none;background:none;color:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .25s,transform .4s var(--spring);}
.vto-fb button:hover{background:rgba(255,255,255,.14);}
.vto-fb button.is-on{background:#fff;color:var(--ink);transform:scale(1.08);}
.vto-rs__acts{display:flex;gap:8px;}
.vto-atc{flex:1;height:48px;border:none;border-radius:15px;background:rgba(36,33,62,.9);color:#fff;font-size:17px;font-weight:500;cursor:pointer;-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);transition:background .3s,transform .35s var(--ease);}
.vto-atc:hover{background:#24213e;transform:translateY(-1px);}
.vto-atc:active{transform:scale(.985);}
.vto-ic{width:48px;height:48px;flex-shrink:0;border:none;border-radius:15px;background:rgba(36,33,62,.9);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);transition:background .3s,transform .35s var(--ease);}
.vto-ic:hover{background:#24213e;transform:translateY(-1px);}
.vto-rs__more{display:flex;justify-content:center;align-items:center;gap:8px;margin-top:10px;color:rgba(255,255,255,.55);font-size:12px;}
.vto-rs__more button{background:none;border:none;padding:2px;color:#fff;font-size:13px;font-weight:500;cursor:pointer;opacity:.88;transition:opacity .2s;}
.vto-rs__more button:hover{opacity:1;text-decoration:underline;text-underline-offset:3px;}
.vto-toast{position:absolute;left:50%;top:78px;z-index:6;transform:translate(-50%,-10px);padding:9px 16px;border-radius:999px;background:#fff;color:var(--ink);font-size:13px;font-weight:500;box-shadow:0 10px 28px -8px rgba(0,0,0,.3);opacity:0;pointer-events:none;transition:all .4s var(--ease);}
.vto-toast.is-on{opacity:1;transform:translate(-50%,0);}

/* ── Watermark ── */
.vto-wm{display:inline-flex;align-items:center;gap:6px;margin:10px auto 0;padding:4px 8px;color:var(--ink);font-size:11px;font-weight:500;opacity:.7;}

.vto-wm span{font-weight:500;color:var(--ink);}
.vto-wm__logo{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:7px;background:var(--ink);color:#fff;font-style:normal;}
.vto-wm__logo svg{width:13px;height:13px;}
.vto-wm b{font-weight:700;letter-spacing:-.01em!important;}
.vto-wm--light{color:#fff;margin-top:10px;opacity:.92;}
.vto-wm--light span{color:#fff;}
.vto-wm--light .vto-wm__logo{background:#fff;color:var(--ink);}
.vto-wm--light:hover{background:rgba(255,255,255,.12);}
.vto-pr .vto-wm,.vto-err .vto-wm{display:flex;width:max-content;}

/* ── Error ── */
.vto-err{text-align:center;padding:36px 0 8px;}
.vto-err__icon{font-size:40px;margin:0 0 12px;}
.vto-err h3{font-size:22px;font-weight:500;color:var(--ink);margin:0 0 8px;}
.vto-err p{font-size:15px;line-height:1.5;color:var(--mute);margin:0 0 24px;}

/* ── Minibar ── */
.vto-mini{position:fixed;bottom:18px;right:18px;z-index:2147482999;background:#fff;border-radius:18px;padding:10px 12px;display:flex;align-items:center;gap:12px;cursor:pointer;box-shadow:0 10px 30px -14px rgba(0,0,0,.25),0 0 0 1px rgba(0,0,0,.05);max-width:360px;animation:vU .5s var(--spring);}
.vto-mini__thumbs{display:flex;align-items:center;flex-shrink:0;}
.vto-mini__thumbs img{width:38px;height:50px;border-radius:9px;object-fit:cover;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.1);}
.vto-mini__sp{margin:0 -7px;z-index:1;background:#fff;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,.1);}
.vto-mini__body{flex:1;min-width:0;}
.vto-mini__body strong{display:block;font-size:14px;font-weight:600;color:var(--ink);}
.vto-mini__body span{font-size:12px;color:var(--mute);}
.vto-mini__arrow{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:#f3f2f8;border:none;border-radius:50%;font-size:18px;color:#555;cursor:pointer;flex-shrink:0;}

/* ── Full screen ── */
.vto-zoom{position:fixed;inset:0;z-index:2147483600;background:rgba(12,11,10,.7);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:24px;animation:vF .35s var(--ease);cursor:zoom-out;}
.vto-zoom__in{position:relative;height:100%;display:flex;align-items:center;}
.vto-zoom__in img{max-width:min(92vw,900px);max-height:calc(100vh - 48px);border-radius:18px;object-fit:contain;display:block;box-shadow:0 40px 90px -20px rgba(0,0,0,.55);animation:vZoom .55s var(--spring);}
.vto-zoom__x{position:absolute;top:24px;right:24px;width:54px;height:54px;background:#fff;border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 8px 22px rgba(0,0,0,.22);transition:transform .35s var(--ease);}
.vto-zoom__x:hover{transform:rotate(90deg);}

/* ── Motion ── */
@keyframes vF{from{opacity:0}to{opacity:1}}
@keyframes vSt{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@keyframes vU{from{opacity:0;transform:translateY(20px) scale(.96)}to{opacity:1;transform:none}}
@keyframes vR{to{transform:rotate(360deg)}}
@keyframes vTick{to{transform:rotate(360deg)}}
@keyframes vScan{0%{top:-40%}100%{top:100%}}
@keyframes vBreath{0%,100%{transform:scale(1)}50%{transform:scale(1.03)}}
@keyframes vReveal{from{opacity:0;transform:scale(1.06);filter:blur(10px)}to{opacity:1;transform:none;filter:none}}
@keyframes vZoom{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:none}}
@keyframes vShine{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
@keyframes vFanL{from{opacity:0;transform:translate(-50%,-48%) rotate(0) scale(.9)}to{opacity:1;transform:translate(-108%,-45%) rotate(-5deg)}}
@keyframes vFanR{from{opacity:0;transform:translate(-50%,-48%) rotate(0) scale(.9)}to{opacity:1;transform:translate(8%,-45%) rotate(5deg)}}
@keyframes vFanC{from{opacity:0;transform:translate(-50%,-46%) scale(.95)}to{opacity:1;transform:translate(-50%,-50%)}}
@keyframes vFloat{0%,100%{translate:0 0}50%{translate:0 -5px}}
.vto-s{animation:vF .45s var(--ease);}
.vto-up__in>*{animation:vSt .7s var(--ease) both;}
.vto-up__in>*:nth-child(1){animation-delay:.12s}.vto-up__in>*:nth-child(2){animation-delay:.17s}.vto-up__in>*:nth-child(3){animation:none}
.vto-up__in>*:nth-child(4),.vto-up__in>*:nth-child(5){animation-delay:.34s}.vto-up__in>*:nth-child(6){animation-delay:.4s}.vto-up__in>*:nth-child(7){animation-delay:.45s}.vto-up__in>*:nth-child(n+8){animation-delay:.5s}
.vto-fan__c--c{animation:vFanC .8s var(--ease) .2s both;}
.vto-fan__c--l{animation:vFanL 1s var(--spring) .3s both;}
.vto-fan__c--r{animation:vFanR 1s var(--spring) .34s both;}
.vto-pr>*{animation:vSt .6s var(--ease) both;}.vto-pr>*:nth-child(2){animation-delay:.05s}.vto-pr>*:nth-child(3){animation-delay:.1s}.vto-pr>*:nth-child(n+4){animation-delay:.16s}
@media (prefers-reduced-motion:reduce){#vto *,.vto-root,.vto-root *{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;}}

/* ── Mobile: bottom sheet ── */
@media(max-width:600px){
  .vto-overlay{padding:0;align-items:flex-end;justify-content:center;}
  .vto-overlay.is-in{background:rgba(20,18,16,.28);}
  .vto-frame{width:100%;max-height:90vh;max-height:90dvh;border-radius:28px 28px 0 0;padding:1.5px 1.5px 0;box-shadow:none;transform:translateY(100%);transition:opacity .3s ease,transform .55s var(--ease);}
  .vto-overlay.is-out .vto-frame{transform:translateY(100%);opacity:1;}
  .vto-frame.is-tall{height:86vh;height:86dvh;}
  .vto-card{border-radius:26.5px 26.5px 0 0;}
  .vto-s{padding:0 18px calc(14px + env(safe-area-inset-bottom));}
  .vto-up__in{padding:0 18px calc(12px + env(safe-area-inset-bottom));}
  .vto-head{height:48px;}
  .vto-h{font-size:22px;}
  .vto-fan{height:164px;margin:12px 0 10px;}
  .vto-fan__c{width:84px;height:114px;}
  .vto-fan__c--c{width:106px;height:146px;}
  .vto-tip{font-size:13px;margin-bottom:12px;}
  .vto-stage,.vto-stage__u{width:150px;}
  .vto-rs__bot{padding:60px 14px calc(10px + env(safe-area-inset-bottom));}
  .vto-pchip img{width:40px;height:52px;}
  .vto-rs__row{min-height:60px;}
  .vto-fb{margin-left:56px;font-size:12.5px;padding:0 2px 0 12px;}
  .vto-fb i{margin:0 4px;}
  .vto-mini{left:10px;right:10px;bottom:10px;max-width:none;}
  .vto-zoom__x{top:14px;right:14px;}
}
</style>

<script>
(function(){
const $=id=>document.getElementById(id);
const el=$('vto');if(!el)return;
const D=el.dataset;
if(!window.__tryfitBanner){window.__tryfitBanner=1;try{
  console.log(
    '%cTryFit%c AI Virtual Try-On %c\nShoppers see outfits on themselves — or bedsheets, curtains & decor in their own room.\nBuilt by FutureTechiez → https://futuretechiez.in\nGet it for your Shopify store → https://apps.shopify.com/partners/futuretechiez',
    'background:#111;color:#fff;padding:4px 10px;border-radius:6px;font-weight:700;font-size:13px',
    'color:#111;font-weight:600;font-size:13px;padding-left:6px',
    'color:#666;font-size:12px;line-height:1.6'
  );
}catch(e){}}
/* Inherit the theme's typography so the drawer feels native */

const API='https://tryfit-production.up.railway.app';
const modal=$('vto-modal'),card=$('vto-card'),mini=$('vto-mini'),zoom=$('vto-zoom');
const fileInput=$('vto-file'),upState=$('vto-s-upload');
const HOME=(D.mode==='home');
let file=null,resultUrl=null,timer=null,sec=0,minimized=false,lastFocus=null,gotResult=false;
const PREV_KEY='vto_prev_'+D.shop;

/* Move overlays to <body> so theme transforms/overflow never clip the fixed drawer */
[modal,mini,zoom].forEach(n=>{try{n.classList.add('vto-root');document.body.appendChild(n);}catch(e){}});

const show=s=>{['upload','proc','result','error'].forEach(x=>{const e=$('vto-s-'+x);if(e)e.style.display=x===s?'block':'none';});card.classList.toggle('is-result',s==='result');card.parentElement.classList.toggle('is-tall',s==='result');};
const lockScroll=on=>{document.documentElement.style.overflow=on?'hidden':'';};
const loadFont=()=>{if(window.__vtoFont)return;window.__vtoFont=1;try{const l=document.createElement('link');l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700&display=swap';document.head.appendChild(l);}catch(e){}};
(window.requestIdleCallback||function(f){setTimeout(f,1200);})(loadFont);
/* Warm the guide photos so the drawer opens fully painted */
const warmGuides=()=>{if(window.__vtoWarm)return;window.__vtoWarm=1;try{modal.querySelectorAll('.vto-fan__c img').forEach(i=>{i.loading='eager';const p=new Image();p.decoding='async';p.onerror=()=>{if(i.dataset.fb&&p.src!==i.dataset.fb)p.src=i.dataset.fb;};p.src=i.getAttribute('src');});}catch(e){}};
(window.requestIdleCallback||function(f){setTimeout(f,1500);})(warmGuides,{timeout:3000});
$('vto-btn').addEventListener('pointerenter',warmGuides,{once:true});
$('vto-btn').addEventListener('touchstart',warmGuides,{once:true,passive:true});
let outT=null;
const enter=()=>{clearTimeout(outT);modal.classList.remove('is-out');modal.style.display='flex';requestAnimationFrame(()=>requestAnimationFrame(()=>modal.classList.add('is-in')));};
const leave=(after)=>{modal.classList.remove('is-in');modal.classList.add('is-out');clearTimeout(outT);outT=setTimeout(()=>{modal.style.display='none';modal.classList.remove('is-out');after&&after();},320);};
const openModal=s=>{loadFont();lastFocus=document.activeElement;enter();lockScroll(true);show(s||'upload');if(!s||s==='upload'){upState.classList.remove('is-busy');qr(false);loadPrev();}if(!(window.matchMedia&&matchMedia('(pointer:coarse)').matches))setTimeout(()=>{try{$('vto-close').focus({preventScroll:true});}catch(e){}},50);};
const closeAll=()=>{try{hoStop();}catch(e){}if(modal.style.display!=='none')leave();mini.style.display='none';lockScroll(false);stopTimer();minimized=false;try{lastFocus&&lastFocus.focus();}catch(e){}};
const resetUpload=()=>{file=null;if(fileInput)fileInput.value='';upState.classList.remove('is-busy');};
const toast=t=>{const n=$('vto-toast');if(!n)return;n.textContent=t;n.classList.add('is-on');clearTimeout(n._t);n._t=setTimeout(()=>n.classList.remove('is-on'),2200);};
const beacon=ev=>{try{const f=new FormData();f.append('shop',D.shop);f.append('product_id',D.pid);f.append('product_title',D.ptitle);f.append('event',ev);navigator.sendBeacon(API+'/log-tryon',f);}catch(e){}};

/* Timer + staged progress */
const STEPS=[...document.querySelectorAll('#vto-steps li')];
const startTimer=()=>{sec=0;tick();timer=setInterval(()=>{sec++;tick();updateStatus();},1000);};
const stopTimer=()=>{if(timer){clearInterval(timer);timer=null;}};
const tick=()=>{$('vto-timer').textContent=sec+' sec';$('vto-m-time').textContent=sec+' sec · You can keep browsing';};
const setStep=i=>{STEPS.forEach((li,k)=>{li.classList.toggle('is-done',k<i);li.classList.toggle('is-active',k===i);});
  const t=STEPS[i]?.querySelector('span')?.textContent||'';const ms=$('vto-m-status');if(ms)ms.textContent=t;const st=$('vto-stat');if(st&&st.textContent!==t&&t){st.style.opacity=0;setTimeout(()=>{st.textContent=t;st.style.opacity=1;},180);}};
const setProgress=p=>{p=Math.max(0,Math.min(100,p));const b=$('vto-prog-bar');if(b)b.style.width=p+'%';const t=$('vto-pct');if(t)t.textContent=Math.round(p)+'%';};
const updateStatus=()=>{let i=0;if(sec>=3)i=1;if(sec>=8)i=2;if(sec>=18)i=3;if(sec>=28)i=4;setStep(i);
  setProgress(sec<30?10+sec*2.7:Math.min(96,91+(sec-30)*0.2));};
const finishSteps=()=>{STEPS.forEach(li=>{li.classList.add('is-done');li.classList.remove('is-active');});setProgress(100);const st=$('vto-stat');if(st)st.textContent='Ready';};

const toMini=()=>{minimized=true;lockScroll(false);leave(()=>{if(minimized)mini.style.display='flex';});};
const toModal=()=>{minimized=false;mini.style.display='none';if(!modal.classList.contains('is-in'))enter();lockScroll(true);};

/* Recent looks (this session only) */
const savePrev=url=>{try{let a=JSON.parse(sessionStorage.getItem(PREV_KEY)||'[]');a=[url].concat(a.filter(x=>x!==url)).slice(0,6);sessionStorage.setItem(PREV_KEY,JSON.stringify(a));}catch(e){}};
const loadPrev=()=>{try{const a=JSON.parse(sessionStorage.getItem(PREV_KEY)||'[]'),w=$('vto-prev-wrap'),g=$('vto-prev-grid');
  if(a.length){w.style.display='block';g.innerHTML='';a.forEach(u=>{const i=document.createElement('img');i.src=u;i.alt='Recent look';i.loading='lazy';i.onclick=()=>{resultUrl=u;showResult(u);};g.appendChild(i);});}else w.style.display='none';}catch(e){}};

/* QR → continue on phone (desktop only) */
const qrBtn=$('vto-qr-btn');
const isTouch=window.matchMedia&&matchMedia('(hover:none) and (pointer:coarse)').matches;
if(isTouch&&qrBtn)qrBtn.style.display='none';
/* Phone handoff: QR → phone page uploads → this drawer picks the photo up and starts the try-on */
let hoSid=null,hoT=null;
const hoStop=()=>{clearTimeout(hoT);hoT=null;hoSid=null;};
const hoStatus=(t,live)=>{const n=$('vto-qr-st');if(!n)return;n.querySelector('span').textContent=t;n.classList.toggle('is-live',!!live);};
const hoPoll=()=>{if(!hoSid)return;const sid=hoSid;
  fetch(API+'/handoff/'+sid,{cache:'no-store'}).then(r=>r.json()).then(d=>{
    if(sid!==hoSid)return;
    if(d.state==='opened')hoStatus('Phone connected — waiting for your photo…',true);
    if(d.state==='uploading')hoStatus('Receiving your photo…',true);
    if(d.state==='ready'){return fetch(API+'/handoff/'+sid+'?photo=1').then(r=>r.ok?r.blob():null).then(b=>{
      if(!b||sid!==hoSid)return;hoStop();const f=new File([b],'phone-photo.jpg',{type:b.type||'image/jpeg'});startWith(f);});}
    hoT=setTimeout(hoPoll,1800);
  }).catch(()=>{hoT=setTimeout(hoPoll,3000);});};
const hoStart=()=>{hoStop();
  const rnd=(window.crypto&&crypto.getRandomValues)?Array.from(crypto.getRandomValues(new Uint8Array(16)),b=>b.toString(16).padStart(2,'0')).join(''):(Date.now().toString(36)+Math.random().toString(36).slice(2)).padEnd(20,'0');
  hoSid=rnd;hoStatus('Take a photo on your phone — your look appears right here',false);
  fetch(API+'/handoff/'+rnd,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({t:D.ptitle,i:D.pimg,mode:D.mode,shop:D.shop})}).catch(()=>{});
  $('vto-qr-img').src='https://api.qrserver.com/v1/create-qr-code/?size=360x360&margin=0&color=1c1b1a&data='+encodeURIComponent(API+'/m/'+rnd);
  hoT=setTimeout(hoPoll,1500);};
const qr=on=>{const q=$('vto-qr'),f=$('vto-fan');if(!q)return;
  if(on)hoStart();else hoStop();
  q.style.display=on?'flex':'none';f.style.display=on?'none':'block';$('vto-tip').style.display=on?'none':'block';$('vto-qr-lbl').textContent=on?'Back':'Use my phone instead';qrBtn.dataset.on=on?'1':'';};
qrBtn?.addEventListener('click',()=>qr(!qrBtn.dataset.on));

/* Result */
const showResult=url=>{
  const img=$('vto-res-img');img.src=url;$('vto-z-img').src=url;
  const fb=$('vto-fb');fb.querySelectorAll('button').forEach(b=>b.classList.remove('is-on'));$('vto-fb-t').textContent='Happy with it?';
  $('vto-pchip').classList.remove('is-open');
  show('result');
};

/* PDP button + availability (hidden when the store is out of try-ons) */
$('vto-btn').addEventListener('click',()=>openModal('upload'));
const hideVto=()=>{try{el.style.display='none';}catch(e){}};
const autoOpen=()=>{if(!/[?&]tryfit=open\b/.test(location.search))return;
  try{const u=new URL(location.href);u.searchParams.delete('tryfit');history.replaceState(history.state,'',u.toString());}catch(e){}
  setTimeout(()=>{if(el.style.display!=='none')openModal('upload');},350);};
(function(){if(window.Shopify&&Shopify.designMode)return;var k='vto_av_'+D.shop,c=null;
  try{c=JSON.parse(sessionStorage.getItem(k)||'null');}catch(e){}
  if(c&&Date.now()-c.t<120000){if(c.a===false)hideVto();else autoOpen();return;}
  fetch(API+'/proxy-tryon?shop='+encodeURIComponent(D.shop),{mode:'cors'}).then(r=>r.json()).then(d=>{
    var a=d.available!==false;try{sessionStorage.setItem(k,JSON.stringify({a:a,t:Date.now()}));}catch(e){}
    if(!a)hideVto();else autoOpen();}).catch(()=>autoOpen());})();

const closeOrMini=()=>{if($('vto-s-proc').style.display!=='none')toMini();else{closeAll();resetUpload();}};
$('vto-close').addEventListener('click',closeOrMini);
modal.addEventListener('click',e=>{if(e.target===modal)closeOrMini();});
document.addEventListener('keydown',e=>{if(e.key!=='Escape')return;
  if(zoom.style.display!=='none')zoom.style.display='none';
  else if(modal.style.display!=='none')closeOrMini();});
$('vto-m-expand').addEventListener('click',toModal);
mini.addEventListener('click',e=>{if(e.target.closest('#vto-m-expand'))return;toModal();});
$('vto-to-mini')?.addEventListener('click',toMini);

/* File → "Uploading…" blur → step 2 */
const startWith=f=>{
  if(!f||!f.type.startsWith('image/'))return;
  if(f.size>10*1024*1024){alert('Please choose a photo under 10 MB');return;}
  file=f;gotResult=false;qr(false);upState.classList.add('is-busy');
  const t0=Date.now(),r=new FileReader();
  r.onload=ev=>{$('vto-proc-u').src=ev.target.result;$('vto-m-u').src=ev.target.result;
    setTimeout(()=>{upState.classList.remove('is-busy');if(gotResult)return;show('proc');setProgress(0);setStep(0);startTimer();},Math.max(0,900-(Date.now()-t0)));
    runAI();};
  r.readAsDataURL(f);
};
fileInput?.addEventListener('change',e=>startWith(e.target.files[0]));
const dz=$('vto-dropzone');
if(dz){['dragover','dragenter'].forEach(t=>dz.addEventListener(t,e=>{e.preventDefault();dz.style.background='#faf8f6';}));
  dz.addEventListener('dragleave',()=>{dz.style.background='';});
  dz.addEventListener('drop',e=>{e.preventDefault();dz.style.background='';startWith(e.dataTransfer.files[0]);});}

async function runAI(){
  try{
    const fd=new FormData();
    fd.append('shop',D.shop);fd.append('product_id',D.pid);fd.append('product_title',D.ptitle);
    fd.append('product_image_url',D.pimg);fd.append('user_photo',file);fd.append('category',D.category||'dresses');fd.append('mode',D.mode||'fashion');
    const res=await fetch(API+'/proxy-tryon',{method:'POST',body:fd,mode:'cors'});
    const data=await res.json();
    stopTimer();
    if(res.ok&&data.success&&data.result_url){
      gotResult=true;resultUrl=data.result_url;savePrev(resultUrl);finishSteps();
      const pre=new Image();pre.onload=pre.onerror=()=>setTimeout(()=>{toModal();showResult(resultUrl);},350);pre.src=resultUrl;
      return;
    }
    if(res.status===429){
      $('vto-err-icon').textContent='✨';
      $('vto-err-title').textContent="You've loved this feature!";
      $('vto-err-msg').innerHTML='This store has used all its virtual try-ons for this month.<br>Please check back soon.';
      $('vto-err-retry').textContent='Got it';
      try{sessionStorage.setItem('vto_av_'+D.shop,JSON.stringify({a:false,t:Date.now()}));}catch(e){}
      $('vto-err-retry').addEventListener('click',()=>{closeAll();hideVto();},{once:true});
      gotResult=true;toModal();show('error');mini.style.display='none';return;
    }
    throw new Error(data.error||'We couldn’t create your preview.');
  }catch(err){
    gotResult=true;stopTimer();upState.classList.remove('is-busy');
    $('vto-err-icon').textContent='😔';
    $('vto-err-title').textContent='Something went wrong';
    $('vto-err-msg').textContent=(err&&err.message)||'Please try again in a moment.';
    $('vto-err-retry').textContent='Try again';
    toModal();show('error');mini.style.display='none';
  }
}

/* Result actions */
const backToUpload=()=>{resetUpload();show('upload');qr(false);loadPrev();};
$('vto-regen')?.addEventListener('click',backToUpload);
$('vto-err-retry')?.addEventListener('click',()=>{if($('vto-err-retry').textContent!=='Got it')backToUpload();});
$('vto-pchip')?.addEventListener('click',()=>{const c=$('vto-pchip');c.classList.toggle('is-open');c.setAttribute('aria-expanded',c.classList.contains('is-open'));});
$('vto-fb')?.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{
  $('vto-fb').querySelectorAll('button').forEach(x=>x.classList.toggle('is-on',x===b));
  $('vto-fb-t').textContent=b.dataset.v==='up'?'Thanks! Glad you like it':'Thanks for the feedback';
  beacon(b.dataset.v==='up'?'feedback_up':'feedback_down');}));
/* Add to cart → theme's cart drawer if it has one, otherwise the cart page */
const DRAWER_SEL='cart-drawer,#CartDrawer,#cart-drawer,#Cart-Drawer,#sidebar-cart,#mini-cart,cart-notification,drawer-cart,[data-cart-drawer],.cart-drawer,.drawer--cart,#CartDrawer-Overlay';
const CART_LINK_SEL='header a[href$="/cart"],#cart-icon-bubble,[data-cart-toggle],[data-drawer-toggle="cart"],[aria-controls*="cart" i],.js-drawer-open-cart,.site-header__cart,a.header__icon--cart';
const fireCartEvents=(item)=>{const ev=['cart:refresh','cart:build','cart:updated','cart-drawer:refresh','theme:cart:change','ajaxProduct:added','product:added'];
  ev.forEach(n=>{try{const c=new CustomEvent(n,{bubbles:true,detail:{item,variant:item,quantity:1,cart:null}});document.dispatchEvent(c);document.documentElement.dispatchEvent(new CustomEvent(n,{bubbles:true,detail:{item,variant:item,quantity:1}}));}catch(e){}});};
async function addToCartAndOpen(vid){
  const dawn=document.querySelector('cart-drawer');
  const hasDrawer=D.cartType!=='page'&&!!document.querySelector(DRAWER_SEL);
  /* Dawn family (Dawn, Sense, Craft, Refresh, Studio…): render the drawer sections in the same request */
  if(hasDrawer&&dawn&&typeof dawn.renderContents==='function'&&typeof dawn.getSectionsToRender==='function'){
    const r=await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},
      body:JSON.stringify({id:vid,quantity:1,sections:dawn.getSectionsToRender().map(s=>s.id),sections_url:location.pathname})});
    const j=await r.json();if(!r.ok)throw new Error(j.description||j.message||'Could not add to cart');
    closeAll();dawn.classList.remove('is-empty');dawn.renderContents(j);return;
  }
  const r=await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({id:vid,quantity:1})});
  const j=await r.json();if(!r.ok)throw new Error(j.description||j.message||'Could not add to cart');
  if(!hasDrawer){window.location.href='/cart';return;}
  closeAll();fireCartEvents(j);
  /* Other themes: their own cart icon opens (and refreshes) the drawer; if nothing opens, go to /cart */
  const link=[...document.querySelectorAll(CART_LINK_SEL)].find(a=>a.offsetParent!==null);
  if(link){setTimeout(()=>link.click(),120);}else window.location.href='/cart';
}
$('vto-buy')?.addEventListener('click',async()=>{
  beacon('atc');const btn=$('vto-buy'),txt=btn.textContent;btn.textContent='Adding…';btn.disabled=true;
  const vid=document.querySelector('form[action*="/cart/add"] [name="id"]')?.value||D.vid;
  try{await addToCartAndOpen(vid);btn.textContent='Added ✓';setTimeout(()=>{btn.textContent=txt;btn.disabled=false;},1500);}
  catch(e){btn.textContent=txt;btn.disabled=false;toast((e&&e.message)||'Could not add to cart');}
});
const shareText=()=>(HOME?'See how ':'Look how ')+D.ptitle+(HOME?' looks in my space ✨':' looks on me ✨');
$('vto-wa')?.addEventListener('click',()=>{beacon('share');window.open('https://wa.me/?text='+encodeURIComponent(shareText()+'\n'+(resultUrl||'')+'\n\nShop it: '+(D.purl||location.href)),'_blank','noopener');});
$('vto-share')?.addEventListener('click',async()=>{
  beacon('share');const url=D.purl||location.href;
  try{
    if(navigator.canShare&&resultUrl){const b=await (await fetch(resultUrl)).blob();const f=new File([b],'my-look.jpg',{type:b.type||'image/jpeg'});
      if(navigator.canShare({files:[f]})){await navigator.share({files:[f],title:D.ptitle,text:shareText()+' '+url});return;}}
    if(navigator.share){await navigator.share({title:D.ptitle,text:shareText(),url});return;}
  }catch(e){if(e&&e.name==='AbortError')return;}
  try{await navigator.clipboard.writeText(resultUrl||url);toast('Link copied');}catch(e){toast('Couldn’t share');}
});
$('vto-dl')?.addEventListener('click',async()=>{
  if(!resultUrl)return;
  try{const b=await (await fetch(resultUrl)).blob();const u=URL.createObjectURL(b);const a=document.createElement('a');a.href=u;a.download='my-look.jpg';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),2000);}
  catch(e){window.open(resultUrl,'_blank','noopener');}
});

/* Full-screen view */
const openZoom=()=>{if(resultUrl)zoom.style.display='flex';};
$('vto-fs')?.addEventListener('click',openZoom);
$('vto-res-wrap')?.addEventListener('click',openZoom);
$('vto-z-close')?.addEventListener('click',e=>{e.stopPropagation();zoom.style.display='none';});
zoom?.addEventListener('click',e=>{if(e.target.id!=='vto-z-img')zoom.style.display='none';});
})();
</script>
{% endif %}

