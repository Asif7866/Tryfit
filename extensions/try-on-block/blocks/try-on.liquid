{% if product %}
<div
  id="vto"
  data-pid="{{ product.id }}"
  data-ptitle="{{ product.title | escape }}"
  data-pimg="{{ product.featured_image | image_url: width: 1024 }}"
  data-shop="{{ shop.permanent_domain }}"
  data-category="{{ block.settings.garment_category }}"
  data-vid="{{ product.selected_or_first_available_variant.id }}"
>
  <button id="vto-btn" class="vto-btn" type="button">
    <svg class="vto-btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
    <span>{{ block.settings.button_text }}</span>
    <span class="vto-btn__badge">AI</span>
  </button>

  <!-- ═══ MODAL ═══ -->
  <div id="vto-modal" class="vto-modal" style="display:none;">
    <div class="vto-modal__card">
      <div class="vto-modal__header">
        <h2 class="vto-modal__title">See it on you</h2>
        <button id="vto-close" class="vto-modal__close" type="button" aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- UPLOAD STATE -->
      <div id="vto-upload" class="vto-state">
        <div class="vto-photos">
          <div class="vto-photos__product">
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" />
          </div>
          <div class="vto-photos__divider"><span>+</span></div>
          <div id="vto-dropzone" class="vto-photos__user">
            <input type="file" id="vto-file" accept="image/jpeg,image/png,image/webp" />
            <div id="vto-dz-empty">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <p>Upload your photo</p>
              <span>JPG, PNG or WebP</span>
            </div>
            <div id="vto-dz-preview" style="display:none;">
              <img id="vto-preview" alt="Your photo" />
            </div>
          </div>
        </div>
        <p class="vto-privacy">Your photo is processed securely and never stored</p>
      </div>

      <!-- PROCESSING STATE -->
      <div id="vto-processing" class="vto-state" style="display:none;">
        <div class="vto-process">
          <div class="vto-process__images">
            <div class="vto-process__img"><img id="vto-proc-product" src="{{ product.featured_image | image_url: width: 600 }}" alt="" /></div>
            <div class="vto-process__spinner">
              <svg width="32" height="32" viewBox="0 0 32 32"><circle cx="16" cy="16" r="14" fill="none" stroke="#e5e5e5" stroke-width="2.5"/><circle cx="16" cy="16" r="14" fill="none" stroke="#111" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="70 88" class="vto-spin"/></svg>
            </div>
            <div class="vto-process__img"><img id="vto-proc-user" alt="" /></div>
          </div>
          <p class="vto-process__status" id="vto-status">Reading your photo</p>
          <p class="vto-process__timer" id="vto-timer">0 sec</p>
        </div>
      </div>

      <!-- RESULT STATE -->
      <div id="vto-result" class="vto-state" style="display:none;">
        <p class="vto-result__sub">Here's your look! Tap the image to zoom in.</p>
        <div class="vto-result__actions">
          <button id="vto-regen" class="vto-btn-outline" type="button">Regenerate</button>
          <button id="vto-download" class="vto-btn-outline" type="button">Download</button>
        </div>
        <button id="vto-buy" class="vto-btn-primary" type="button">Buy</button>
        <div class="vto-result__image" id="vto-result-wrap">
          <img id="vto-result-img" alt="Try-on result" />
          <div class="vto-result__zoom-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          </div>
        </div>
        <p class="vto-result__disclaimer">Colors and fit may vary slightly from the actual product.</p>
        <div class="vto-powered">Powered by <a href="https://futuretechiez.in" target="_blank" rel="noopener">TryFit</a></div>
      </div>

      <!-- ERROR STATE -->
      <div id="vto-error" class="vto-state" style="display:none;">
        <div class="vto-error-box">
          <p id="vto-error-emoji">😔</p>
          <h3 id="vto-error-title">Something went wrong</h3>
          <p id="vto-error-msg"></p>
          <button id="vto-error-retry" class="vto-btn-primary" type="button">Try Again</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ MINI BAR (shows when modal minimized during processing) ═══ -->
  <div id="vto-minibar" class="vto-minibar" style="display:none;">
    <div class="vto-minibar__thumbs">
      <img id="vto-mini-product" src="{{ product.featured_image | image_url: width: 120 }}" alt="" />
      <div class="vto-minibar__spinner-sm">
        <svg width="18" height="18" viewBox="0 0 32 32"><circle cx="16" cy="16" r="14" fill="none" stroke="#ddd" stroke-width="3"/><circle cx="16" cy="16" r="14" fill="none" stroke="#111" stroke-width="3" stroke-linecap="round" stroke-dasharray="70 88" class="vto-spin"/></svg>
      </div>
      <img id="vto-mini-user" alt="" />
    </div>
    <div class="vto-minibar__text">
      <strong id="vto-mini-status">Fitting it on you</strong>
      <span id="vto-mini-timer">0 sec · You can keep browsing</span>
    </div>
    <button id="vto-mini-expand" class="vto-minibar__expand" type="button" aria-label="Expand">›</button>
  </div>

  <!-- ═══ ZOOM OVERLAY ═══ -->
  <div id="vto-zoom" class="vto-zoom" style="display:none;">
    <button id="vto-zoom-close" class="vto-zoom__close" type="button" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <img id="vto-zoom-img" alt="Zoomed result" />
  </div>
</div>

<style>
:root{--vto-ff:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;--vto-r:{{ block.settings.button_radius }}px;--vto-primary:{{ block.settings.button_color }};--vto-primary-text:{{ block.settings.button_text_color }};}

/* ── BUTTON ── */
.vto-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:16px 24px;margin-top:10px;background:var(--vto-primary);color:var(--vto-primary-text);border:none;border-radius:var(--vto-r);font:600 15px/1 var(--vto-ff);cursor:pointer;transition:transform .15s,box-shadow .15s;}
.vto-btn:hover{transform:translateY(-1px);box-shadow:0 4px 16px rgba(0,0,0,.12);}
.vto-btn:active{transform:translateY(0);}
.vto-btn__icon{flex-shrink:0;}
.vto-btn__badge{padding:3px 8px;background:rgba(255,255,255,.2);border-radius:5px;font-size:10px;font-weight:700;letter-spacing:.5px;}

/* ── MODAL OVERLAY ── */
.vto-modal{position:fixed;inset:0;z-index:999999;background:rgba(0,0,0,.5);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:16px;animation:vtoFade .2s ease;}
.vto-modal__card{background:#fff;border-radius:20px;max-width:480px;width:100%;max-height:92vh;overflow-y:auto;position:relative;animation:vtoSlide .25s cubic-bezier(.16,1,.3,1);-webkit-overflow-scrolling:touch;}
.vto-modal__header{display:flex;align-items:center;justify-content:space-between;padding:20px 20px 0;}
.vto-modal__title{margin:0;font:700 20px/1.2 var(--vto-ff);color:#111;}
.vto-modal__close{width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:#f5f5f5;border:none;border-radius:50%;cursor:pointer;color:#666;transition:background .15s;flex-shrink:0;}
.vto-modal__close:hover{background:#e8e8e8;}

/* ── STATES ── */
.vto-state{padding:16px 20px 20px;}

/* ── UPLOAD: Photos side-by-side ── */
.vto-photos{display:flex;align-items:stretch;gap:0;}
.vto-photos__product{flex:2.5;border-radius:14px;overflow:hidden;background:#f5f5f5;}
.vto-photos__product img{width:100%;height:100%;object-fit:cover;display:block;}
.vto-photos__divider{display:flex;align-items:center;justify-content:center;width:36px;flex-shrink:0;}
.vto-photos__divider span{width:28px;height:28px;border-radius:50%;background:#7c3aed;color:#fff;font:700 16px/28px var(--vto-ff);text-align:center;box-shadow:0 2px 8px rgba(124,58,237,.25);}
.vto-photos__user{flex:1;min-height:200px;border:2px dashed #d4d4d4;border-radius:14px;position:relative;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:border-color .2s,background .2s;overflow:hidden;}
.vto-photos__user:hover{border-color:#7c3aed;background:#faf8ff;}
.vto-photos__user input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;z-index:2;}
#vto-dz-empty{text-align:center;padding:12px 8px;color:#7c3aed;}
#vto-dz-empty p{margin:8px 0 2px;font:600 12px/1.3 var(--vto-ff);color:#333;}
#vto-dz-empty span{font:400 10px/1 var(--vto-ff);color:#aaa;}
#vto-dz-preview{position:absolute;inset:0;}
#vto-dz-preview img{width:100%;height:100%;object-fit:cover;}
.vto-privacy{text-align:center;margin:12px 0 0;font:400 11px/1.4 var(--vto-ff);color:#bbb;}

/* ── PROCESSING ── */
.vto-process{text-align:center;padding:20px 0 8px;}
.vto-process__images{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:20px;}
.vto-process__img{width:42%;aspect-ratio:3/4;border-radius:14px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.08);}
.vto-process__img img{width:100%;height:100%;object-fit:cover;display:block;}
.vto-process__spinner{width:16%;display:flex;align-items:center;justify-content:center;}
.vto-process__status{font:500 15px/1 var(--vto-ff);color:#555;margin:0 0 4px;}
.vto-process__timer{font:400 13px/1 var(--vto-ff);color:#aaa;margin:0;}
.vto-spin{animation:vtoSpin 1s linear infinite;transform-origin:center;}
@keyframes vtoSpin{to{transform:rotate(360deg)}}

/* ── RESULT ── */
.vto-result__sub{font:400 14px/1.4 var(--vto-ff);color:#777;margin:0 0 14px;}
.vto-result__actions{display:flex;gap:10px;margin-bottom:10px;}
.vto-btn-outline{flex:1;padding:12px;background:#f5f5f5;color:#333;border:none;border-radius:var(--vto-r);font:600 14px/1 var(--vto-ff);cursor:pointer;transition:background .15s;}
.vto-btn-outline:hover{background:#eee;}
.vto-btn-primary{width:100%;padding:14px;background:#111;color:#fff;border:none;border-radius:var(--vto-r);font:600 15px/1 var(--vto-ff);cursor:pointer;transition:background .15s,transform .1s;margin-bottom:14px;}
.vto-btn-primary:hover{background:#222;transform:translateY(-1px);}
.vto-result__image{position:relative;border-radius:16px;overflow:hidden;cursor:zoom-in;box-shadow:0 4px 24px rgba(0,0,0,.08);}
.vto-result__image img{width:100%;display:block;border-radius:16px;}
.vto-result__zoom-icon{position:absolute;top:12px;right:12px;width:36px;height:36px;background:rgba(255,255,255,.85);border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.1);pointer-events:none;}
.vto-result__disclaimer{text-align:center;margin:10px 0 0;font:400 10px/1.4 var(--vto-ff);color:#ccc;}
.vto-powered{text-align:center;padding:8px 0 0;font:400 11px/1 var(--vto-ff);color:#ccc;}
.vto-powered a{color:#999;text-decoration:none;font-weight:600;}

/* ── ERROR ── */
.vto-error-box{text-align:center;padding:32px 0 12px;}
.vto-error-box p:first-child{font-size:40px;margin:0 0 8px;}
.vto-error-box h3{font:700 18px/1 var(--vto-ff);color:#111;margin:0 0 6px;}
.vto-error-box p{font:400 13px/1.4 var(--vto-ff);color:#999;margin:0 0 18px;}

/* ── MINIBAR ── */
.vto-minibar{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:999998;background:#fff;border-radius:16px;padding:10px 14px;display:flex;align-items:center;gap:12px;box-shadow:0 8px 32px rgba(0,0,0,.12),0 0 0 1px rgba(0,0,0,.04);max-width:380px;width:calc(100% - 32px);animation:vtoSlideUp .3s ease;}
.vto-minibar__thumbs{display:flex;align-items:center;gap:0;flex-shrink:0;}
.vto-minibar__thumbs img{width:36px;height:36px;border-radius:8px;object-fit:cover;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.1);}
.vto-minibar__thumbs img:nth-child(3){margin-left:-8px;}
.vto-minibar__spinner-sm{margin:0 -6px;z-index:1;background:#fff;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,.1);}
.vto-minibar__text{flex:1;min-width:0;}
.vto-minibar__text strong{display:block;font:600 13px/1.2 var(--vto-ff);color:#111;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.vto-minibar__text span{font:400 11px/1.2 var(--vto-ff);color:#999;}
.vto-minibar__expand{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:#f5f5f5;border:none;border-radius:50%;font:600 18px/1 var(--vto-ff);color:#666;cursor:pointer;flex-shrink:0;transition:background .15s;}
.vto-minibar__expand:hover{background:#e8e8e8;}

/* ── ZOOM ── */
.vto-zoom{position:fixed;inset:0;z-index:9999999;background:rgba(0,0,0,.92);display:flex;align-items:center;justify-content:center;padding:20px;animation:vtoFade .2s ease;cursor:zoom-out;}
.vto-zoom img{max-width:100%;max-height:100%;border-radius:12px;object-fit:contain;}
.vto-zoom__close{position:absolute;top:16px;right:16px;width:44px;height:44px;background:rgba(255,255,255,.15);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:1;}

/* ── ANIMATIONS ── */
@keyframes vtoFade{from{opacity:0}to{opacity:1}}
@keyframes vtoSlide{from{opacity:0;transform:scale(.95) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}
@keyframes vtoSlideUp{from{opacity:0;transform:translateX(-50%) translateY(20px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}

/* ── MOBILE ── */
@media(max-width:500px){
  .vto-modal{padding:0;align-items:flex-end;}
  .vto-modal__card{max-width:100%;border-radius:20px 20px 0 0;max-height:95vh;}
  .vto-photos__product{flex:2;}
  .vto-process__img{width:40%;}
}
</style>

<script>
(function(){
  const $=id=>document.getElementById(id);
  const el=$('vto');if(!el)return;
  const D=el.dataset;
  const modal=$('vto-modal'),minibar=$('vto-minibar'),zoom=$('vto-zoom');
  const fileInput=$('vto-file');
  let file=null,resultUrl=null,timerInterval=null,seconds=0,isMinimized=false;

  const show=state=>['upload','processing','result','error'].forEach(s=>{
    const e=$('vto-'+s);if(e)e.style.display=s===state?'block':'none';
  });

  const openModal=()=>{modal.style.display='flex';show('upload');};
  const closeModal=()=>{modal.style.display='none';minibar.style.display='none';stopTimer();reset();isMinimized=false;};
  const reset=()=>{file=null;resultUrl=null;if(fileInput)fileInput.value='';$('vto-dz-empty').style.display='block';$('vto-dz-preview').style.display='none';};

  // Timer
  const startTimer=()=>{seconds=0;updateTimer();timerInterval=setInterval(()=>{seconds++;updateTimer();updateStatus();},1000);};
  const stopTimer=()=>{if(timerInterval){clearInterval(timerInterval);timerInterval=null;}};
  const updateTimer=()=>{
    $('vto-timer').textContent=seconds+' sec';
    if(isMinimized)$('vto-mini-timer').textContent=seconds+' sec · You can keep browsing';
  };
  const updateStatus=()=>{
    let msg='Reading your photo';
    if(seconds>=5)msg='Fitting it on you';
    if(seconds>=15)msg='Refining the details';
    if(seconds>=25)msg='Almost ready';
    $('vto-status').textContent=msg;
    if(isMinimized)$('vto-mini-status').textContent=msg;
  };

  // Minimize / expand
  const minimize=()=>{
    if(!isMinimized){
      isMinimized=true;
      modal.style.display='none';
      minibar.style.display='flex';
    }
  };
  const expand=()=>{
    if(isMinimized){
      isMinimized=false;
      minibar.style.display='none';
      modal.style.display='flex';
    }
  };

  // Events
  $('vto-btn').addEventListener('click',openModal);
  $('vto-close').addEventListener('click',()=>{
    if($('vto-processing').style.display!=='none'){minimize();}
    else{closeModal();}
  });
  modal.addEventListener('click',e=>{if(e.target===modal){
    if($('vto-processing').style.display!=='none'){minimize();}
    else{closeModal();}
  }});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(zoom.style.display!=='none'){zoom.style.display='none';}else if(isMinimized){expand();}else{closeModal();}}});
  $('vto-mini-expand').addEventListener('click',expand);

  // File handling — auto-start on upload
  fileInput?.addEventListener('change',e=>{
    const f=e.target.files[0];
    if(!f||!f.type.startsWith('image/'))return;
    if(f.size>10*1024*1024){alert('Max 10 MB');return;}
    file=f;
    const r=new FileReader();
    r.onload=ev=>{
      $('vto-preview').src=ev.target.result;
      $('vto-dz-empty').style.display='none';
      $('vto-dz-preview').style.display='block';
      // Auto-start processing
      setTimeout(()=>startProcessing(),300);
    };
    r.readAsDataURL(f);
  });

  // Drag & drop
  const dz=$('vto-dropzone');
  if(dz){
    dz.addEventListener('dragover',e=>{e.preventDefault();dz.style.borderColor='#7c3aed';dz.style.background='#faf8ff';});
    dz.addEventListener('dragleave',()=>{dz.style.borderColor='#d4d4d4';dz.style.background='';});
    dz.addEventListener('drop',e=>{e.preventDefault();dz.style.borderColor='#d4d4d4';dz.style.background='';const f=e.dataTransfer.files[0];if(f){const dt=new DataTransfer();dt.items.add(f);fileInput.files=dt.files;fileInput.dispatchEvent(new Event('change'));}});
  }

  // Processing
  async function startProcessing(){
    if(!file)return;
    $('vto-proc-user').src=$('vto-preview').src;
    $('vto-mini-user').src=$('vto-preview').src;
    show('processing');
    startTimer();

    try{
      const fd=new FormData();
      fd.append('shop',D.shop);fd.append('product_id',D.pid);fd.append('product_title',D.ptitle);
      fd.append('product_image_url',D.pimg);fd.append('user_photo',file);fd.append('category',D.category||'dresses');
      const res=await fetch('https://tryfit-production.up.railway.app/proxy-tryon',{method:'POST',body:fd,mode:'cors'});
      const data=await res.json();
      stopTimer();

      if(res.ok&&data.success&&data.result_url){
        resultUrl=data.result_url;
        $('vto-result-img').src=resultUrl;
        $('vto-zoom-img').src=resultUrl;
        if(isMinimized){expand();}
        show('result');
        minibar.style.display='none';
        return;
      }
      if(res.status===429){
        const em=$('vto-error-emoji'),et=$('vto-error-title'),er=$('vto-error-retry');
        if(em)em.textContent='✨';if(et)et.textContent="You've loved this feature!";
        $('vto-error-msg').innerHTML='This store has used all its virtual try-ons for this month.<br>New credits arrive next month — or the store can upgrade for more.';
        if(er)er.textContent='Got it';
        if(isMinimized){expand();}
        show('error');minibar.style.display='none';return;
      }
      throw new Error(data.error||'AI unavailable');
    }catch(err){
      stopTimer();
      if(isMinimized){expand();}
      minibar.style.display='none';
      // Canvas fallback
      try{
        const userUrl=URL.createObjectURL(file);
        const canvas=document.createElement('canvas');canvas.width=600;canvas.height=800;
        const ctx=canvas.getContext('2d');
        const userImage=new Image();
        userImage.onload=()=>{
          ctx.drawImage(userImage,0,0,600,800);
          const prodImage=new Image();prodImage.crossOrigin='anonymous';
          prodImage.onload=()=>{
            const tmp=document.createElement('canvas');const tw=prodImage.naturalWidth,th=prodImage.naturalHeight;
            tmp.width=tw;tmp.height=th;const tc=tmp.getContext('2d');tc.drawImage(prodImage,0,0);
            const imgData=tc.getImageData(0,0,tw,th);const dd=imgData.data;
            for(let i=0;i<dd.length;i+=4){const br=(dd[i]+dd[i+1]+dd[i+2])/3;if(br>220&&Math.abs(dd[i]-dd[i+1])<25&&Math.abs(dd[i+1]-dd[i+2])<25)dd[i+3]=0;else if(br>200)dd[i+3]=Math.max(0,(255-br)*4);}
            tc.putImageData(imgData,0,0);
            const ratio=tw/th;let pw,ph,px,py;
            if(ratio>1.5){pw=300;ph=pw/ratio;px=(600-pw)/2;py=480;}
            else if(ratio>0.7){pw=240;ph=pw/ratio;px=(600-pw)/2;py=190;}
            else{pw=340;ph=pw/ratio;px=(600-pw)/2;py=200;}
            ctx.drawImage(tmp,px,py,pw,ph);
            ctx.fillStyle='rgba(124,58,237,0.9)';ctx.beginPath();ctx.roundRect(170,740,260,40,14);ctx.fill();
            ctx.fillStyle='#fff';ctx.font='600 14px sans-serif';ctx.textAlign='center';
            ctx.fillText('✨ Virtual Try-On by TryFit',300,766);
            resultUrl=canvas.toDataURL('image/jpeg',0.92);
            $('vto-result-img').src=resultUrl;$('vto-zoom-img').src=resultUrl;show('result');
          };
          prodImage.onerror=()=>{$('vto-error-msg').textContent='Could not load product image';show('error');};
          prodImage.src=D.pimg;
        };
        userImage.src=userUrl;
      }catch(e2){$('vto-error-msg').textContent=e2.message||'Please try again.';show('error');}
    }
  }

  // Result actions
  $('vto-regen')?.addEventListener('click',()=>{reset();show('upload');});
  $('vto-error-retry')?.addEventListener('click',()=>{
    $('vto-error-emoji').textContent='😔';$('vto-error-title').textContent='Something went wrong';
    $('vto-error-retry').textContent='Try Again';reset();show('upload');
  });
  $('vto-buy')?.addEventListener('click',async()=>{
    try{const af=new FormData();af.append('shop',D.shop);af.append('product_id',D.pid);af.append('product_title',D.ptitle);af.append('event','atc');navigator.sendBeacon('https://tryfit-production.up.railway.app/log-tryon',af);}catch(e){}
    const vid=D.vid||document.querySelector('[name="id"]')?.value;
    try{if(vid){await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:vid,quantity:1})});}closeModal();window.location.href='/cart';}catch(e){window.location.href='/cart';}
  });
  $('vto-download')?.addEventListener('click',()=>{
    if(!resultUrl)return;
    const a=document.createElement('a');a.href=resultUrl;a.download='tryfit-look.jpg';a.click();
  });

  // Zoom
  $('vto-result-wrap')?.addEventListener('click',()=>{if(resultUrl){zoom.style.display='flex';}});
  $('vto-zoom-close')?.addEventListener('click',()=>{zoom.style.display='none';});
  zoom?.addEventListener('click',e=>{if(e.target===zoom)zoom.style.display='none';});
})();
</script>
{% endif %}

