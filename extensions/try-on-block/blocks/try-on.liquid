{% if product %}
<div
  id="vto"
  data-pid="{{ product.id }}"
  data-ptitle="{{ product.title | escape }}"
  data-pimg="{{ product.featured_image | image_url: width: 1024 }}"
  data-shop="{{ shop.permanent_domain }}"
  data-category="{{ block.settings.garment_category }}"
>
  <button id="vto-btn" class="vto-btn" type="button">
    <span class="vto-btn__shimmer"></span>
    <span class="vto-btn__icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    </span>
    <span class="vto-btn__label">{{ block.settings.button_text }}</span>
    <span class="vto-btn__tag">AI</span>
  </button>

  <div id="vto-popup" class="vto-popup" style="display:none;">
    <div class="vto-popup__inner">
      <img src="{{ product.featured_image | image_url: width: 80 }}" class="vto-popup__thumb" width="44" height="44" alt="" />
      <div class="vto-popup__text">
        <strong>See it on you ✨</strong>
        <span>{{ block.settings.popup_subtitle }}</span>
      </div>
      <button id="vto-popup-cta" class="vto-popup__cta" type="button">Try</button>
      <button id="vto-popup-close" class="vto-popup__x" type="button" aria-label="Close">✕</button>
    </div>
  </div>

  <div id="vto-overlay" class="vto-overlay" style="display:none;">
    <div class="vto-modal" role="dialog" aria-modal="true">
      <button id="vto-modal-close" class="vto-close" type="button" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <!-- ════ UPLOAD STATE ════ -->
      <div id="vto-s-upload" class="vto-state">
        <div class="vto-modal__top">
          <div class="vto-badge">✨ Virtual Try-On</div>
          <h2 class="vto-title">{{ block.settings.modal_title }}</h2>
          <p class="vto-sub">{{ block.settings.modal_subtitle }}</p>
        </div>

        <div class="vto-split">
          <div class="vto-split__product">
            <div class="vto-split__label">The Product</div>
            <div class="vto-split__img-wrap">
              <img src="{{ product.featured_image | image_url: width: 600 }}" class="vto-split__img" alt="{{ product.title | escape }}" />
            </div>
            <div class="vto-split__name">{{ product.title }}</div>
            <div class="vto-split__price">{{ product.price | money }}</div>
          </div>

          <div class="vto-split__divider">
            <div class="vto-split__plus">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
          </div>

          <div class="vto-split__user">
            <div class="vto-split__label">You</div>
            <div id="vto-user-zone" class="vto-split__img-wrap vto-split__drop">
              <input type="file" id="vto-file" accept="image/jpeg,image/png,image/webp" />
              <div id="vto-dz-empty" class="vto-split__empty">
                <div class="vto-split__upload-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="17 8 12 3 7 8"/>
                    <line x1="12" y1="3" x2="12" y2="15"/>
                  </svg>
                </div>
                <p class="vto-split__upload-text">Upload your photo</p>
                <p class="vto-split__upload-hint">JPG, PNG or WebP</p>
              </div>
              <div id="vto-dz-preview" style="display:none;">
                <img id="vto-preview-img" class="vto-split__img" alt="Your photo" />
                <button id="vto-change-photo" class="vto-split__change" type="button">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                  Change Photo
                </button>
              </div>
            </div>
          </div>
        </div>

        <button id="vto-submit" class="vto-main-cta" type="button" disabled>
          <span id="vto-submit-text">Upload photo to try on</span>
        </button>
        <p class="vto-privacy">🔒 Your photo is never stored</p>
      </div>

      <!-- ════ MERGE ANIMATION STATE ════ -->
      <div id="vto-s-merge" class="vto-state" style="display:none;">
        <div class="vto-merge-wrap">
          <div class="vto-merge-title">Creating your look...</div>
          <div class="vto-merge-canvas">
            <img id="vto-merge-product" class="vto-merge__img vto-merge__left" src="{{ product.featured_image | image_url: width: 400 }}" alt="" />
            <div class="vto-merge__glow"></div>
            <img id="vto-merge-user" class="vto-merge__img vto-merge__right" alt="" />
          </div>
        </div>
      </div>

      <!-- ════ LOADING STATE ════ -->
      <div id="vto-s-loading" class="vto-state" style="display:none;">
        <div class="vto-loading-wrap">
          <div class="vto-loader-circle">
            <svg width="72" height="72" viewBox="0 0 72 72">
              <circle cx="36" cy="36" r="32" fill="none" stroke="#f0f4f8" stroke-width="2"/>
              <circle cx="36" cy="36" r="32" fill="none" stroke="url(#vto-grad)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="160 200" class="vto-spinner-arc"/>
              <defs><linearGradient id="vto-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#7c3aed"/><stop offset="100%" stop-color="#ec4899"/></linearGradient></defs>
            </svg>
          </div>
          <h3 class="vto-loading__title" id="vto-loading-title">Analyzing your photo</h3>
          <p class="vto-loading__sub" id="vto-loading-sub">Detecting body shape & pose</p>
          <div class="vto-progress"><div class="vto-progress__bar"></div></div>
          <div class="vto-loading-steps">
            <div class="vto-lstep active" id="vto-ls1"><span class="vto-lstep__check"></span>Detecting body pose</div>
            <div class="vto-lstep" id="vto-ls2"><span class="vto-lstep__check"></span>Mapping garment fit</div>
            <div class="vto-lstep" id="vto-ls3"><span class="vto-lstep__check"></span>Rendering final look</div>
          </div>
          <p class="vto-loading__time">Usually takes 15–30 seconds</p>
        </div>
      </div>

      <!-- ════ RESULT STATE ════ -->
      <div id="vto-s-result" class="vto-state" style="display:none;">
        <div class="vto-result-wrap">
          <div class="vto-badge vto-badge--gold">🎉 Your Look is Ready</div>
          <div class="vto-result__img-wrap">
            <img id="vto-result-img" alt="Try-on result" />
            <div class="vto-result__shine"></div>
          </div>
          <div class="vto-result__product-tag">
            <img src="{{ product.featured_image | image_url: width: 80 }}" width="32" height="32" alt="" />
            <span>{{ product.title }}</span>
          </div>
          <div class="vto-result__btns">
            <button id="vto-retry" class="vto-btn-ghost" type="button">↻ Try Another</button>
            <button id="vto-addtocart" class="vto-main-cta vto-main-cta--sm" type="button">Add to Cart 🛒</button>
          </div>
          <p class="vto-disclaimer">Colors and fit shown in AI-generated previews may vary slightly from the actual product.</p>
          <div class="vto-powered">Powered by <a href="https://futuretechiez.in" target="_blank" rel="noopener noreferrer">Futuretechiez.in</a></div>
        </div>
      </div>

      <!-- ════ ERROR STATE ════ -->
      <div id="vto-s-error" class="vto-state" style="display:none;">
        <div class="vto-error-wrap">
          <div class="vto-error__emoji">😔</div>
          <h3 class="vto-error__title">Oops, something broke</h3>
          <p id="vto-error-msg" class="vto-error__msg"></p>
          <button id="vto-error-retry" class="vto-main-cta" type="button">Try Again</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
/* ── RESET & VARS ── */
#vto, #vto *, #vto *::before, #vto *::after { box-sizing: border-box !important; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }
#vto {
  --vto-primary: {{ block.settings.button_color }};
  --vto-primary-text: {{ block.settings.button_text_color }};
  --vto-r: {{ block.settings.button_radius }}px;
  --vto-ff: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  --vto-accent: #7c3aed;
  --vto-accent2: #ec4899;
  font-family: var(--vto-ff) !important;
}

/* ── BUTTON ── */
.vto-btn {
  position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding: 15px 24px; margin-top: 10px;
  background: var(--vto-primary) !important; color: var(--vto-primary-text) !important;
  border: none !important; border-radius: var(--vto-r) !important;
  font: 600 14px/1 var(--vto-ff) !important; cursor: pointer; overflow: hidden;
  transition: all .3s cubic-bezier(.4,0,.2,1); letter-spacing: 0.3px;
  box-shadow: 0 2px 8px rgba(0,0,0,.08);
}
.vto-btn::before {
  content: ''; position: absolute; top: 0; left: -100%; width: 60%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.15), transparent);
  animation: vto-btnShimmer 3s ease infinite;
}
@keyframes vto-btnShimmer { 0%{left:-100%} 100%{left:200%} }
.vto-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.15) !important; }
.vto-btn:active { transform: translateY(0) !important; }
.vto-btn__shimmer { display: none; }
.vto-btn__icon { display: flex; align-items: center; opacity: .85; }
.vto-btn__label { position: relative; z-index: 1; }
.vto-btn__tag { position: relative; z-index: 1; padding: 3px 8px; background: rgba(255,255,255,.2); backdrop-filter: blur(4px); border-radius: 5px; font-size: 10px; font-weight: 700; letter-spacing: 0.8px; }

/* ── POPUP ── */
.vto-popup { margin-top: 10px; animation: vto-slideUp .4s ease; }
.vto-popup__inner { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #111 !important; border-radius: 14px; position: relative; }
.vto-popup__thumb { width: 44px; height: 44px; border-radius: 10px; object-fit: cover; }
.vto-popup__text { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.vto-popup__text strong { color: #fff !important; font: 600 13px/1.3 var(--vto-ff) !important; }
.vto-popup__text span { color: #888 !important; font: 400 11px/1.3 var(--vto-ff) !important; }
.vto-popup__cta { padding: 7px 16px; background: #fff !important; color: #111 !important; border: none !important; border-radius: 8px; font: 700 12px/1 var(--vto-ff) !important; cursor: pointer; }
.vto-popup__x { position: absolute; top: -6px; right: -4px; background: #333 !important; border: none !important; border-radius: 50%; width: 20px; height: 20px; color: #aaa !important; font-size: 10px; cursor: pointer; display: flex; align-items: center; justify-content: center; line-height: 1; }

/* ── OVERLAY ── */
.vto-overlay { position: fixed !important; inset: 0 !important; z-index: 2147483647 !important; background: rgba(0,0,0,.6) !important; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); display: flex !important; align-items: center; justify-content: center; padding: 16px; animation: vto-fadeIn .2s; }

/* ── MODAL ── */
.vto-modal { background: #fff !important; border-radius: 24px !important; max-width: 500px; width: 100%; max-height: 92vh; overflow-y: auto; padding: 28px 24px !important; position: relative; box-shadow: 0 32px 80px rgba(0,0,0,.25) !important; animation: vto-scaleIn .35s cubic-bezier(.16,1,.3,1); }
.vto-modal::-webkit-scrollbar { width: 0; }

/* ── CLOSE BUTTON (theme-proof) ── */
.vto-close {
  position: absolute !important; top: 14px !important; right: 14px !important;
  width: 36px !important; height: 36px !important;
  background: #f3f4f6 !important; border: none !important; border-radius: 50% !important;
  display: flex !important; align-items: center !important; justify-content: center !important;
  cursor: pointer; color: #6b7280 !important; z-index: 10 !important;
  transition: all .2s ease; padding: 0 !important; margin: 0 !important;
  line-height: 1 !important; min-width: 0 !important; min-height: 0 !important;
  box-shadow: 0 1px 3px rgba(0,0,0,.08) !important;
}
.vto-close:hover { background: #e5e7eb !important; color: #111 !important; transform: rotate(90deg); }
.vto-close svg { display: block !important; pointer-events: none; }

/* ── BADGE ── */
.vto-badge { display: inline-block; padding: 6px 14px; background: linear-gradient(135deg, #f5f3ff, #fdf2f8) !important; border: 1px solid rgba(139,92,246,.1); border-radius: 20px; font: 600 11px/1 var(--vto-ff) !important; color: var(--vto-accent) !important; margin-bottom: 12px; letter-spacing: 0.3px; }
.vto-badge--gold { background: linear-gradient(135deg, #fef9c3, #fde68a) !important; border-color: rgba(234,179,8,.15); color: #92400e !important; }
.vto-modal__top { text-align: center; margin-bottom: 20px; }
.vto-title { margin: 0 !important; font: 800 24px/1.15 var(--vto-ff) !important; color: #111 !important; letter-spacing: -0.5px; }
.vto-sub { margin: 6px 0 0 !important; font: 400 13px/1.5 var(--vto-ff) !important; color: #9ca3af !important; }

/* ── SPLIT VIEW ── */
.vto-split { display: flex; gap: 0; align-items: stretch; margin-bottom: 18px; }
.vto-split__product, .vto-split__user { flex: 1; text-align: center; }
.vto-split__label { font: 700 9px/1 var(--vto-ff) !important; text-transform: uppercase; letter-spacing: 1.8px; color: #c4c4c4 !important; margin-bottom: 8px; }
.vto-split__img-wrap {
  width: 100%; aspect-ratio: 3/4; border-radius: 16px; overflow: hidden;
  background: #f9fafb !important; border: 2px solid #f0f0f0 !important;
  display: flex; align-items: center; justify-content: center; position: relative;
  transition: all .3s cubic-bezier(.4,0,.2,1);
}
.vto-split__img { width: 100% !important; height: 100% !important; object-fit: cover !important; display: block !important; }
.vto-split__name { font: 600 12px/1.3 var(--vto-ff) !important; color: #111 !important; margin-top: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 4px; }
.vto-split__price { font: 600 11px/1 var(--vto-ff) !important; color: var(--vto-accent) !important; margin-top: 2px; }
.vto-split__divider { display: flex; align-items: center; justify-content: center; width: 40px; flex-shrink: 0; }
.vto-split__plus {
  width: 30px; height: 30px; border-radius: 50%;
  background: linear-gradient(135deg, var(--vto-accent), var(--vto-accent2)) !important;
  color: #fff !important; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 14px rgba(124,58,237,.3);
  animation: vto-plusPulse 2s ease infinite;
}
@keyframes vto-plusPulse { 0%,100%{box-shadow:0 4px 14px rgba(124,58,237,.3)} 50%{box-shadow:0 4px 20px rgba(124,58,237,.5)} }

/* ── DROP ZONE ── */
.vto-split__drop { cursor: pointer; border: 2px dashed #d1d5db !important; background: #fafafa !important; transition: all .3s ease; }
.vto-split__drop:hover, .vto-split__drop.dragover { border-color: var(--vto-accent) !important; background: #faf5ff !important; }
.vto-split__drop input[type="file"] { position: absolute !important; inset: 0 !important; opacity: 0 !important; cursor: pointer !important; z-index: 2; width: 100% !important; height: 100% !important; }
.vto-split__empty { padding: 20px 8px; }
.vto-split__upload-icon {
  width: 48px; height: 48px; margin: 0 auto 10px;
  background: linear-gradient(135deg, #f5f3ff, #fdf2f8) !important;
  border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--vto-accent) !important;
  animation: vto-floatIcon 3s ease-in-out infinite;
}
@keyframes vto-floatIcon { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }
.vto-split__upload-text { font: 600 12px/1 var(--vto-ff) !important; color: #374151 !important; margin: 0 !important; }
.vto-split__upload-hint { font: 400 10px/1 var(--vto-ff) !important; color: #c4c4c4 !important; margin: 5px 0 0 !important; }

/* ── CHANGE PHOTO BUTTON (fixed) ── */
.vto-split__change {
  position: absolute !important; bottom: 8px !important; left: 50% !important; transform: translateX(-50%) !important;
  background: rgba(0,0,0,.65) !important; color: #fff !important;
  border: none !important; border-radius: 8px !important;
  padding: 6px 12px !important; font: 600 10px/1 var(--vto-ff) !important;
  cursor: pointer; z-index: 5 !important;
  display: inline-flex !important; align-items: center !important; gap: 4px !important;
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  transition: all .2s ease; white-space: nowrap;
  box-shadow: 0 2px 8px rgba(0,0,0,.15) !important;
  text-transform: none !important; letter-spacing: 0 !important;
}
.vto-split__change:hover { background: rgba(0,0,0,.85) !important; transform: translateX(-50%) translateY(-1px) !important; }
.vto-split__change svg { display: block !important; }
#vto-dz-preview { width: 100%; height: 100%; position: relative; }
#vto-dz-preview .vto-split__img { position: absolute !important; inset: 0 !important; }

/* ── CTA ── */
.vto-main-cta {
  width: 100%; padding: 16px; border: none !important; border-radius: var(--vto-r) !important;
  font: 700 14px/1 var(--vto-ff) !important; cursor: pointer;
  transition: all .3s cubic-bezier(.16,1,.3,1); position: relative; overflow: hidden;
  letter-spacing: 0.3px; background: var(--vto-accent) !important; color: #fff !important;
  margin-top: 6px;
}
.vto-main-cta:disabled { opacity: .3 !important; cursor: default !important; background: #e5e7eb !important; color: #9ca3af !important; }
.vto-main-cta:not(:disabled) { background: linear-gradient(135deg, var(--vto-accent), #6d28d9) !important; box-shadow: 0 4px 14px rgba(124,58,237,.25) !important; }
.vto-main-cta:not(:disabled):hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(124,58,237,.35) !important; }
.vto-main-cta:not(:disabled):active { transform: translateY(0) !important; }
.vto-main-cta--sm { flex: 1.4; }
.vto-btn-ghost { flex: 1; padding: 14px; background: #f3f4f6 !important; color: #374151 !important; border: none !important; border-radius: var(--vto-r) !important; font: 600 13px/1 var(--vto-ff) !important; cursor: pointer; transition: background .15s; }
.vto-btn-ghost:hover { background: #e5e7eb !important; }
.vto-privacy { text-align: center; margin: 10px 0 0; font: 400 10px/1.4 var(--vto-ff) !important; color: #d1d5db !important; }

/* ── MERGE ANIMATION ── */
.vto-merge-wrap { text-align: center; padding: 20px 0; }
.vto-merge-title { font: 700 20px/1 var(--vto-ff) !important; color: #111 !important; margin-bottom: 24px; animation: vto-pulse 1.5s ease infinite; }
.vto-merge-canvas { position: relative; height: 300px; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 20px; background: linear-gradient(135deg, #f8f8ff, #fdf2f8) !important; }
.vto-merge__img { width: 140px; height: 210px; object-fit: cover; border-radius: 14px; position: absolute; transition: all 1.2s cubic-bezier(.16,1,.3,1); box-shadow: 0 12px 40px rgba(0,0,0,.12); }
.vto-merge__left { left: 18%; transform: rotate(-4deg); }
.vto-merge__right { right: 18%; transform: rotate(4deg); }
.vto-merge__left.merging { left: 50%; transform: translateX(-50%) rotate(0deg) scale(1.1); opacity: .5; }
.vto-merge__right.merging { right: 50%; transform: translateX(50%) rotate(0deg) scale(1.1); opacity: .5; }
.vto-merge__glow { position: absolute; width: 100px; height: 100px; border-radius: 50%; background: radial-gradient(circle, rgba(124,58,237,.3), transparent 70%); opacity: 0; transition: opacity .8s; }
.vto-merge__glow.active { opacity: 1; animation: vto-glowPulse 1.5s ease infinite; }
@keyframes vto-glowPulse { 0%,100%{transform:scale(1);opacity:.6} 50%{transform:scale(1.6);opacity:1} }

/* ── RESULT ── */
.vto-result-wrap { text-align: center; }
.vto-result__img-wrap { position: relative; margin: 0 auto 14px; max-width: 360px; border-radius: 18px; overflow: hidden; box-shadow: 0 16px 50px rgba(0,0,0,.1); animation: vto-resultReveal .8s cubic-bezier(.16,1,.3,1); }
.vto-result__img-wrap img { width: 100% !important; display: block !important; border-radius: 18px; }
.vto-result__shine { position: absolute; top: -100%; left: -100%; width: 200%; height: 200%; background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,.25) 50%, transparent 60%); animation: vto-shineMove 2s ease .5s; pointer-events: none; }
@keyframes vto-shineMove { 0%{transform:translateX(-100%) translateY(-100%)} 100%{transform:translateX(100%) translateY(100%)} }
@keyframes vto-resultReveal { 0%{opacity:0;transform:scale(.88) translateY(16px)} 100%{opacity:1;transform:scale(1) translateY(0)} }
.vto-result__product-tag { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px 6px 6px; background: #f3f4f6 !important; border-radius: 10px; margin-bottom: 14px; }
.vto-result__product-tag img { width: 28px; height: 28px; border-radius: 6px; object-fit: cover; }
.vto-result__product-tag span { font: 600 12px/1 var(--vto-ff) !important; color: #374151 !important; }
.vto-result__btns { display: flex; gap: 10px; margin-bottom: 10px; }
.vto-disclaimer { font: 400 10px/1.4 var(--vto-ff) !important; color: #d1d5db !important; margin: 0; padding: 0 12px; }
.vto-powered { text-align: center; padding: 10px 0 2px; font: 400 10px/1 var(--vto-ff) !important; color: #d1d5db !important; }
.vto-powered a { color: #9ca3af !important; text-decoration: none; font-weight: 600; }
.vto-powered a:hover { color: #6b7280 !important; }

/* ── LOADING ── */
.vto-loading-wrap { text-align: center; padding: 28px 0 14px; }
.vto-loader-circle { margin: 0 auto 18px; width: 72px; height: 72px; }
.vto-spinner-arc { animation: vto-spin 1s linear infinite; transform-origin: center; }
@keyframes vto-spin { to { transform: rotate(360deg); } }
.vto-loading__title { font: 700 17px/1 var(--vto-ff) !important; color: #111 !important; margin: 0 0 5px !important; }
.vto-loading__sub { font: 400 12px/1.4 var(--vto-ff) !important; color: #9ca3af !important; margin: 0 0 18px !important; }
.vto-progress { width: 100%; height: 3px; background: #f3f4f6 !important; border-radius: 3px; overflow: hidden; margin-bottom: 18px; }
.vto-progress__bar { height: 100%; width: 0%; background: linear-gradient(90deg, var(--vto-accent), var(--vto-accent2)) !important; border-radius: 3px; animation: vto-progressGrow 28s ease forwards; }
@keyframes vto-progressGrow { 0%{width:0%} 30%{width:30%} 60%{width:55%} 85%{width:75%} 100%{width:92%} }
.vto-loading-steps { text-align: left; max-width: 220px; margin: 0 auto 14px; }
.vto-lstep { display: flex; align-items: center; gap: 8px; padding: 5px 0; font: 500 12px/1 var(--vto-ff) !important; color: #d1d5db !important; transition: color .3s; }
.vto-lstep.active { color: #111 !important; }
.vto-lstep.done { color: #22c55e !important; }
.vto-lstep__check { width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid #e5e7eb; display: inline-flex; align-items: center; justify-content: center; font-size: 9px; transition: all .3s; flex-shrink: 0; }
.vto-lstep.active .vto-lstep__check { border-color: var(--vto-accent) !important; background: var(--vto-accent) !important; box-shadow: 0 0 0 3px rgba(124,58,237,.12); }
.vto-lstep.active .vto-lstep__check::after { content: ''; width: 4px; height: 4px; background: #fff; border-radius: 50%; }
.vto-lstep.done .vto-lstep__check { border-color: #22c55e !important; background: #22c55e !important; }
.vto-lstep.done .vto-lstep__check::after { content: '✓'; color: #fff; font-size: 9px; font-weight: 700; }
.vto-loading__time { font: 400 10px/1 var(--vto-ff) !important; color: #d1d5db !important; }

/* ── ERROR ── */
.vto-error-wrap { text-align: center; padding: 36px 0 18px; }
.vto-error__emoji { font-size: 44px; margin-bottom: 10px; }
.vto-error__title { font: 700 18px/1 var(--vto-ff) !important; color: #111 !important; margin: 0 0 6px !important; }
.vto-error__msg { font: 400 13px/1.4 var(--vto-ff) !important; color: #9ca3af !important; margin: 0 0 18px !important; }

/* ── ANIMATIONS ── */
@keyframes vto-fadeIn { from{opacity:0} to{opacity:1} }
@keyframes vto-scaleIn { from{opacity:0;transform:scale(.94) translateY(6px)} to{opacity:1;transform:scale(1) translateY(0)} }
@keyframes vto-slideUp { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
@keyframes vto-pulse { 0%,100%{opacity:1} 50%{opacity:.5} }

/* ── MOBILE ── */
@media(max-width:480px){
  .vto-modal { padding: 22px 18px !important; border-radius: 22px !important; max-width: 100%; margin: 8px; }
  .vto-title { font-size: 20px !important; }
  .vto-sub { font-size: 12px !important; }
  .vto-split__img-wrap { aspect-ratio: 2/3; border-radius: 12px; }
  .vto-split__divider { width: 32px; }
  .vto-split__plus { width: 26px; height: 26px; }
  .vto-split__plus svg { width: 12px; height: 12px; }
  .vto-split__name { font-size: 11px !important; }
  .vto-split__price { font-size: 10px !important; }
  .vto-split__change { padding: 6px 10px !important; font-size: 10px !important; border-radius: 8px !important; bottom: 6px !important; }
  .vto-merge__img { width: 110px; height: 165px; }
  .vto-merge-canvas { height: 220px; }
  .vto-main-cta { padding: 14px !important; font-size: 13px !important; }
  .vto-close { width: 32px !important; height: 32px !important; top: 10px !important; right: 10px !important; }
  .vto-close svg { width: 14px; height: 14px; }
  .vto-result__img-wrap { max-width: 100%; }
}
@media(max-width:360px){
  .vto-modal { padding: 18px 14px !important; }
  .vto-title { font-size: 18px !important; }
  .vto-split__label { font-size: 8px !important; }
}
</style>

<script>
(function(){
  const $=id=>document.getElementById(id);
  const el=$('vto');if(!el)return;
  const D=el.dataset;
  const btn=$('vto-btn'),popup=$('vto-popup'),overlay=$('vto-overlay');
  const fileInput=$('vto-file'),dzEmpty=$('vto-dz-empty'),dzPreview=$('vto-dz-preview'),prevImg=$('vto-preview-img');
  const submitBtn=$('vto-submit'),submitTxt=$('vto-submit-text');
  const resultImg=$('vto-result-img'),errorMsg=$('vto-error-msg');
  let file=null;

  function show(state){
    ['upload','merge','loading','result','error'].forEach(s=>{
      const el=$('vto-s-'+s);if(el)el.style.display=s===state?'block':'none';
    });
  }
  function openModal(){overlay.style.display='flex';show('upload');popup.style.display='none';document.body.style.overflow='hidden';}
  function closeModal(){overlay.style.display='none';document.body.style.overflow='';reset();}
  function reset(){file=null;if(fileInput)fileInput.value='';if(dzEmpty)dzEmpty.style.display='block';if(dzPreview)dzPreview.style.display='none';submitBtn.disabled=true;submitTxt.textContent='Upload photo to try on';}
  function handleFile(f){
    if(!f||!f.type.startsWith('image/'))return;
    if(f.size>10*1024*1024){alert('File too large. Max 10 MB.');return;}
    file=f;
    const r=new FileReader();
    r.onload=e=>{prevImg.src=e.target.result;dzEmpty.style.display='none';dzPreview.style.display='block';submitBtn.disabled=false;submitTxt.textContent='Try it on →';};
    r.readAsDataURL(f);
  }
  btn.addEventListener('click',openModal);
  $('vto-popup-cta')?.addEventListener('click',openModal);
  $('vto-modal-close').addEventListener('click',closeModal);
  overlay.addEventListener('click',e=>{if(e.target===overlay)closeModal();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&overlay.style.display!=='none')closeModal();});
  $('vto-popup-close')?.addEventListener('click',e=>{e.stopPropagation();popup.style.display='none';sessionStorage.setItem('vto_dismissed','1');});
  if(!sessionStorage.getItem('vto_dismissed')){setTimeout(()=>{if(!overlay.style.display||overlay.style.display==='none')popup.style.display='block';},{{ block.settings.popup_delay }}000);}
  fileInput?.addEventListener('change',e=>handleFile(e.target.files[0]));
  $('vto-change-photo')?.addEventListener('click',e=>{e.stopPropagation();fileInput.click();});
  const dz=fileInput?.parentElement;
  if(dz){
    dz.addEventListener('dragover',e=>{e.preventDefault();dz.classList.add('dragover');});
    dz.addEventListener('dragleave',()=>dz.classList.remove('dragover'));
    dz.addEventListener('drop',e=>{e.preventDefault();dz.classList.remove('dragover');handleFile(e.dataTransfer.files[0]);});
  }

  submitBtn?.addEventListener('click',async()=>{
    if(!file)return;
    const mergeUser=$('vto-merge-user');
    if(mergeUser&&prevImg.src)mergeUser.src=prevImg.src;
    show('merge');
    const ml=$('vto-merge-product'),mr=$('vto-merge-user'),glow=$('vto-merge__glow');
    setTimeout(()=>{ml?.classList.add('merging');mr?.classList.add('merging');if(glow)glow.classList.add('active');},400);
    await new Promise(r=>setTimeout(r,2000));
    ml?.classList.remove('merging');mr?.classList.remove('merging');if(glow)glow.classList.remove('active');
    show('loading');startLoadingAnim();

    try{
      const fd=new FormData();
      fd.append('shop',D.shop);fd.append('product_id',D.pid);fd.append('product_title',D.ptitle);fd.append('product_image_url',D.pimg);fd.append('user_photo',file);fd.append('category',D.category||'dresses');
      const res=await fetch('/apps/tryon',{method:'POST',body:fd});
      const data=await res.json();
      if(res.ok&&data.success&&data.result_url){
        resultImg.src=data.result_url;show('result');
        try{const lf=new FormData();lf.append('shop',D.shop);lf.append('product_id',D.pid);lf.append('product_title',D.ptitle);fetch('https://tryfit-production.up.railway.app/log-tryon',{method:'POST',body:lf,mode:'cors'}).catch(()=>{});}catch(le){}
        return;
      }
      throw new Error(data.error||'AI unavailable');
    }catch(err){
      try{
        const userUrl=URL.createObjectURL(file);
        const canvas=document.createElement('canvas');
        canvas.width=600;canvas.height=800;
        const ctx=canvas.getContext('2d');
        const userImage=new Image();
        userImage.onload=()=>{
          ctx.drawImage(userImage,0,0,600,800);
          const prodImage=new Image();prodImage.crossOrigin='anonymous';
          prodImage.onload=()=>{
            const tmp=document.createElement('canvas');
            const tw=prodImage.naturalWidth,th=prodImage.naturalHeight;
            tmp.width=tw;tmp.height=th;const tc=tmp.getContext('2d');
            tc.drawImage(prodImage,0,0);
            const imgData=tc.getImageData(0,0,tw,th);const dd=imgData.data;
            for(let i=0;i<dd.length;i+=4){const br=(dd[i]+dd[i+1]+dd[i+2])/3;if(br>220&&Math.abs(dd[i]-dd[i+1])<25&&Math.abs(dd[i+1]-dd[i+2])<25)dd[i+3]=0;else if(br>200)dd[i+3]=Math.max(0,(255-br)*4);}
            tc.putImageData(imgData,0,0);
            const ratio=tw/th;let pw,ph,px,py;
            if(ratio>1.5){pw=300;ph=pw/ratio;px=(600-pw)/2;py=480;}
            else if(ratio>0.7){pw=240;ph=pw/ratio;px=(600-pw)/2;py=190;}
            else{pw=340;ph=pw/ratio;px=(600-pw)/2;py=200;}
            ctx.drawImage(tmp,px,py,pw,ph);
            ctx.fillStyle='rgba(124,58,237,0.9)';ctx.beginPath();ctx.roundRect(170,740,260,40,14);ctx.fill();
            ctx.fillStyle='#fff';ctx.font='600 14px Inter,sans-serif';ctx.textAlign='center';
            ctx.fillText('✨ Virtual Try-On by TryFit',300,766);
            resultImg.src=canvas.toDataURL('image/jpeg',0.92);show('result');
            try{const lf=new FormData();lf.append('shop',D.shop);lf.append('product_id',D.pid);lf.append('product_title',D.ptitle);fetch('https://tryfit-production.up.railway.app/log-tryon',{method:'POST',body:lf,mode:'cors'}).catch(()=>{});}catch(le){}
          };
          prodImage.onerror=()=>{errorMsg.textContent='Could not load product image';show('error');};
          prodImage.src=D.pimg;
        };
        userImage.src=userUrl;
      }catch(e2){errorMsg.textContent=e2.message||'Please try again.';show('error');}
    }
  });
  $('vto-retry')?.addEventListener('click',()=>{reset();show('upload');});
  $('vto-error-retry')?.addEventListener('click',()=>{reset();show('upload');});
  $('vto-addtocart')?.addEventListener('click',async()=>{
    try{const af=new FormData();af.append('shop',D.shop);af.append('product_id',D.pid);af.append('product_title',D.ptitle);af.append('event','atc');navigator.sendBeacon('https://tryfit-production.up.railway.app/log-tryon',af);}catch(e){}
    const vid=document.querySelector('[name="id"]')?.value;
    try{if(vid){await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:vid,quantity:1})});}closeModal();window.location.href='/cart';}catch(e){window.location.href='/cart';}
  });

  let loadTimer=null;
  function startLoadingAnim(){
    const title=$('vto-loading-title'),sub=$('vto-loading-sub');
    const ls1=$('vto-ls1'),ls2=$('vto-ls2'),ls3=$('vto-ls3');
    const msgs=[
      {t:'Analyzing your photo...',s:'Detecting body shape & pose',step:1,ms:0},
      {t:'Understanding your body...',s:'Mapping proportions for perfect fit',step:1,ms:3000},
      {t:'Fitting the garment...',s:'Adjusting fabric drape & texture',step:2,ms:7000},
      {t:'Perfecting the details...',s:'Fine-tuning colors & shadows',step:2,ms:12000},
      {t:'Almost there...',s:'Adding final touches to your look',step:3,ms:18000},
      {t:'Putting it all together...',s:'Your personalized look is nearly ready',step:3,ms:24000},
    ];
    if(ls1){ls1.className='vto-lstep active';ls2.className='vto-lstep';ls3.className='vto-lstep';}
    msgs.forEach(m=>{
      setTimeout(()=>{
        if(title)title.textContent=m.t;
        if(sub)sub.textContent=m.s;
        if(m.step>=2&&ls1){ls1.className='vto-lstep done';ls2.className='vto-lstep active';}
        if(m.step>=3&&ls2){ls2.className='vto-lstep done';ls3.className='vto-lstep active';}
      },m.ms);
    });
  }
})();
</script>
{% endif %}

{% schema %}
{
  "name": "TryFit – Virtual Try-On",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Try On"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Corner Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Popup"
    },
    {
      "type": "text",
      "id": "popup_subtitle",
      "label": "Popup Subtitle",
      "default": "Upload a photo and try it instantly"
    },
    {
      "type": "range",
      "id": "popup_delay",
      "label": "Popup Delay",
      "min": 2,
      "max": 15,
      "step": 1,
      "default": 4,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Modal"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Modal Title",
      "default": "Try it before you buy"
    },
    {
      "type": "text",
      "id": "modal_subtitle",
      "label": "Modal Subtitle",
      "default": "Upload your photo and see this on you in seconds"
    },
    {
      "type": "header",
      "content": "AI Settings"
    },
    {
      "type": "select",
      "id": "garment_category",
      "label": "Garment Type",
      "default": "dresses",
      "info": "Upper body = tops/shirts. Lower body = pants/skirts. Full body = kurta sets, dresses, jumpsuits.",
      "options": [
        { "value": "upper_body", "label": "Upper Body (tops, shirts, jackets)" },
        { "value": "lower_body", "label": "Lower Body (pants, skirts)" },
        { "value": "dresses", "label": "Full Body (sets, dresses, jumpsuits)" }
      ]
    }
  ]
}
{% endschema %}
