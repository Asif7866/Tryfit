.vto-link{background:none;border:none;padding:6px;font-size:12px;color:#7d7a78;cursor:pointer;text-decoration:underline;text-underline-offset:3px;}

/* RESULT — full bleed */
.vto-card.is-result .vto-head{position:absolute;top:0;left:0;right:0;background:linear-gradient(to bottom,rgba(0,0,0,.38),rgba(0,0,0,0));}
.vto-card.is-result .vto-head__t,.vto-card.is-result .vto-x{color:#fff;}
.vto-card.is-result .vto-x:hover{background:rgba(255,255,255,.14);}
.vto-rs{position:absolute;inset:0;padding:0;overflow:hidden;}
.vto-rs__pic{position:absolute;inset:0;cursor:zoom-in;background:#e9e4dd;}
