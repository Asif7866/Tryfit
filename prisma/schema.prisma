generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?

  @@index([shop])
}

model ShopSettings {
  id              String   @id @default(uuid())
  shop            String   @unique
  enabled         Boolean  @default(true)
  plan            String   @default("free")
  buttonText      String   @default("Try The Look")
  buttonColor     String   @default("#000000")
  buttonTextColor String   @default("#FFFFFF")
  modalTitle      String   @default("Ready to try this on?")
  totalTryOns     Int      @default(0)
  monthlyTryOns   Int      @default(0)
  monthlyLimit    Int      @default(10)
  billingId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop])
}

model TryOnLog {
  id            String   @id @default(uuid())
  shop          String
  productId     String
  productTitle  String?
  resultUrl     String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  @@index([shop])
  @@index([createdAt])
}
